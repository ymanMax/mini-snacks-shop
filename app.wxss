/**app.wxss —— 全局主题与通用样式（红色主题 #b4282d）**/
page {
  --primary: #b4282d;
  --primary-light: #d8504a;
  --primary-soft: #fdecec;
  --warning: #ff9900;
  --blue: #2f7cf6;
  --green: #0ea47a;
  --bg: #f5f6f7;
  --card: #ffffff;
  --text-main: #222222;
  --text-sub: #666666;
  --text-light: #969799;
  --line: #f0f0f0;
  background-color: var(--bg);
  color: var(--text-main);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

view, text, button, input, textarea, scroll-view, swiper {
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */
.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-start { display: flex; align-items: center; justify-content: flex-start; }
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; min-width: 0; min-height: 0; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 24rpx;
}
.card.flush { margin-left: 0; margin-right: 0; border-radius: 0; }
.card-t {
  background: var(--card);
  margin: 24rpx 24rpx 0;
  border-radius: 16rpx 16rpx 0 0;
  padding: 24rpx 24rpx 0;
}
.card-b {
  background: var(--card);
  margin: 0 24rpx 24rpx;
  border-radius: 0 0 16rpx 16rpx;
  padding: 0 24rpx 24rpx;
}

/* ---------- 价格 ---------- */
.price {
  color: var(--primary);
  font-weight: 700;
}
.price .sym { font-size: 22rpx; font-weight: 600; }
.price .int { font-size: 34rpx; }
.price.big { font-size: 40rpx; }
.price.big .int { font-size: 44rpx; }
.price-orig {
  color: var(--text-light);
  font-size: 22rpx;
  text-decoration: line-through;
  margin-left: 10rpx;
}
.free { color: var(--green); font-weight: 600; }

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 0 36rpx;
  height: 72rpx;
  border: none;
  line-height: 72rpx;
}
.btn::after { border: none; }
.btn-primary {
  background: linear-gradient(90deg, #d8443a, #b4282d);
  color: #fff;
}
.btn-primary[disabled] {
  background: #f1b4b6;
  color: #fff;
}
.btn-plain {
  background: #fff;
  color: var(--primary);
  border: 1rpx solid var(--primary);
}
.btn-gray {
  background: #f2f3f5;
  color: var(--text-sub);
}
.btn-sm { height: 52rpx; line-height: 52rpx; font-size: 24rpx; padding: 0 24rpx; }
.btn-block { width: 100%; height: 88rpx; line-height: 88rpx; font-size: 32rpx; border-radius: 999rpx; }

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  line-height: 1.6;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--primary-soft);
  color: var(--primary);
  margin-right: 10rpx;
}
.tag.blue { background: #e8f1fe; color: var(--blue); }
.tag.green { background: #e6f7f1; color: var(--green); }
.tag.orange { background: #fff3e0; color: #f57c00; }
.tag.gray { background: #f2f3f5; color: var(--text-light); }

/* ---------- 区块标题 ---------- */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx 20rpx;
}
.section-head .title {
  font-size: 34rpx;
  font-weight: 700;
  position: relative;
  padding-left: 20rpx;
}
.section-head .title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 8rpx;
  border-radius: 4rpx;
  background: var(--primary);
}
.section-head .more { font-size: 24rpx; color: var(--text-light); }

/* ---------- 骨架屏 ---------- */
@keyframes shimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}
.sk {
  background: linear-gradient(90deg, #ececec 25%, #f7f7f7 37%, #ececec 63%);
  background-size: 800rpx 100%;
  animation: shimmer 1.3s infinite linear;
  border-radius: 8rpx;
}

/* ---------- 红点角标 ---------- */
.badge-dot {
  position: absolute;
  top: -10rpx;
  right: -16rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}
.red-dot {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary);
}

/* ---------- 分割线 ---------- */
.divider { height: 1rpx; background: var(--line); margin: 20rpx 0; }
.hr-gab { height: 20rpx; background: var(--bg); }

/* ---------- 吸顶筛选/搜索栏占位 ---------- */
.safe-bottom { height: env(safe-area-inset-bottom); }
.page-pad { padding: 0 24rpx 40rpx; }

/* ---------- 通用行 ---------- */
.cell-row {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
}
.cell-row .label { color: var(--text-sub); font-size: 28rpx; width: 170rpx; }
.cell-row .val { flex: 1; color: var(--text-main); font-size: 28rpx; }
.cell-arrow::after {
  content: '';
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #c0c4cc;
  border-right: 3rpx solid #c0c4cc;
  transform: rotate(45deg);
  margin-left: 12rpx;
}

/* ---------- 弹出遮罩 ---------- */
.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.sheet-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

/* ---------- 数字变化动画（签到积分） ---------- */
@keyframes pop {
  0% { transform: scale(0.6); opacity: 0; }
  50% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}
.pop { animation: pop 0.4s ease; }

/* ---------- 浮动提示条 ---------- */
.demo-tip {
  margin: 16rpx 24rpx;
  padding: 14rpx 20rpx;
  background: #fff8e6;
  color: #a8741a;
  font-size: 22rpx;
  border-radius: 12rpx;
}
