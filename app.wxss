/**app.wxss —— 全局设计规范（优化 9）**/
page {
  --theme: #b4282d;
  --theme-light: #fbeaea;
  --bg: #f5f6f7;
  --text-main: #333333;
  --text-sub: #838383;
  --text-weak: #b0b0b0;
  background: #f5f6f7;
  color: #333333;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
}

view, text, image, scroll-view, swiper, swiper-item, navigator, button, input, textarea, video {
  box-sizing: border-box;
}

/* ============ 价格 ============ */
.price {
  color: #b4282d;
  font-weight: bold;
}
.price .symbol { font-size: 0.72em; }
.price-origin {
  color: #b0b0b0;
  font-size: 24rpx;
  text-decoration: line-through;
  font-weight: normal;
}

/* ============ 按钮 ============ */
.btn-primary {
  background: #b4282d;
  color: #fff;
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  padding: 18rpx 0;
}
.btn-primary.disabled { background: #d9a0a2; }
.btn-plain {
  border: 2rpx solid #b4282d;
  color: #b4282d;
  background: #fff;
  border-radius: 999rpx;
  text-align: center;
  font-size: 28rpx;
  padding: 14rpx 0;
}

/* ============ 卡片 ============ */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 24rpx;
}

/* ============ 标签胶囊 ============ */
.tag {
  display: inline-block;
  background: #fbeaea;
  color: #b4282d;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 10rpx;
  line-height: 1.6;
}
.tag.gray { background: #f2f3f5; color: #838383; }

/* ============ 空状态（优化 9）============ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
}
.empty-state .empty-img {
  width: 240rpx;
  height: 240rpx;
  opacity: 0.9;
}
.empty-state .empty-text {
  color: #838383;
  font-size: 28rpx;
  margin: 24rpx 0;
}
.empty-state .empty-btn {
  background: #b4282d;
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 16rpx 60rpx;
  margin-top: 12rpx;
}

/* ============ 骨架屏（灰色色块呼吸动画）============ */
@keyframes skeleton-breath {
  0% { opacity: 1; }
  50% { opacity: 0.45; }
  100% { opacity: 1; }
}
.skeleton {
  background: #ececee;
  border-radius: 8rpx;
  animation: skeleton-breath 1.2s ease-in-out infinite;
}

/* ============ 文本省略 ============ */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* ============ 徽标角标 ============ */
.badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #b4282d;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
}

/* ============ 分割线 ============ */
.hairline {
  height: 2rpx;
  background: #f0f0f0;
}

/* ============ 演示环境提示 ============ */
.demo-tip {
  color: #b0b0b0;
  font-size: 22rpx;
  text-align: center;
  padding: 16rpx 0;
}
