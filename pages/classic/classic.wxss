/* pages/classic/classic.wxss */
page { background: #f5f6f7; }
.classic-page {
  display: flex;
  height: 100vh;
}

/* 左侧分类 */
.cate-left {
  width: 180rpx;
  height: 100vh;
  background: #f2f3f5;
  flex-shrink: 0;
}
.cate-item {
  position: relative;
  padding: 28rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #555;
}
.cate-item.on {
  background: #fff;
  color: #b4282d;
  font-weight: 700;
}
.cate-bar {
  position: absolute;
  left: 0;
  top: 36rpx;
  bottom: 36rpx;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: #b4282d;
}
.cate-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 8rpx;
}

/* 右侧 */
.cate-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  height: 100vh;
}
.filter-bar {
  display: flex;
  background: #fff;
  padding: 0 10rpx;
  height: 84rpx;
  align-items: center;
  position: relative;
  z-index: 20;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .03);
}
.sort-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #555;
  position: relative;
}
.sort-item.on { color: #b4282d; font-weight: 700; }
.sort-arrow { font-size: 22rpx; }
.filter-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b4282d;
  margin-left: 6rpx;
  vertical-align: middle;
}

.goods-scroll { flex: 1; min-height: 0; }
.goods-list {
  padding: 18rpx 18rpx 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

/* 筛选面板 */
.filter-sheet { padding: 32rpx 32rpx 50rpx; }
.fs-title { font-size: 32rpx; font-weight: 700; margin-bottom: 28rpx; }
.fs-group { margin-bottom: 36rpx; }
.fs-label { font-size: 26rpx; color: #555; margin-bottom: 18rpx; }
.fs-options { display: flex; flex-wrap: wrap; gap: 18rpx; }
.fs-opt {
  padding: 12rpx 32rpx;
  background: #f5f6f7;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #555;
}
.fs-opt.on { background: #fdecec; color: #b4282d; font-weight: 600; }
.fs-row-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.fs-row-group .fs-label { margin-bottom: 0; }
.fs-actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.fs-btn { flex: 1; }
.fs-btn.primary { flex: 2; }

/* 骨架屏 */
.sk-list { padding: 18rpx; display: flex; flex-direction: column; gap: 18rpx; }
.sk-l-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}
.sk-l-img { width: 200rpx; height: 200rpx; border-radius: 12rpx; }
.sk-l-info { flex: 1; margin-left: 20rpx; padding-top: 10rpx; }
.sk-l-line { height: 28rpx; border-radius: 8rpx; margin-bottom: 20rpx; }
.w80 { width: 80%; }
.w50 { width: 50%; }
.w30 { width: 30%; }

/* 悬浮购物车 */
.float-cart {
  position: fixed;
  right: 20rpx;
  bottom: 40rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #d34046, #b4282d);
  box-shadow: 0 8rpx 24rpx rgba(180, 40, 45, .4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}
.float-icon { width: 44rpx; height: 44rpx; filter: brightness(0) invert(1); }
.float-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #ff6b00;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  border: 2rpx solid #fff;
}
