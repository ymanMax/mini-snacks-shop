.classic {
  display: flex;
  min-height: 100vh;
  background: #f5f6f7;
}

/* 左侧分类 */
.left {
  width: 180rpx;
  height: 100vh;
  position: sticky;
  top: 0;
  background: #f7f8fa;
  flex-shrink: 0;
}
.left-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 22rpx;
  color: #555;
}
.left-item .on-bar {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 40rpx;
  background: #b4282d;
  border-radius: 0 4rpx 4rpx 0;
}
.left-icon { width: 56rpx; height: 56rpx; }
.left-name { font-size: 22rpx; margin-top: 8rpx; text-align: center; }
.left-item.on {
  background: #fff;
  color: #b4282d;
  font-weight: 600;
}

/* 右侧 */
.right { flex: 1; min-width: 0; padding-bottom: 30rpx; }

.filter-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  background: #fff;
  height: 80rpx;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}
.fb-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #555;
  position: relative;
}
.fb-item.on { color: #b4282d; font-weight: 600; }
.filter-btn { flex: 1.2; }
.fb-dot {
  display: inline-block;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #b4282d;
  color: #fff;
  font-size: 18rpx;
  margin-left: 6rpx;
}

.goods-list { padding: 20rpx 20rpx 0; }
.goods-list goods-card { display: block; }

/* 筛选半屏面板 */
.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}
.sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 24rpx calc(30rpx + env(safe-area-inset-bottom));
  animation: sheetUp 0.25s ease;
}
@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.sheet-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 10rpx; }
.sheet-group { padding: 24rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.row-group { display: flex; align-items: center; justify-content: space-between; }
.sheet-label { font-size: 28rpx; color: #333; font-weight: 600; margin-bottom: 20rpx; }
.row-group .sheet-label { margin-bottom: 0; }
.sheet-tags { display: flex; flex-wrap: wrap; }
.sheet-tag {
  padding: 12rpx 28rpx;
  background: #f5f6f7;
  color: #555;
  border-radius: 999rpx;
  font-size: 24rpx;
  margin: 0 20rpx 20rpx 0;
}
.sheet-tag.on {
  background: #fdecec;
  color: #b4282d;
  border: 1rpx solid #b4282d;
}
.sheet-actions { display: flex; margin-top: 30rpx; }
.sheet-actions .btn { flex: 1; }
