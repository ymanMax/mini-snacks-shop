<!--pages/group/index/index.wxml-->
<wxs src="../../../utils/format.wxs" module="fmt" />
<view class="gp-page">
  <view class="gp-banner">
    <view>
      <view class="gp-title">👥 拼团优惠</view>
      <view class="gp-sub">3 人成团享拼团价 · 24 小时未成团自动退款</view>
    </view>
    <view class="open-btn" bindtap="openGroup">一键开团</view>
  </view>

  <view class="tabs">
    <view class="tab {{tab === 'active' ? 'on' : ''}}" data-tab="active" bindtap="switchTab">可参与的团</view>
    <view class="tab {{tab === 'mine' ? 'on' : ''}}" data-tab="mine" bindtap="switchTab">我的拼团</view>
  </view>

  <!-- 进行中拼团 -->
  <view wx:if="{{tab === 'active'}}" class="gp-list">
    <view wx:for="{{groups}}" wx:key="id" class="gp-card" data-id="{{item.id}}" bindtap="goDetail">
      <safe-image class="gp-pic" img-class="gp-pic" src="{{item.pic}}" mode="aspectFill" />
      <view class="gp-info">
        <view class="gp-name ellipsis-2">{{item.name}}</view>
        <view class="gp-price-row">
          <text class="gp-price">¥{{fmt.fixed(item.groupPrice)}}</text>
          <text class="gp-origin">¥{{fmt.fixed(item.originalPrice)}}</text>
          <text class="gp-save">立省¥{{fmt.fixed(item.originalPrice - item.groupPrice)}}</text>
        </view>
        <view class="gp-members">
          <image wx:for="{{item.members}}" wx:for-item="m" wx:key="userId" class="gp-avatar" src="{{m.avatar}}" />
          <text class="gp-join-text">还差 {{item.remainCount}} 人成团</text>
        </view>
        <view class="gp-bottom">
          <text class="gp-cd">⏰ {{countdowns[item.id]}}</text>
          <view class="gp-btn" catchtap="goDetail" data-id="{{item.id}}">去参团</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 我的拼团 -->
  <view wx:else class="gp-list">
    <view wx:for="{{mine}}" wx:key="id" class="gp-card" data-id="{{item.id}}" bindtap="goDetail">
      <safe-image class="gp-pic" img-class="gp-pic" src="{{item.pic}}" mode="aspectFill" />
      <view class="gp-info">
        <view class="gp-name ellipsis-2">{{item.name}}</view>
        <view class="gp-price-row">
          <text class="gp-price">¥{{fmt.fixed(item.groupPrice)}}</text>
          <text class="gp-status {{item.status === 2 ? 'success' : ''}} {{item.status === 3 ? 'failed' : ''}}">
            {{item.status === 2 ? '已成团，待发货' : (item.status === 3 ? '未成团已退款' : '拼团中，还差 ' + item.remainCount + ' 人')}}
          </text>
        </view>
        <view class="gp-members">
          <image wx:for="{{item.members}}" wx:for-item="m" wx:key="userId" class="gp-avatar" src="{{m.avatar}}" />
          <text class="gp-join-text">{{item.joinedCount}}/{{item.requiredCount}} 人已参团</text>
        </view>
        <view wx:if="{{item.refund}}" class="gp-refund">{{item.refund.status}} · ¥{{fmt.fixed(item.refund.amount)}}</view>
      </view>
    </view>
    <empty wx:if="{{!mine.length}}" image="/image/cry.png" text="还没有参团记录"
      btnText="去逛逛" bindbutton="goShopping" top="120rpx" />
  </view>
</view>
