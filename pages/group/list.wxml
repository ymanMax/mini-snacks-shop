<!--pages/group/list.wxml-->
<wxs src="../../utils/format.wxs" module="f" />
<view class="page">
  <!-- ===== 顶部 Tab ===== -->
  <view class="tab-bar">
    <view wx:for="{{tabs}}" wx:key="key"
          class="tab-item {{tab === item.key ? 'active' : ''}}"
          data-tab="{{item.key}}" bindtap="onSwitchTab">{{item.name}}</view>
  </view>

  <block wx:if="{{!loading}}">
    <!-- ===== 拼团列表 ===== -->
    <block wx:if="{{groups.length}}">
      <view class="group-card" wx:for="{{groups}}" wx:key="id" wx:for-index="g"
            data-id="{{item.id}}" bindtap="onGoGroup">
        <view class="group-main">
          <image class="goods-pic" mode="aspectFill"
                 src="{{item._imgErr ? '/static/images/default.png' : item.pic}}"
                 data-key="{{g}}" data-field="groups" binderror="onImgError"></image>
          <view class="group-info">
            <view class="goods-name ellipsis-2">{{item.name}}</view>
            <view class="price-row">
              <text class="price"><text class="symbol">￥</text>{{f.fp(item.groupPrice)}}</text>
              <text class="price-origin">￥{{f.fp(item.originalPrice)}}</text>
            </view>
            <view class="status-row">
              <text class="status-badge {{item.statusCls}}">{{item.statusText}}</text>
              <text class="role-tag {{item.isLeader ? 'leader' : ''}}" wx:if="{{tab === 'mine'}}">{{item.roleText}}</text>
              <text class="lack" wx:if="{{item.status === 1}}">差 {{item.lack}} 人成团</text>
            </view>
          </view>
        </view>

        <view class="member-row">
          <view class="member-wrap" wx:for="{{item.members}}" wx:for-item="m" wx:for-index="mi" wx:key="name">
            <image class="member-avatar"
                   src="{{m._imgErr ? '/static/images/default.png' : m.avatar}}"
                   data-g="{{g}}" data-m="{{mi}}" binderror="onMemberImgError"></image>
            <view class="leader-tag" wx:if="{{m.isLeader}}">团长</view>
          </view>
          <block wx:if="{{item.status === 1}}">
            <view class="avatar-placeholder" wx:for="{{item.lack}}" wx:for-item="ph" wx:key="*this">+</view>
          </block>
          <text class="countdown" wx:if="{{item.status === 1}}">{{item.remain}}</text>
        </view>

        <view class="group-rules">{{item.rules}}</view>

        <view class="btn-row">
          <!-- 我的拼团：进行中邀请好友（触发分享 + shareReward），已成团查看订单 -->
          <block wx:if="{{tab === 'mine'}}">
            <button wx:if="{{item.status === 1}}" class="btn-primary op-btn share-btn"
                    open-type="share"
                    data-id="{{item.id}}" data-name="{{item.name}}" data-price="{{item.groupPrice}}"
                    data-lack="{{item.lack}}" data-pic="{{item.pic}}"
                    catchtap="onShareBtn">邀请好友</button>
            <view wx:elif="{{item.status === 2}}" class="btn-primary op-btn"
                  data-order-id="{{item.myOrderId}}" catchtap="onViewOrder">查看订单</view>
          </block>
          <!-- 可参团 / 全部 -->
          <block wx:else>
            <view class="btn-primary op-btn" wx:if="{{item.status === 1}}"
                  data-id="{{item.id}}" catchtap="onGoGroup">去参团</view>
            <view class="btn-primary op-btn" wx:elif="{{item.status === 2}}"
                  data-id="{{item.goodsId}}" catchtap="onViewGoods">查看商品</view>
            <view class="btn-plain op-btn" wx:elif="{{item.status === 3}}" catchtap="onRestart">再次发起</view>
          </block>
        </view>
      </view>
    </block>
    <view class="empty-state" wx:else>
      <image class="empty-img" src="/static/images/default.png" binderror="onImgError"></image>
      <view class="empty-text">{{tab === 'mine' ? '暂无我的拼团，快去参团吧' : tab === 'joinable' ? '暂无进行中的拼团' : '暂无拼团记录'}}</view>
    </view>

    <!-- ===== 团购批发 ===== -->
    <view class="card" wx:if="{{wholesale.length}}">
      <view class="sec-title">团购批发</view>
      <view class="ws-item" wx:for="{{wholesale}}" wx:key="id" wx:for-index="w">
        <view class="ws-head">
          <image class="ws-pic" mode="aspectFill"
                 src="{{item._imgErr ? '/static/images/default.png' : item.pic}}"
                 data-key="{{w}}" data-field="wholesale" binderror="onImgError"></image>
          <view class="ws-title ellipsis-2">{{item.title}}</view>
        </view>
        <view class="ladder-row {{ld.best ? 'best' : ''}}" wx:for="{{item.ladder}}" wx:for-item="ld" wx:key="count">
          <text>{{ld.count}} 件起</text>
          <view class="ladder-price-wrap">
            <text class="price"><text class="symbol">￥</text>{{f.fp(ld.price)}} / 件</text>
            <text class="best-tag" wx:if="{{ld.best}}">最低档</text>
          </view>
        </view>
        <view class="btn-primary ws-btn" data-index="{{w}}" bindtap="openWs">批量加购</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="skeleton" style="height:280rpx;margin:24rpx;border-radius:16rpx;"></view>
    <view class="skeleton" style="height:280rpx;margin:24rpx;border-radius:16rpx;"></view>
  </block>

  <view class="demo-tip">演示环境，不产生真实交易</view>
</view>

<!-- ===== 批量加购弹层 ===== -->
<block wx:if="{{wsShow && wsItem}}">
  <view class="sku-mask" bindtap="closeWs"></view>
  <view class="sku-panel">
    <view class="sku-head">
      <image class="sku-pic" mode="aspectFill"
             src="{{wsImgErr ? '/static/images/default.png' : wsItem.pic}}"
             data-field="wsImgErr" binderror="onImgError"></image>
      <view class="sku-head-info">
        <text class="price sku-price"><text class="symbol">￥</text>{{wsTotalText}}</text>
        <text class="sku-stock">共 {{wsTotalCount}} 件（{{wsItem.ladder[wsLadderIndex].count}} 件/份 × {{wsQty}} 份）</text>
        <text class="sku-chosen ellipsis">已选：批发 {{wsItem.ladder[wsLadderIndex].count}}件装</text>
      </view>
      <text class="sku-close" bindtap="closeWs">✕</text>
    </view>
    <scroll-view scroll-y class="sku-body">
      <view class="sku-dim">
        <view class="sku-dim-name">批发档位（件数越多单价越低）</view>
        <view class="sku-values">
          <view wx:for="{{wsItem.ladder}}" wx:key="count" wx:for-item="ld" wx:for-index="li"
            class="sku-value {{wsLadderIndex === li ? 'active' : ''}}"
            data-index="{{li}}" bindtap="selectWsLadder">
            <text class="sku-value-label">{{ld.count}} 件装</text>
            <text class="sku-value-sub">￥{{f.fp(ld.price)}} / 件</text>
          </view>
        </view>
      </view>
      <view class="sku-count-row">
        <text class="sku-count-label">份数（每份 {{wsItem.ladder[wsLadderIndex].count}} 件）</text>
        <view class="stepper">
          <view class="stepper-btn {{wsQty <= 1 ? 'disabled' : ''}}" bindtap="minusWsQty">−</view>
          <text class="stepper-num">{{wsQty}}</text>
          <view class="stepper-btn" bindtap="plusWsQty">＋</view>
        </view>
      </view>
    </scroll-view>
    <view class="sku-confirm" bindtap="confirmWs">加入购物车 ￥{{wsTotalText}}</view>
    <view class="demo-tip sku-demo">演示环境，不产生真实交易</view>
  </view>
</block>
