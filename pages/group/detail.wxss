/* pages/group/detail.wxss —— 拼团详情页 */
.page { padding-bottom: 40rpx; }
.page.has-bar { padding-bottom: 140rpx; }

/* ===== 状态横幅 ===== */
.banner {
  margin: 24rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  text-align: center;
}
.banner.green { background: #e9f7ef; color: #2b9e5f; }
.banner.gray { background: #f2f3f5; color: #838383; }

/* ===== 商品卡 ===== */
.goods-card { display: flex; }
.goods-pic {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
  flex-shrink: 0;
}
.goods-info { flex: 1; margin-left: 20rpx; min-width: 0; }
.goods-name { font-size: 30rpx; line-height: 1.4; }
.price-row { display: flex; align-items: baseline; margin-top: 16rpx; flex-wrap: wrap; }
.group-price { font-size: 44rpx; }
.price-row .price-origin { margin-left: 16rpx; }
.saved-tag {
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #b4282d;
  background: #fbeaea;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  line-height: 1.6;
}
.status-row { display: flex; align-items: center; margin-top: 16rpx; }
.status-badge {
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  line-height: 1.6;
}
.status-badge.orange { background: #fdf3e6; color: #e08a1e; }
.status-badge.green { background: #e9f7ef; color: #2b9e5f; }
.status-badge.gray { background: #f2f3f5; color: #838383; }
.required-text { font-size: 22rpx; color: #838383; margin-left: 16rpx; }

/* ===== 成团进度 ===== */
.progress-card { text-align: center; }
.progress-title { font-size: 30rpx; font-weight: bold; }
.lack-num { color: #b4282d; font-size: 36rpx; margin: 0 4rpx; }
.progress-bar {
  height: 20rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
  margin-top: 24rpx;
  overflow: hidden;
}
.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: #e08a1e;
  transition: width 0.3s ease;
}
.progress-inner.green { background: #2b9e5f; }
.progress-inner.gray { background: #c8c8c8; }
.progress-text { font-size: 22rpx; color: #838383; margin-top: 12rpx; }

.member-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
}
.member-wrap { position: relative; margin-right: -12rpx; }
.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
  background: #f2f3f5;
}
.leader-tag {
  position: absolute;
  bottom: -14rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #b4282d;
  color: #fff;
  font-size: 16rpx;
  border-radius: 999rpx;
  padding: 0 8rpx;
  line-height: 1.5;
  white-space: nowrap;
}
.avatar-placeholder {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx dashed #ccc;
  color: #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-left: 20rpx;
}

.countdown-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 36rpx;
}
.countdown-label { font-size: 24rpx; color: #838383; margin-right: 12rpx; }
.countdown { font-size: 28rpx; color: #b4282d; font-weight: bold; font-family: monospace; }
.countdown.ended { color: #838383; }

/* ===== 邀请提示条 ===== */
.invite-tip {
  margin: 24rpx 24rpx 0;
  background: #fdf3e6;
  color: #e08a1e;
  font-size: 22rpx;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  line-height: 1.5;
}

/* ===== 规则卡 ===== */
.rules-title { font-size: 28rpx; font-weight: bold; margin-bottom: 12rpx; }
.rules-text { font-size: 24rpx; color: #666; line-height: 1.6; }
.rules-text.sub { color: #b0b0b0; margin-top: 8rpx; }

/* ===== 底部操作区 ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.bar-price { display: flex; flex-direction: column; margin-right: 24rpx; }
.bar-price .price { font-size: 40rpx; }
.bar-price-sub { font-size: 20rpx; color: #838383; }
.bar-btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  border-radius: 999rpx;
  padding: 18rpx 0;
  margin: 0;
  line-height: 1.5;
}
.bar-btn.half { margin-left: 20rpx; }
.bar-btn.half:first-child { margin-left: 0; }
/* button open-type=share 样式重置 */
.share-btn {
  background: #b4282d;
  border: none;
  font-weight: normal;
}
.share-btn::after { border: none; }

/* ===== SKU 弹层（沿用详情页交互风格）===== */
.sku-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(0, 0, 0, 0.5);
  animation: fade-in 0.25s ease;
}
@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
.sku-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 41;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx 0;
  animation: slide-up 0.25s ease;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
@keyframes slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.sku-head { display: flex; align-items: flex-start; }
.sku-pic {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
  flex-shrink: 0;
  margin-top: -56rpx;
  border: 4rpx solid #fff;
}
.sku-head-info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.sku-price { font-size: 44rpx; }
.sku-stock { color: #838383; font-size: 24rpx; margin-top: 8rpx; }
.sku-chosen { color: #666; font-size: 24rpx; margin-top: 8rpx; }
.sku-close { color: #b0b0b0; font-size: 32rpx; padding: 0 8rpx; }
.sku-body { max-height: 640rpx; margin-top: 24rpx; }
.sku-dim { margin-bottom: 24rpx; }
.sku-dim-name { font-size: 26rpx; font-weight: bold; margin-bottom: 16rpx; }
.sku-values { display: flex; flex-wrap: wrap; }
.sku-value {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f2f3f5;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  padding: 12rpx 28rpx;
  margin: 0 20rpx 20rpx 0;
}
.sku-value.active { background: #fbeaea; border-color: #b4282d; }
.sku-value.active .sku-value-label, .sku-value.active .sku-value-sub { color: #b4282d; }
.sku-value.disabled { opacity: 0.4; }
.sku-value-label { font-size: 26rpx; }
.sku-value-sub { font-size: 20rpx; color: #838383; margin-top: 4rpx; }
.sku-count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 24rpx;
}
.sku-count-label { font-size: 26rpx; font-weight: bold; }
.stepper { display: flex; align-items: center; }
.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  background: #f2f3f5;
  border-radius: 8rpx;
  font-size: 36rpx;
  color: #333;
}
.stepper-btn.disabled { color: #c8c8c8; }
.stepper-num { min-width: 80rpx; text-align: center; font-size: 30rpx; }
.sku-confirm {
  background: #b4282d;
  color: #fff;
  text-align: center;
  font-size: 30rpx;
  border-radius: 999rpx;
  padding: 20rpx 0;
  margin: 8rpx 0 12rpx;
}
.sku-confirm.disabled { opacity: 0.6; }
.sku-demo { margin: 0 0 16rpx; }
