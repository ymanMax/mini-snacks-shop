/* pages/mine/mine.wxss */
.page { padding-bottom: 40rpx; }

/* ===== 头部用户卡 ===== */
.user-card {
  background: linear-gradient(135deg, #d43a3f 0%, #b4282d 60%, #8f1f23 100%);
  padding: 48rpx 32rpx 32rpx;
  color: #fff;
}
.user-top { display: flex; align-items: center; }
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  background: #fff;
  flex-shrink: 0;
}
.user-info { flex: 1; margin-left: 24rpx; min-width: 0; }
.name-row { display: flex; align-items: center; }
.nickname { font-size: 36rpx; font-weight: bold; }
.level-badge {
  margin-left: 16rpx;
  background: linear-gradient(90deg, #f5d67b, #e0b44c);
  color: #6b4e0b;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.6;
}
.growth-row { display: flex; align-items: center; margin-top: 16rpx; }
.growth-bar {
  flex: 1;
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.3);
  overflow: hidden;
}
.growth-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffe9a8, #f5c84c);
}
.growth-num { font-size: 20rpx; margin-left: 16rpx; opacity: 0.9; }
.growth-tip { display: block; font-size: 20rpx; opacity: 0.85; margin-top: 8rpx; }

.quick-row {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 16rpx;
  padding: 20rpx 0;
}
.quick-item { flex: 1; text-align: center; }
.quick-num { display: block; font-size: 36rpx; font-weight: bold; }
.quick-label { display: block; font-size: 22rpx; opacity: 0.85; margin-top: 4rpx; }
.quick-divider { width: 2rpx; height: 48rpx; background: rgba(255, 255, 255, 0.3); }

.login-entry {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  border: 2rpx dashed rgba(255, 255, 255, 0.4);
  border-radius: 999rpx;
  padding: 10rpx 0;
}

/* ===== 订单快捷入口 ===== */
.order-card { padding: 24rpx 24rpx 0; }
.order-icons { display: flex; }
.order-item { flex: 1; text-align: center; }
.order-icon-wrap { position: relative; display: inline-block; }
.order-icon { font-size: 48rpx; }
.order-badge {
  position: absolute;
  top: -10rpx;
  left: 44rpx;
}
.order-name { display: block; font-size: 22rpx; color: #666; margin-top: 8rpx; }
.order-card .hairline { margin: 24rpx -24rpx 0; }
.all-order {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  font-size: 28rpx;
}

/* ===== 菜单 ===== */
.menu-card { padding-top: 8rpx; padding-bottom: 8rpx; }
.menu-title { font-size: 24rpx; color: #838383; padding: 20rpx 0 8rpx; }
.menu-row {
  display: flex;
  align-items: center;
  height: 96rpx;
  border-bottom: 2rpx solid #f5f5f5;
}
.menu-row:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; width: 56rpx; }
.menu-name { flex: 1; font-size: 28rpx; }
.arrow { color: #c8c8c8; font-size: 36rpx; }
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #b4282d;
  margin-right: 16rpx;
}
.msg-badge { margin-right: 16rpx; }

/* ===== 弹层 ===== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}
.sheet.show { transform: translateY(0); }
.sheet-title { font-size: 32rpx; font-weight: bold; text-align: center; margin-bottom: 24rpx; }
.sheet-line { font-size: 26rpx; color: #555; line-height: 2; }
.sheet-btn { margin-top: 32rpx; }
