.mine-page { padding-bottom: 30rpx; }

/* 顶部会员卡 */
.hero {
  background: linear-gradient(150deg, #d8443a, #b4282d 70%);
  padding: 30rpx 30rpx 26rpx;
  color: #fff;
}
.hero-row { display: flex; align-items: center; }
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.6);
  background: #fff;
}
.hero-info { flex: 1; margin-left: 24rpx; min-width: 0; }
.name-row { display: flex; align-items: center; }
.nickname { font-size: 38rpx; font-weight: 700; }
.level-chip {
  margin-left: 16rpx;
  font-size: 20rpx;
  background: rgba(255,255,255,0.22);
  border: 1rpx solid rgba(255,255,255,0.5);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
}
.phone { font-size: 22rpx; opacity: 0.85; margin-top: 8rpx; }
.growth { margin-top: 14rpx; }
.growth-bar {
  height: 12rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 999rpx;
  overflow: hidden;
}
.growth-in {
  height: 100%;
  background: linear-gradient(90deg, #ffd98a, #ffb74d);
  border-radius: 999rpx;
  transition: width 0.4s;
}
.growth-text { display: block; font-size: 20rpx; opacity: 0.85; margin-top: 8rpx; }
.login-btn {
  margin: 16rpx 0 0;
  display: inline-block;
  background: #fff;
  color: #b4282d;
  font-size: 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  padding: 0 40rpx;
}
.login-btn::after { border: none; }

.stat-row {
  display: flex;
  margin-top: 28rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 14rpx;
  padding: 18rpx 0;
}
.stat { flex: 1; text-align: center; }
.stat-num { display: block; font-size: 34rpx; font-weight: 700; }
.stat-label { display: block; font-size: 20rpx; opacity: 0.85; margin-top: 4rpx; }

/* 卡片标题 */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.card-title { font-size: 30rpx; font-weight: 700; }
.card-more { font-size: 24rpx; color: #969799; }

/* 订单入口 */
.order-icons { display: flex; padding: 10rpx 0 6rpx; }
.oi {
  flex: 1;
  text-align: center;
  position: relative;
  padding: 12rpx 0;
}
.oi-emoji { display: block; font-size: 48rpx; }
.oi-label { font-size: 22rpx; color: #555; margin-top: 8rpx; }
.oi .badge-dot { top: 0; right: 30rpx; }

/* 菜单 */
.menu-card { padding: 10rpx 24rpx 20rpx; }
.menu-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-row:last-child { border-bottom: none; }
.m-emoji { font-size: 36rpx; width: 60rpx; }
.m-label { flex: 1; font-size: 28rpx; color: #333; }
.m-value { font-size: 24rpx; color: #969799; margin-right: 10rpx; }
.m-red-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #b4282d;
  margin-right: 10rpx;
}
.m-badge { position: static; margin-right: 10rpx; }
.m-arrow { color: #c0c4cc; font-size: 34rpx; }

.version { text-align: center; color: #c0c4cc; font-size: 22rpx; margin-top: 40rpx; }

/* 通用弹层 */
.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pop-sheet {
  width: 620rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 36rpx 20rpx;
}
.pop-title { font-size: 34rpx; font-weight: 700; text-align: center; }
.pop-body { margin: 24rpx 0; }
.pop-line { font-size: 26rpx; color: #555; line-height: 1.8; }
.pop-btn {
  margin-top: 10rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  background: linear-gradient(90deg, #d8443a, #b4282d);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
}

/* 客服面板 */
.service-mask { align-items: flex-end; }
.service-panel {
  width: 100%;
  height: 78vh;
  background: #f5f6f7;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}
.service-head {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  position: relative;
}
.service-close { position: absolute; right: 30rpx; top: 0; color: #969799; font-size: 34rpx; }
.service-body { flex: 1; padding: 24rpx; }
.msg-item { display: flex; margin-bottom: 24rpx; }
.msg-item.me { justify-content: flex-end; }
.msg-bubble {
  max-width: 500rpx;
  background: #fff;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  line-height: 1.5;
}
.msg-item.me .msg-bubble { background: #b4282d; color: #fff; }
.service-input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
}
.service-input {
  flex: 1;
  height: 72rpx;
  background: #f5f6f7;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 27rpx;
}
.service-send {
  margin-left: 16rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 34rpx;
  background: #b4282d;
  color: #fff;
  border-radius: 999rpx;
  font-size: 27rpx;
}
