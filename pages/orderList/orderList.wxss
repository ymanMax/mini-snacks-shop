/* pages/orderList/orderList.wxss */
.main {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

.page-header {
  background-color: white;
  padding: 30rpx;
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  border-bottom: 1rpx solid #eee;
}

.orders-filter {
  display: flex;
  background-color: white;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
  overflow-x: auto;
}

.filter-btn {
  flex-shrink: 0;
  margin: 0 20rpx;
  padding: 15rpx 30rpx;
  border: 1rpx solid #ddd;
  border-radius: 25rpx;
  background-color: white;
  font-size: 28rpx;
  color: #666;
}

.filter-btn.active {
  background-color: #0ea47a;
  color: white;
  border-color: #0ea47a;
}

.orders-list {
  padding: 0 20rpx;
}

.order-item {
  background-color: white;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
  padding: 30rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-number {
  font-size: 28rpx;
  color: #333;
}

.order-status {
  font-size: 26rpx;
  color: #0ea47a;
}

.order-products {
  margin-bottom: 20rpx;
}

.product-item {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.product-price {
  font-size: 26rpx;
  color: #999;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.order-total {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.order-actions {
  display: flex;
}

.action-btn {
  margin-left: 15rpx;
}

.pay-btn {
  background-color: #0ea47a;
  color: white;
}

.cancel-btn {
  background-color: #ff4444;
  color: white;
}

.confirm-btn {
  background-color: #ffa500;
  color: white;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 30rpx;
}
