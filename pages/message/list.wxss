/* pages/message/list.wxss */
.page { padding-bottom: 40rpx; }

/* 类型分组 Tab */
.type-tabs {
  position: sticky; top: 0; z-index: 10;
  display: flex; background: #fff;
}
.type-tab {
  position: relative; flex: 1; text-align: center;
  padding: 24rpx 0; font-size: 28rpx; color: #666;
}
.type-tab.on { color: #b4282d; font-weight: bold; }
.tab-line {
  position: absolute; left: 50%; bottom: 8rpx; transform: translateX(-50%);
  width: 48rpx; height: 6rpx; border-radius: 999rpx; background: #b4282d;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx;
}
.unread-text { font-size: 24rpx; color: #838383; }
.read-all {
  font-size: 24rpx;
  color: #b4282d;
  border: 2rpx solid #b4282d;
  border-radius: 999rpx;
  padding: 6rpx 28rpx;
}

.msg-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
}
.msg-card.read { opacity: 0.75; }
.msg-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.msg-icon.blue { background: #e8f1fd; }
.msg-icon.red { background: #fbeaea; }
.msg-icon.orange { background: #fdf3e6; }
.msg-icon.green { background: #e9f7ef; }
.msg-body { flex: 1; margin-left: 20rpx; min-width: 0; }
.msg-title-row { display: flex; align-items: center; }
.msg-title { font-size: 28rpx; color: #555; }
.msg-title.bold { font-weight: bold; color: #333; }
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #b4282d;
  margin-left: 12rpx;
}
.msg-content { font-size: 24rpx; color: #838383; line-height: 1.5; margin-top: 10rpx; }
.msg-time { font-size: 20rpx; color: #b0b0b0; margin-top: 10rpx; }

.load-more { text-align: center; color: #b0b0b0; font-size: 24rpx; padding: 32rpx 0; }
