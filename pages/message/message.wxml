<view class="mg-page">
  <view class="mg-head">
    <scroll-view scroll-x class="mg-tabs" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{tabs}}" wx:key="type" data-type="{{item.type}}" bindtap="switchTab"
        class="mg-tab {{active === item.type ? 'on' : ''}}">{{item.label}}</view>
    </scroll-view>
    <text class="mg-readall" bindtap="readAll">全部已读</text>
  </view>

  <skeleton wx:if="{{loading}}" type="list" count="{{5}}"></skeleton>

  <view wx:elif="{{messages.length}}">
    <view class="msg-item {{!item.isRead ? 'unread' : ''}}" wx:for="{{messages}}" wx:key="id"
      data-id="{{item.id}}" bindtap="readOne">
      <view class="msg-icon">{{item.icon}}</view>
      <view class="msg-body">
        <view class="msg-title">
          <text class="msg-name ellipsis">{{item.title}}</text>
          <view class="msg-dot" wx:if="{{!item.isRead}}"></view>
        </view>
        <view class="msg-content">{{item.content}}</view>
        <view class="msg-meta">
          <text class="msg-type">{{item.typeText}}</text>
          <text class="msg-time">{{item.timeText}}</text>
        </view>
      </view>
    </view>
    <load-more status="{{loadStatus}}" bind:retry="onRetry"></load-more>
  </view>

  <empty-state wx:else img="/static/images/empty_message.png" text="暂无消息" sub="订单与活动消息会在这里提醒你"></empty-state>
</view>
