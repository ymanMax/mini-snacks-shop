.tabs {
  display: flex;
  background: #fff;
  height: 88rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #f0f0f0;
}
.tab {
  flex: 1;
  text-align: center;
  line-height: 88rpx;
  font-size: 27rpx;
  color: #666;
  position: relative;
}
.tab.on { color: #b4282d; font-weight: 700; }
.tab.on::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 44rpx;
  height: 6rpx;
  background: #b4282d;
  border-radius: 3rpx;
}
.ticket-list { padding: 24rpx; }
.ticket {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.tk-head { display: flex; justify-content: space-between; align-items: center; }
.tk-no { font-size: 22rpx; color: #969799; }
.tk-status { font-size: 24rpx; font-weight: 600; }
.status-1 { color: #ff9900; }
.status-2 { color: #2f7cf6; }
.status-3 { color: #0ea47a; }
.status-4 { color: #969799; }
.tk-goods { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f7f8fa; }
.tk-img { width: 90rpx; height: 90rpx; border-radius: 10rpx; margin-right: 18rpx; }
.tk-name { flex: 1; min-width: 0; font-size: 26rpx; }
.tk-count { color: #969799; font-size: 24rpx; }
.tk-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 18rpx;
  font-size: 24rpx;
  color: #666;
}
.tk-amount { color: #b4282d; font-weight: 700; }
