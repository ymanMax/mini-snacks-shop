.apply-page { padding-bottom: 20rpx; }
.block-title { font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx; }

.type-list { display: flex; }
.type-item {
  position: relative;
  flex: 1;
  border: 2rpx solid #f0f0f0;
  border-radius: 14rpx;
  padding: 24rpx 12rpx;
  margin-right: 16rpx;
  text-align: center;
}
.type-item:last-child { margin-right: 0; }
.type-item.on { border-color: #b4282d; background: #fff9f9; }
.type-icon { font-size: 48rpx; }
.type-name { font-size: 28rpx; font-weight: 600; margin-top: 10rpx; }
.type-desc { font-size: 20rpx; color: #969799; margin-top: 8rpx; line-height: 1.4; }
.type-check {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: #b4282d;
  color: #fff;
  font-size: 20rpx;
}

.reason-list { display: flex; flex-wrap: wrap; }
.reason-item {
  background: #f5f6f7;
  color: #555;
  font-size: 24rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  margin: 0 18rpx 18rpx 0;
}
.reason-item.on { background: #fdecec; color: #b4282d; border: 1rpx solid #b4282d; }
.desc-input {
  width: 100%;
  min-height: 150rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}
.upload-tip { margin-top: 16rpx; font-size: 22rpx; color: #969799; }

.goods-row { display: flex; padding: 16rpx 0; border-top: 1rpx solid #f5f5f5; }
.g-img { width: 110rpx; height: 110rpx; border-radius: 10rpx; margin-right: 18rpx; }
.g-info { flex: 1; min-width: 0; }
.g-name { font-size: 26rpx; }
.g-spec { font-size: 20rpx; color: #969799; margin-top: 8rpx; background: #f5f6f7; display: inline-block; padding: 2rpx 12rpx; border-radius: 8rpx; }
.g-count { font-size: 24rpx; color: #969799; align-self: center; }
.refund-amount {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 24rpx;
  margin-top: 10rpx;
  font-size: 28rpx;
}
.refund-amount .int { font-size: 40rpx; }

.bottom-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
}
.service-btn {
  width: 200rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}
.submit-btn {
  flex: 1;
  background: linear-gradient(90deg, #d8443a, #b4282d);
  color: #fff;
  border-radius: 999rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
}
.submit-btn::after { border: none; }
.submit-btn[disabled] { background: #f1b4b6; color: #fff; }
