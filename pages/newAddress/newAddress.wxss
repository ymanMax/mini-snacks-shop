.na-page { padding-bottom: 160rpx; }
.form-card {
  background: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
}
.form-row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.form-row:last-child { border-bottom: none; }
.form-row.align-top { align-items: flex-start; padding: 24rpx 0; }
.form-label { width: 160rpx; font-size: 28rpx; color: #333; flex-shrink: 0; }
.form-input { flex: 1; font-size: 28rpx; text-align: right; }
.form-input.ph { color: #c0c4cc; }
.picker .form-input { text-align: right; }
.map-entry .form-input { font-size: 26rpx; }
.picker .cell-arrow { margin-left: 10rpx; }
.picker-text { flex: 1; text-align: right; font-size: 28rpx; }
.form-textarea {
  flex: 1;
  min-height: 120rpx;
  font-size: 28rpx;
  text-align: right;
}

.tag-row { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.tag-picker { flex: 1; display: flex; justify-content: flex-end; flex-wrap: wrap; }
.tag-opt {
  font-size: 24rpx;
  padding: 8rpx 28rpx;
  background: #f5f6f7;
  border-radius: 999rpx;
  margin-left: 16rpx;
  color: #555;
}
.tag-opt.on { background: #fdecec; color: #b4282d; border: 1rpx solid #b4282d; }
.switch-row { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 0; }
.switch-row .form-label { width: auto; }

.save-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
}
.save-btn {
  background: linear-gradient(90deg, #d8443a, #b4282d);
  color: #fff;
  border-radius: 999rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
}
.save-btn::after { border: none; }
