/* pages/newAddress/newAddress.wxss */
page { background: #f5f6f7; }

.form-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx 0;
  padding: 0 24rpx;
}
.form-row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid #f5f6f7;
}
.form-row:last-child { border-bottom: none; }
.form-row.align-top { align-items: flex-start; padding: 24rpx 0; }
.form-row.column { flex-direction: column; align-items: stretch; padding: 24rpx 0; }
.form-label {
  width: 150rpx;
  font-size: 27rpx;
  color: #333;
  flex-shrink: 0;
}
.form-input { flex: 1; font-size: 27rpx; }
.form-picker { flex: 1; }
.picker-text { font-size: 27rpx; color: #333; }
.map-entry-text { color: #b4282d; font-size: 26rpx; }
.form-textarea {
  flex: 1;
  min-height: 120rpx;
  font-size: 27rpx;
  line-height: 1.5;
}
.tag-row { display: flex; gap: 16rpx; }
.tag-opt {
  font-size: 24rpx;
  color: #666;
  background: #f5f6f7;
  border-radius: 999rpx;
  padding: 8rpx 32rpx;
}
.tag-opt.on { background: #fdecec; color: #b4282d; font-weight: 600; }
.distance-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 24rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, .05);
}
.save-btn {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #d34046, #b4282d);
}
.save-btn::after { border: none; }
