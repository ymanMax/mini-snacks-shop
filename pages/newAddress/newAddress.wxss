/* pages/newAddress/newAddress.wxss */
.form-row { display: flex; align-items: center; padding: 24rpx 0; min-height: 56rpx; }
.form-label { width: 160rpx; flex-shrink: 0; font-size: 28rpx; color: #333; }
.form-input { flex: 1; font-size: 28rpx; }
.form-value { flex: 1; font-size: 28rpx; color: #333; }
.form-value.placeholder { color: #b0b0b0; }
.form-arrow { color: #b0b0b0; font-size: 36rpx; margin-left: 12rpx; }
.detail-row { align-items: flex-start; }
.form-textarea { flex: 1; height: 140rpx; font-size: 28rpx; padding-top: 6rpx; }

.tag-opts { flex: 1; display: flex; }
.tag-opt {
  border: 2rpx solid #e0e0e0; color: #666; font-size: 26rpx;
  border-radius: 999rpx; padding: 8rpx 36rpx; margin-right: 20rpx;
}
.tag-opt.on { border-color: #b4282d; color: #b4282d; background: #fbeaea; }

.form-switch { transform: scale(0.8); }

.save-wrap { padding: 24rpx; }
.save-btn { width: 100%; }

/* ===== 模拟定位 ===== */
.locate-bar {
  display: flex; align-items: center;
  background: #fff; border-radius: 16rpx;
  margin: 24rpx 24rpx 0; padding: 24rpx;
}
.locate-icon { font-size: 36rpx; margin-right: 16rpx; }
.locate-text { font-size: 28rpx; color: #b4282d; font-weight: bold; }
.locate-dist { flex: 1; text-align: right; color: #838383; font-size: 24rpx; margin-left: 16rpx; }
.locate-arrow { color: #b0b0b0; font-size: 36rpx; margin-left: 12rpx; }

.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 40;
  background: rgba(0, 0, 0, 0.5);
}
.map-panel {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 41;
  background: #fff; border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  transform: translateY(100%); visibility: hidden; transition: transform 0.25s;
}
.map-panel.show { transform: translateY(0); visibility: visible; }
.map-title { font-size: 32rpx; font-weight: bold; text-align: center; margin-bottom: 24rpx; }

/* 伪地图区域：网格背景 + 中心定位点 */
.fake-map {
  position: relative; height: 340rpx; border-radius: 16rpx; overflow: hidden;
  background:
    repeating-linear-gradient(0deg, #e8ecf0 0, #e8ecf0 2rpx, transparent 2rpx, transparent 48rpx),
    repeating-linear-gradient(90deg, #e8ecf0 0, #e8ecf0 2rpx, transparent 2rpx, transparent 48rpx),
    #f6f8fa;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.map-pin { font-size: 64rpx; }
.map-coord {
  margin-top: 16rpx; font-size: 22rpx; color: #666;
  background: rgba(255, 255, 255, 0.85); border-radius: 999rpx; padding: 6rpx 24rpx;
}

.poi-title { font-size: 26rpx; color: #838383; margin: 24rpx 0 8rpx; }
.poi-item {
  display: flex; align-items: center;
  padding: 20rpx 0; border-bottom: 2rpx solid #f5f5f5;
}
.poi-info { flex: 1; min-width: 0; }
.poi-name { font-size: 28rpx; font-weight: bold; }
.poi-addr { color: #838383; font-size: 24rpx; margin-top: 6rpx; }
.poi-choose {
  color: #b4282d; font-size: 24rpx;
  border: 2rpx solid #b4282d; border-radius: 999rpx;
  padding: 6rpx 24rpx; margin-left: 20rpx; flex-shrink: 0;
}
.map-close { margin-top: 24rpx; text-align: center; }
