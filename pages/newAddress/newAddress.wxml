<view class="page-container new-addr-page">

  <!-- 表单卡片 -->
  <view class="card form-card">
    <view class="form-row">
      <view class="form-label">收货人</view>
      <input
        class="form-input"
        value="{{name}}"
        placeholder="请输入收货人真实姓名"
        placeholder-class="form-ph"
        maxlength="20"
        bindinput="onNameInput" />
    </view>

    <view class="form-row">
      <view class="form-label">手机号</view>
      <input
        class="form-input"
        type="number"
        value="{{phone}}"
        placeholder="请输入 11 位手机号"
        placeholder-class="form-ph"
        maxlength="11"
        bindinput="onPhoneInput" />
    </view>

    <view class="form-row">
      <view class="form-label">所在地区</view>
      <picker class="flex-1" mode="region" value="{{region}}" bindchange="onRegionChange">
        <view class="form-value {{regionText ? '' : 'form-ph'}}">
          {{regionText || '请选择省 / 市 / 区'}}
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 详细地址（右侧地图选点 + 距离/超范围提示） -->
    <view class="form-row form-row-area">
      <view class="area-head">
        <view class="form-label">详细地址</view>
        <text class="map-btn" bindtap="onOpenMap">📍 地图选点</text>
      </view>
      <textarea
        class="form-textarea"
        value="{{detail}}"
        placeholder="街道、楼牌号等（如：科技园南区数字大厦 8 栋 1201 室）"
        placeholder-class="form-ph"
        maxlength="120"
        bindinput="onDetailInput" />
      <view class="distance-info" wx:if="{{distanceKm !== null}}">
        <text class="distance-now">📏 当前距离：{{distanceKm}}km（配送范围 {{maxKm}}km 内）</text>
        <view class="distance-warn" wx:if="{{distanceKm > maxKm}}">⚠️ 该地址超出配送范围（{{maxKm}}km），提交后下单将被拦截</view>
      </view>
    </view>

    <view class="form-row">
      <view class="form-label">地址标签</view>
      <view class="tag-options">
        <view
          wx:for="{{tags}}"
          wx:key="*this"
          class="tag-option {{tag === item ? 'tag-option-on' : ''}}"
          data-tag="{{item}}"
          bindtap="onTagTap">{{item}}</view>
      </view>
    </view>

    <view class="form-row form-row-last">
      <view class="form-label">设为默认地址</view>
      <view class="flex-1"></view>
      <switch checked="{{isDefault}}" color="#b4282d" bindchange="onDefaultChange" />
    </view>
  </view>

  <!-- 删除按钮（仅编辑模式） -->
  <button class="btn-plain del-btn" wx:if="{{isEdit}}" bindtap="onDelete">删除地址</button>

  <view class="footer-placeholder"></view>

  <!-- 底部固定保存按钮 -->
  <view class="bottom-bar">
    <button class="btn-primary save-btn" bindtap="onSave">保存</button>
    <view class="safe-bottom"></view>
  </view>

  <!-- 地图选点：半屏 POI 面板 -->
  <view class="popup-mask" wx:if="{{showPoi}}" bindtap="onClosePoi"></view>
  <view class="popup-bottom poi-popup" wx:if="{{showPoi}}">
    <view class="popup-head">
      <text class="popup-title">地图选点</text>
      <text class="relocate-btn" bindtap="onRelocate">🎯 重新定位</text>
      <text class="popup-close" bindtap="onClosePoi">×</text>
    </view>
    <view class="poi-search">
      <input
        class="poi-search-input"
        value="{{poiKeyword}}"
        placeholder="搜索地点名称 / 区域 / 地址"
        placeholder-class="form-ph"
        bindinput="onPoiSearch" />
    </view>
    <scroll-view class="poi-scroll" scroll-y="{{true}}">
      <view class="poi-loading" wx:if="{{poiLoading}}">加载中...</view>
      <block wx:else>
        <view
          class="poi-item"
          wx:for="{{poiView}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPickPoi">
          <view class="poi-pin">📍</view>
          <view class="flex-1">
            <view class="poi-name">{{item.name}}</view>
            <view class="poi-sub ellipsis">{{item.district}} · {{item.detail}}</view>
          </view>
          <text class="poi-dist {{item.distanceKm > maxKm ? 'poi-dist-oor' : ''}}">{{item.distanceKm}}km</text>
        </view>
        <view class="poi-empty" wx:if="{{!poiView.length}}">未找到匹配地点</view>
      </block>
    </scroll-view>
    <view class="safe-bottom"></view>
  </view>
</view>
