<!--pages/newAddress/newAddress.wxml-->
<view class="na-page">
  <view class="form-card">
    <view class="form-row">
      <text class="form-label">收货人</text>
      <input class="form-input" placeholder="请输入姓名" value="{{name}}" data-field="name" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}"
        data-field="phone" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="form-label">所在地区</text>
      <picker mode="region" value="{{region}}" bindchange="onRegion" class="form-picker">
        <view class="picker-text">{{region[0]}} {{region[1]}} {{region[2]}} ›</view>
      </picker>
    </view>
    <view class="form-row map-entry" bindtap="chooseOnMap">
      <text class="form-label">地图选点</text>
      <text class="map-entry-text">🗺 在地图上选择位置 ›</text>
    </view>
    <view class="form-row align-top">
      <text class="form-label">详细地址</text>
      <textarea class="form-textarea" placeholder="楼栋/门牌号等详细信息" value="{{detail}}"
        data-field="detail" bindinput="onInput" maxlength="100" />
    </view>
  </view>

  <view class="form-card">
    <view class="form-row">
      <text class="form-label">地址标签</text>
      <view class="tag-row">
        <view wx:for="{{tags}}" wx:key="*this"
          class="tag-opt {{index === tagIndex ? 'on' : ''}}"
          data-index="{{index}}" bindtap="pickTag">{{item}}</view>
      </view>
    </view>
    <view class="form-row">
      <text class="form-label">默认地址</text>
      <switch checked="{{isDefault}}" color="#b4282d" bindchange="onDefault" />
    </view>
    <view class="form-row column">
      <view class="distance-head">
        <text class="form-label">距店铺距离</text>
        <text class="sub">{{distanceText}}</text>
      </view>
      <slider min="0.5" max="30" step="0.1" value="{{distanceKm}}" activeColor="#b4282d"
        block-size="22" bindchange="onDistance" />
      <text class="light">距离用于试算配送费（演示数据）</text>
    </view>
  </view>

  <view style="height:140rpx"></view>
  <view class="save-bar">
    <button class="save-btn" bindtap="save">保存地址</button>
  </view>
</view>
