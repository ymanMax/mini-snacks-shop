<view class="na-page">
  <view class="form-card">
    <view class="form-row">
      <text class="form-label">收货人</text>
      <input class="form-input" placeholder="请输入姓名" value="{{name}}" data-field="name" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号"
        value="{{phone}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="form-row map-entry" bindtap="goMapPick">
      <text class="form-label">地图选点</text>
      <text class="form-input {{poiName ? '' : 'ph'}}">{{poiName || '模拟定位 / 选择附近地点'}}</text>
      <text class="cell-arrow"></text>
    </view>
    <picker mode="region" value="{{region}}" bindchange="onRegion">
      <view class="form-row picker">
        <text class="form-label">所在地区</text>
        <text class="form-input {{region.length ? '' : 'ph'}}">{{regionText}}</text>
        <text class="cell-arrow"></text>
      </view>
    </picker>
    <view class="form-row align-top">
      <text class="form-label">详细地址</text>
      <textarea class="form-textarea" placeholder="楼栋、门牌号等"
        value="{{detail}}" data-field="detail" bindinput="onInput" maxlength="100" />
    </view>
    <view class="form-row">
      <text class="form-label">距店铺</text>
      <picker mode="selector" range="{{distances}}" value="{{distanceIndex}}" bindchange="onDistance">
        <view class="form-input picker-text">{{distances[distanceIndex]}}<text class="cell-arrow"></text></view>
      </picker>
    </view>
  </view>

  <view class="form-card">
    <view class="tag-row">
      <text class="form-label">地址标签</text>
      <view class="tag-picker">
        <text wx:for="{{tags}}" wx:key="*this" class="tag-opt {{tagIndex === index ? 'on' : ''}}"
          data-index="{{index}}" bindtap="pickTag">{{item}}</text>
      </view>
    </view>
    <view class="switch-row">
      <text class="form-label">设为默认地址</text>
      <switch checked="{{isDefault}}" color="#b4282d" bindchange="onDefault" />
    </view>
  </view>

  <view class="demo-tip">距离用于演示配送费计算（起步 5 元含 3km，超出 1 元/km）</view>

  <view class="save-bar">
    <button class="save-btn" bindtap="save">保存并使用</button>
  </view>
</view>
