<view class="page">
  <!-- 模拟定位入口 -->
  <view class="locate-bar" bindtap="openMockMap">
    <text class="locate-icon">📍</text>
    <text class="locate-text">模拟定位</text>
    <text class="locate-dist" wx:if="{{distanceText}}">{{distanceText}}</text>
    <text class="locate-arrow">›</text>
  </view>

  <view class="card">
    <view class="form-row">
      <text class="form-label">收货人</text>
      <input class="form-input" placeholder="请输入收货人姓名" value="{{form.name}}"
        data-field="name" bindinput="onInput" />
    </view>
    <view class="hairline"></view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入 11 位手机号" value="{{form.phone}}"
        data-field="phone" bindinput="onInput" />
    </view>
    <view class="hairline"></view>
    <picker mode="multiSelector" range="{{range}}" value="{{value}}"
      bindcolumnchange="onColumnChange" bindchange="onRegionChange">
      <view class="form-row">
        <text class="form-label">省市区</text>
        <text class="form-value {{form.province ? '' : 'placeholder'}}">{{regionText}}</text>
        <text class="form-arrow">›</text>
      </view>
    </picker>
    <view class="hairline"></view>
    <view class="form-row detail-row">
      <text class="form-label">详细地址</text>
      <textarea class="form-textarea" placeholder="街道、楼栋、门牌号等" value="{{form.detail}}"
        data-field="detail" bindinput="onInput" maxlength="100" />
    </view>
  </view>

  <view class="card">
    <view class="form-row">
      <text class="form-label">标签</text>
      <view class="tag-opts">
        <view class="tag-opt {{form.tag === item ? 'on' : ''}}" wx:for="{{tags}}" wx:key="*this"
          data-tag="{{item}}" bindtap="chooseTag">{{item}}</view>
      </view>
    </view>
    <view class="hairline"></view>
    <view class="form-row">
      <text class="form-label">设为默认地址</text>
      <switch class="form-switch" checked="{{form.isDefault}}" color="#b4282d" bindchange="onDefaultChange" />
    </view>
  </view>

  <view class="save-wrap">
    <view class="btn-primary save-btn {{saving ? 'disabled' : ''}}" bindtap="save">保存</view>
  </view>

  <!-- ===== 模拟地图选点面板（半屏） ===== -->
  <view class="mask" wx:if="{{showMap}}" bindtap="closeMockMap"></view>
  <view class="map-panel {{showMap ? 'show' : ''}}">
    <view class="map-title">地图选点（模拟）</view>
    <view class="fake-map">
      <view class="map-pin">📍</view>
      <view class="map-coord">{{coordText}}</view>
    </view>
    <view class="poi-title">附近地点</view>
    <view class="poi-item" wx:for="{{pois}}" wx:key="name" data-index="{{index}}" bindtap="choosePoi">
      <view class="poi-info">
        <view class="poi-name">{{item.name}}</view>
        <view class="poi-addr ellipsis">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</view>
      </view>
      <text class="poi-choose">选择</text>
    </view>
    <view class="btn-plain map-close" bindtap="closeMockMap">取消</view>
  </view>
</view>
