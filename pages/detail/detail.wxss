

page{
  background-color: #ffffff;
  font-family: "Helvetica Neue","Hiragino Sans GB","Microsoft YaHei","\9ED1\4F53",Arial,sans-serif;
  font-size: 32rpx;
}
.navigator-hover{
  background: none;
}

.item-box{
    position: relative;
    padding: 40rpx 45rpx;
    text-align: center;
    color: #454552;
    border-bottom: 30rpx solid #ededed;
}
.item-box .item-thumb{
    width: 300rpx;
    height: 300rpx;
    margin: 35rpx 0 125rpx;
}

.to-carts-icon{
    position: absolute;
    right: 70rpx;
    top: 70rpx;
    width: 15rpx;
    height: 15rpx;
    border-radius: 50%;
    opacity: .6;
    -webkit-animation: to_cart .3s ease-out;
    animation: to_cart .3s ease-out;
}
@-webkit-keyframes to_cart {
    0%{
        right:100rpx;
        top:530rpx;
        -webkit-transform: scale(4);
    }
    /*60%{
        top: 20rpx;
    }*/
}
@keyframes to_cart {
    0%{
        right:100rpx;
        top:530rpx;
        transform: scale(4);
    }
    /*60%{
        top: 20rpx;
    }*/
}
.carts-icon{
    position: absolute;
    right: 40rpx;
    top: 40rpx;
    width: 75rpx;
    height: 75rpx;
}
.carts-icon image{
    width: 100%;
    height: 100%;
}
.carts-icon.on{
    -webkit-animation: to_cart_scale .3s ease;
    animation: to_cart_scale .3s ease;
}
@-webkit-keyframes to_cart_scale {
    50%{
        -webkit-transform: scale(1.2);
    }
}
@keyframes to_cart_scale {
    50%{
        transform: scale(1.2);
    }
}
.carts-icon-num{
    position: absolute;
    left: -15rpx;
    width: 40rpx;
    height: 40rpx;
    line-height: 40rpx;
    border-radius: 50%;
    background: #AB956D;
    color: #fff;
    font-size: 24rpx;
}
.item-box .item-operation{
    position: relative;
    width: 100%;
    height: 100rpx;
    line-height: 100rpx;
    padding: 0 50rpx;
    margin-bottom: 60rpx;
    box-sizing: border-box;
    border-radius: 50rpx;
    background: #AB956D;
    color: #fff;
    font-size: 28rpx;
}
.item-operation text{
    display: inline-block;
    height: 100rpx;
}
.item-operation-num{
    width: 100rpx;
    margin-left: 20rpx;
}

item-operation-unadd{
  width: 80rpx;
}
.item-operation-add{
    width: 80rpx;
    margin-right: 20rpx;
}
.item-to-cart{
    width: 210rpx;
    padding-right: 75rpx;
}
.item-cart-img{
    position: absolute;
    right: 50rpx;
    top: 28rpx;
    width: 45rpx;
    height: 45rpx;
}

.item-stock{
    font-size: 28rpx;
    margin-bottom: 20rpx;
}
.item-title{
    font-size: 40rpx;
    margin-bottom: 30rpx;
}
.item-price{
    font-size: 40rpx;
}
.item-tab-nav{
    display: inline-block;
    width: 33.33%;
    height: 90rpx;
    line-height: 90rpx;
    border-bottom: 1rpx solid #ededed;
    box-sizing: border-box;
    text-align: center;
    color: #c7c7cb;
}
.item-tab-nav.on{
    color: #bcaa8a;
    border-bottom: 5rpx solid #bcaa8a;
}
.goods-content{
    padding: 40rpx;
}

/* 评价区域样式 */
.reviews-section{
    padding: 40rpx;
}

/* 评价统计 */
.reviews-summary{
    display: flex;
    padding: 40rpx 0;
    border-bottom: 1rpx solid #ededed;
}

.summary-left{
    flex: 1;
    text-align: center;
}

.total-rating{
    font-size: 60rpx;
    font-weight: bold;
    color: #AB956D;
    margin-bottom: 20rpx;
}

.rating-stars{
    font-size: 32rpx;
    color: #ccc;
    margin-bottom: 20rpx;
}

.rating-stars .star.active{
    color: #FFD700;
}

.rating-count{
    font-size: 28rpx;
    color: #999;
}

.summary-right{
    flex: 2;
    padding-left: 40rpx;
}

.rating-item{
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
    font-size: 28rpx;
}

.rating-label{
    width: 80rpx;
    color: #666;
}

.rating-bar{
    flex: 1;
    height: 8rpx;
    background: #f0f0f0;
    border-radius: 4rpx;
    margin: 0 20rpx;
    overflow: hidden;
}

.rating-bar-fill{
    height: 100%;
    background: #FFD700;
    border-radius: 4rpx;
}

.rating-number{
    width: 60rpx;
    text-align: right;
    color: #999;
}

/* 评价提交表单 */
.review-form{
    padding: 40rpx 0;
    border-bottom: 1rpx solid #ededed;
}

.form-title{
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 40rpx;
}

.rating-input{
    display: flex;
    align-items: center;
    margin-bottom: 40rpx;
}

.rating-label{
    font-size: 32rpx;
    color: #666;
    margin-right: 20rpx;
}

.rating-input .star{
    font-size: 40rpx;
    color: #ccc;
    margin-right: 10rpx;
}

.rating-input .star.active{
    color: #FFD700;
}

.comment-input textarea{
    width: 100%;
    min-height: 120rpx;
    padding: 20rpx;
    border: 1rpx solid #e0e0e0;
    border-radius: 10rpx;
    font-size: 30rpx;
    line-height: 1.5;
    box-sizing: border-box;
}

.submit-btn{
    width: 100%;
    height: 80rpx;
    margin-top: 40rpx;
    background: #AB956D;
    color: #fff;
    border: none;
    border-radius: 40rpx;
    font-size: 32rpx;
}

.submit-btn[disabled]{
    background: #ccc;
}

/* 评价列表 */
.reviews-list{
    padding: 40rpx 0;
}

.list-title{
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 40rpx;
}

.review-item{
    margin-bottom: 40rpx;
    padding-bottom: 40rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.review-item:last-child{
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
}

.review-header{
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
}

.user-avatar{
    width: 60rpx;
    height: 60rpx;
    border-radius: 50%;
    background: #AB956D;
    color: #fff;
    font-size: 30rpx;
    line-height: 60rpx;
    text-align: center;
    margin-right: 20rpx;
}

.user-info{
    flex: 1;
}

.user-name{
    font-size: 30rpx;
    color: #333;
    margin-bottom: 10rpx;
}

.review-date{
    font-size: 26rpx;
    color: #999;
}

.review-content{
    font-size: 30rpx;
    color: #666;
    line-height: 1.5;
}

/* 查看全部按钮 */
.view-all-btn{
    text-align: center;
    margin-top: 40rpx;
    padding: 20rpx;
    background: #f8f8f8;
    border-radius: 10rpx;
}

.view-all-btn text{
    font-size: 30rpx;
    color: #AB956D;
}

/* 暂无评价 */
.no-reviews{
    padding: 80rpx 0;
    text-align: center;
    color: #999;
    font-size: 30rpx;
}