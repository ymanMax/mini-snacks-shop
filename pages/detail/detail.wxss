.detail-page { padding-bottom: 20rpx; }

/* 媒体区 */
.media { position: relative; background: #fff; }
.media-swiper { width: 100%; height: 750rpx; }
.media-item { width: 100%; height: 750rpx; }
.media-img { width: 100%; height: 750rpx; }
.media-video { width: 100%; height: 750rpx; }
.media-tabs {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 999rpx;
  padding: 4rpx;
}
.mt-item {
  padding: 8rpx 26rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  border-radius: 999rpx;
}
.mt-item.on { background: #fff; color: #333; font-weight: 600; }
.media-index {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
}

/* 价格区 */
.price-card { background: #fff; padding: 24rpx; }
.price-line { display: flex; align-items: center; }
.price-line .int { font-size: 52rpx; }
.price-line .price.big { font-size: 52rpx; }
.price-orig.lg { font-size: 26rpx; margin-left: 16rpx; }
.member-tag {
  margin-left: 20rpx;
  font-size: 20rpx;
  color: #c79441;
  border: 1rpx solid #c79441;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.sold-tag {
  margin-left: auto;
  background: #f2f3f5;
  color: #969799;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.goods-name { font-size: 34rpx; font-weight: 700; margin-top: 16rpx; line-height: 1.4; }
.goods-sub { color: #969799; font-size: 22rpx; margin-top: 12rpx; }
.goods-sub .dot { margin: 0 10rpx; }
.goods-tags { margin-top: 16rpx; }

/* 服务 */
.service-card .service-row { display: flex; font-size: 26rpx; padding: 10rpx 0; }
.s-label { color: #969799; width: 90rpx; flex-shrink: 0; }
.s-val { color: #333; flex: 1; }

/* 详情促销卡 */
.pd-ladders { display: flex; flex-wrap: wrap; }
.pd-ladder {
  font-size: 22rpx;
  color: #b4282d;
  background: #fdecec;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
  margin: 0 14rpx 10rpx 0;
}
.pd-coupons { flex: 1; display: flex; flex-wrap: wrap; }
.pd-coupon {
  position: relative;
  width: 168rpx;
  border: 1rpx dashed #f1b4b6;
  border-radius: 12rpx;
  padding: 14rpx 10rpx;
  margin: 0 14rpx 10rpx 0;
  text-align: center;
}
.pdc-value { display: block; color: #b4282d; font-weight: 700; font-size: 30rpx; }
.pdc-rule { display: block; font-size: 18rpx; color: #969799; margin-top: 4rpx; }
.pdc-get, .pdc-owned {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}
.pdc-get { background: #b4282d; color: #fff; }
.pdc-owned { background: #f2f3f5; color: #969799; }
.pd-more { font-size: 24rpx; color: #969799; align-self: center; }

/* 拼团 */
.group-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.gh-title { font-size: 30rpx; font-weight: 700; }
.gh-rule { font-size: 20rpx; color: #b4282d; }
.group-row {
  display: flex;
  align-items: center;
  background: #fff7f5;
  border-radius: 12rpx;
  padding: 18rpx;
  margin: 14rpx 0;
}
.gr-avatar { width: 60rpx; height: 60rpx; border-radius: 50%; margin-right: 14rpx; }
.gr-info { flex: 1; min-width: 0; }
.gr-leader { font-size: 24rpx; }
.gr-count { font-size: 20rpx; color: #969799; margin-top: 4rpx; }
.gr-price { color: #b4282d; font-weight: 700; font-size: 30rpx; margin-right: 16rpx; }
.gr-btn {
  background: linear-gradient(90deg, #ff7043, #e6432d);
  color: #fff;
  font-size: 22rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
}
.group-open {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #f1b4b6;
}
.go-price { color: #b4282d; font-size: 38rpx; font-weight: 800; }
.go-tip { font-size: 20rpx; color: #969799; margin-top: 4rpx; }
.go-btn {
  background: linear-gradient(90deg, #ff7043, #e6432d);
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
}

/* 批发 */
.ws-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18rpx; }
.ws-title { font-size: 30rpx; font-weight: 700; }
.ws-current { font-size: 22rpx; color: #b4282d; background: #fdecec; padding: 4rpx 16rpx; border-radius: 999rpx; }
.ws-ladders { display: flex; }
.ws-ladder {
  flex: 1;
  text-align: center;
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 16rpx 0;
  margin-right: 14rpx;
  border: 2rpx solid transparent;
}
.ws-ladder:last-child { margin-right: 0; }
.ws-ladder.reached { background: #fdecec; border-color: #b4282d; }
.wl-count { font-size: 22rpx; color: #666; }
.wl-discount { font-size: 26rpx; font-weight: 700; color: #b4282d; margin-top: 6rpx; }
.ws-buy { display: flex; align-items: center; margin-top: 22rpx; }
.ws-total { flex: 1; padding: 0 20rpx; }
.ws-unit { display: block; color: #b4282d; font-weight: 700; font-size: 26rpx; }
.ws-sum { display: block; font-size: 20rpx; color: #969799; margin-top: 4rpx; }
.ws-btn {
  background: linear-gradient(90deg, #ffb03a, #ff8f1f);
  color: #fff;
  font-size: 24rpx;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
}

.sku-entry {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 26rpx 24rpx;
}
.sku-entry .s-label { width: 90rpx; }
.sku-entry .s-val { flex: 1; margin-right: 16rpx; }

/* 详情 */
.detail-body .detail-desc { font-size: 28rpx; color: #444; line-height: 1.7; margin-bottom: 20rpx; }
.detail-video-tip {
  background: #fff3e0;
  color: #a8741a;
  font-size: 24rpx;
  padding: 14rpx 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}
.detail-img { width: 100%; border-radius: 12rpx; margin-bottom: 16rpx; display: block; }

/* 评价 */
.rv-summary { display: flex; align-items: center; }
.rv-score { font-size: 64rpx; color: #b4282d; font-weight: 700; margin-right: 24rpx; }
.rv-stars { color: #ff9900; font-size: 28rpx; letter-spacing: 4rpx; }
.rv-stars.small { font-size: 24rpx; }
.rv-rate { color: #969799; font-size: 22rpx; margin-top: 8rpx; }
.rv-tags { margin-top: 16rpx; }
.rv-list .rv-item { padding: 24rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.rv-list .rv-item:last-child { border-bottom: none; }
.rv-head { display: flex; align-items: center; }
.rv-avatar { width: 60rpx; height: 60rpx; border-radius: 50%; margin-right: 16rpx; }
.rv-name { flex: 1; font-size: 26rpx; color: #333; }
.rv-content { font-size: 27rpx; color: #333; line-height: 1.6; margin-top: 14rpx; }
.rv-imgs { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.rv-img { width: 150rpx; height: 150rpx; border-radius: 10rpx; margin: 0 14rpx 14rpx 0; }
.rv-date { font-size: 22rpx; color: #b0b3ba; margin-top: 6rpx; }
.rv-reply {
  margin-top: 14rpx;
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 16rpx;
  font-size: 24rpx;
  color: #666;
}

/* 推荐 */
.reco-scroll { white-space: nowrap; padding: 0 24rpx; }
.reco-item {
  display: inline-block;
  width: 220rpx;
  margin-right: 18rpx;
  vertical-align: top;
  white-space: normal;
  background: #fff;
  border-radius: 14rpx;
  overflow: hidden;
}
.reco-item navigator { padding: 12rpx; display: block; }
.reco-img { width: 100%; height: 196rpx; border-radius: 10rpx; }
.reco-name { font-size: 24rpx; height: 66rpx; margin: 10rpx 0; line-height: 1.35; }
.reco-item .int { font-size: 34rpx; }

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding: 0 20rpx env(safe-area-inset-bottom);
  background: #fff;
  display: flex;
  align-items: center;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
  z-index: 60;
}
.ab-icon {
  position: relative;
  width: 100rpx;
  text-align: center;
  font-size: 20rpx;
  color: #666;
}
.ab-emoji { display: block; font-size: 40rpx; line-height: 48rpx; }
.ab-emoji.collected { }
.ab-label { font-size: 20rpx; }
.ab-icon .badge-dot { top: -4rpx; right: 10rpx; }
.ab-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}
.ab-btn.add { background: linear-gradient(90deg, #ffb03a, #ff8f1f); border-radius: 999rpx 0 0 999rpx; }
.ab-btn.buy { background: linear-gradient(90deg, #d8443a, #b4282d); border-radius: 0 999rpx 999rpx 0; margin-left: 2rpx; }
.ab-btn.disabled { background: #c8c9cc; border-radius: 999rpx; margin-left: 20rpx; }

/* SKU 弹层 */
.sku-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 82vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: sheetUp 0.25s ease;
}
@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.sku-head { display: flex; padding: 30rpx 24rpx 20rpx; position: relative; }
.sku-pic {
  width: 180rpx;
  height: 180rpx;
  border-radius: 14rpx;
  margin-top: -50rpx;
  background: #fff;
  border: 6rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}
.sku-head-info { flex: 1; margin-left: 20rpx; padding-top: 30rpx; }
.sku-head-info .int { font-size: 44rpx; }
.sku-head-info .price.big { font-size: 44rpx; }
.sku-stock { font-size: 24rpx; color: #969799; margin-top: 10rpx; }
.sku-selected { font-size: 24rpx; color: #333; margin-top: 10rpx; }
.sku-close { position: absolute; right: 24rpx; top: 24rpx; color: #969799; font-size: 36rpx; padding: 10rpx; }
.sku-body { flex: 1; padding: 0 24rpx; max-height: 50vh; }
.sku-group { padding: 16rpx 0 6rpx; }
.sku-group-name { font-size: 28rpx; font-weight: 600; margin-bottom: 18rpx; }
.sku-values { display: flex; flex-wrap: wrap; }
.sku-value {
  padding: 14rpx 28rpx;
  background: #f5f6f7;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #333;
  margin: 0 20rpx 20rpx 0;
  border: 2rpx solid transparent;
}
.sku-value.on { background: #fdecec; color: #b4282d; border-color: #b4282d; font-weight: 600; }
.sku-value.zero { color: #c0c4cc; text-decoration: line-through; }
.sku-count {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1rpx solid #f5f5f5;
}
.sku-footer { padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); }
