/**
 * 商品详情页样式
 * 规范：主题色 #b4282d；页面背景 #f5f6f7；卡片白底圆角 16rpx；间距 24rpx
 */

page {
  background: #f5f6f7;
}

.detail-page {
  min-height: 100vh;
  background: #f5f6f7;
}

/* ==================== 1. 顶部媒体区 ==================== */
.media {
  position: relative;
  width: 100%;
  height: 750rpx;
  background: #f2f3f5;
  border-radius: 0 0 24rpx 24rpx;
  overflow: hidden;
}
.media-swiper {
  width: 100%;
  height: 750rpx;
}
.media-img {
  display: block;
  width: 100%;
  height: 750rpx;
  background: #f2f3f5;
}
.media-video {
  display: block;
  width: 100%;
  height: 750rpx;
  background: #000000;
}

/* 图片 / 视频 切换 Tab */
.media-tabs {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 6;
  display: flex;
  padding: 4rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 999rpx;
}
.media-tab {
  padding: 8rpx 26rpx;
  font-size: 24rpx;
  color: #ffffff;
  border-radius: 999rpx;
}
.media-tab-on {
  background: #b4282d;
  font-weight: bold;
}

/* 右上角指示器 当前/总数 */
.media-indicator {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 6;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 999rpx;
}
.media-intro {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  padding: 40rpx 24rpx 16rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.55));
}

/* ==================== 2. 价格信息区 ==================== */
.price-card {
  position: relative;
  z-index: 2;
  margin-top: -24rpx;
  border-radius: 24rpx 24rpx 16rpx 16rpx;
}
.price-line {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}
.price-now {
  display: flex;
  align-items: baseline;
  color: #b4282d;
  font-weight: bold;
}
.price-big {
  font-size: 52rpx;
  line-height: 1;
}
.price-qi {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: normal;
  color: #b4282d;
}
.member-pill {
  margin-left: auto;
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  color: #a9791c;
  background: linear-gradient(90deg, #fff7e2, #ffecc2);
  border: 2rpx solid #f5d489;
  border-radius: 999rpx;
}
.meta-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #838383;
}
.meta-item { margin-right: 24rpx; }
.meta-stock {
  margin-left: auto;
  color: #0ea47a;
}
.meta-stock-out { color: #b2b2b2; }
.tags-line { margin-top: 16rpx; }

/* ==================== 2.5 领券条 ==================== */
.coupon-card {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}
.cc-key {
  flex-shrink: 0;
  margin-right: 20rpx;
  font-size: 26rpx;
  color: #838383;
}
.cc-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}
.cc-list {
  display: inline-flex;
  align-items: center;
}
.cc-pill {
  display: inline-flex;
  align-items: stretch;
  margin-right: 16rpx;
  background: #fdeeef;
  border: 2rpx solid #f3c1c4;
  border-radius: 999rpx;
  overflow: hidden;
}
.cc-pill-name {
  padding: 8rpx 12rpx 8rpx 20rpx;
  font-size: 22rpx;
  font-weight: bold;
  color: #b4282d;
  line-height: 1.4;
}
.cc-pill-btn {
  padding: 8rpx 22rpx;
  font-size: 22rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1.4;
  background: linear-gradient(90deg, #d0342c, #b4282d);
}
.cc-pill-btn-owned {
  background: #ffffff;
  color: #b4282d;
  border-left: 2rpx dashed #f3c1c4;
}
.cc-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 36rpx;
  color: #c8c9cc;
}

/* ==================== 3. 商品名 + 简介 ==================== */
.goods-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  line-height: 1.4;
}
.goods-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #838383;
  line-height: 1.6;
}

/* ==================== 4. 已选规格行 ==================== */
.spec-card {
  display: flex;
  align-items: center;
}
.spec-key {
  flex-shrink: 0;
  margin-right: 20rpx;
  font-size: 26rpx;
  color: #838383;
}
.spec-val {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #333333;
}
.spec-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 36rpx;
  color: #c8c9cc;
}

/* ==================== 6. 图文详情 ==================== */
.detail-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.7;
}
.detail-img {
  display: block;
  width: 100%;
  margin-top: 16rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
}

/* ==================== 7. 评价区块 ==================== */
.rv-summary {
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
}
.rv-score {
  display: flex;
  align-items: center;
}
.rv-score-num {
  margin-right: 16rpx;
  font-size: 52rpx;
  font-weight: bold;
  line-height: 1;
  color: #b4282d;
}
.rv-score-right {
  display: flex;
  flex-direction: column;
}
.rv-hot-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.rv-none {
  padding: 32rpx 0;
  text-align: center;
}
.rv-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f7f8fa;
}
.rv-item:last-child { border-bottom: none; }
.rv-avatar {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #f2f3f5;
}
.rv-body { min-width: 0; }
.rv-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.rv-name {
  max-width: 280rpx;
  font-size: 26rpx;
  color: #333333;
}
.rv-tags { margin: 8rpx 0; }
.rv-content {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.6;
}
.rv-imgs {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}
.rv-img {
  width: 150rpx;
  height: 150rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 8rpx;
  background: #f2f3f5;
}
.rv-time { margin-top: 4rpx; }
.rv-more {
  margin-top: 8rpx;
  padding: 20rpx 0 4rpx;
  border-top: 2rpx solid #f7f8fa;
  text-align: center;
  font-size: 26rpx;
  color: #b4282d;
}

/* ==================== 8. 看了又看 ==================== */
.reco-scroll {
  width: 100%;
  white-space: nowrap;
}
.reco-list {
  display: inline-flex;
  align-items: flex-start;
}
.reco-list goods-card { flex-shrink: 0; }

/* ==================== 9. 底部固定操作栏 ==================== */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.fb-inner {
  display: flex;
  align-items: center;
  height: 100rpx;
  padding: 0 24rpx;
}
.fb-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 92rpx;
}
.fb-heart {
  font-size: 40rpx;
  line-height: 1;
  color: #838383;
}
.fb-heart-on { color: #b4282d; }
.fb-cart-wrap { position: relative; }
.fb-cart {
  font-size: 36rpx;
  line-height: 1;
}
.fb-cart-wrap .badge {
  top: -12rpx;
  right: -20rpx;
}
.fb-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #838383;
}
.fb-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
}
.fb-btn-cart {
  margin-left: 16rpx;
  background: linear-gradient(90deg, #d0342c, #b4282d);
  border-radius: 999rpx 0 0 999rpx;
}
.fb-btn-buy {
  background: linear-gradient(90deg, #9d2226, #7d1a1e);
  border-radius: 0 999rpx 999rpx 0;
}

/* ==================== 5. SKU 半屏弹层 ==================== */
.sku-popup {
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}
.sku-head {
  position: relative;
  display: flex;
  align-items: flex-start;
  padding: 24rpx 24rpx 20rpx;
  border-bottom: 2rpx solid #f7f8fa;
}
.sku-pic {
  flex-shrink: 0;
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
}
.sku-info {
  min-width: 0;
  padding: 8rpx 60rpx 0 20rpx;
}
.sku-price {
  display: flex;
  align-items: baseline;
  margin-bottom: 10rpx;
  color: #b4282d;
  font-weight: bold;
}
.sku-price-num {
  font-size: 44rpx;
  line-height: 1;
}
.sku-info .fs-24 { line-height: 1.8; }
.sku-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #b2b2b2;
}
.sku-body {
  flex: 1;
  min-height: 0;
  max-height: 46vh;
  padding: 0 24rpx;
}
.sku-dim {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f7f8fa;
}
.sku-dim-title {
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #838383;
}
.sku-values {
  display: flex;
  flex-wrap: wrap;
}
.sku-value {
  height: 64rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  color: #333333;
  background: #f5f6f7;
  border: 2rpx solid #f5f6f7;
  border-radius: 8rpx;
}
.sku-value-on {
  background: #fdeeef;
  border-color: #b4282d;
  color: #b4282d;
  font-weight: bold;
}
.sku-count {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 32rpx;
}
.sku-count-label {
  font-size: 26rpx;
  color: #838383;
}
.stepper {
  display: flex;
  align-items: center;
}
.step-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 32rpx;
  color: #333333;
  background: #f5f6f7;
  border-radius: 8rpx;
}
.step-disabled { color: #c8c9cc; }
.step-num {
  min-width: 88rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333333;
}
.sku-foot {
  display: flex;
  padding: 16rpx 24rpx 24rpx;
  border-top: 2rpx solid #f2f3f5;
}
.sku-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
}
.sku-btn-cart {
  background: linear-gradient(90deg, #d0342c, #b4282d);
  border-radius: 999rpx 0 0 999rpx;
}
.sku-btn-buy {
  background: linear-gradient(90deg, #9d2226, #7d1a1e);
  border-radius: 0 999rpx 999rpx 0;
}

/* ==================== 10. 领券半屏弹层 ==================== */
.coupon-popup {
  display: flex;
  flex-direction: column;
  max-height: 70vh;
}
.cp-head {
  position: relative;
  padding: 28rpx 24rpx 20rpx;
  text-align: center;
  border-bottom: 2rpx solid #f7f8fa;
}
.cp-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}
.cp-sub {
  display: block;
  margin-top: 6rpx;
}
.cp-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #b2b2b2;
}
.cp-body {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
  padding: 0 24rpx;
}
.cp-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f7f8fa;
}
.cp-item:last-of-type {
  border-bottom: none;
}
.cp-info {
  flex: 1;
  min-width: 0;
}
.cp-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #b4282d;
}
.cp-scope {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #838383;
}
.cp-expire {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #b2b2b2;
}
.cp-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 32rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #ffffff;
  background: linear-gradient(90deg, #d0342c, #b4282d);
  border-radius: 999rpx;
}
.cp-btn-owned {
  background: #ffffff;
  color: #b4282d;
  border: 2rpx solid #b4282d;
}
