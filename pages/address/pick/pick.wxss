.pick-page { padding-bottom: 140rpx; }
.search-row {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
}
.poi-search {
  flex: 1;
  background: #f5f6f7;
  border-radius: 999rpx;
  height: 68rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}
.locate-btn {
  margin-left: 20rpx;
  color: #b4282d;
  font-size: 26rpx;
  white-space: nowrap;
}
.locate-btn.loading { color: #969799; }

/* 模拟地图 */
.map {
  position: relative;
  height: 560rpx;
  background: linear-gradient(135deg, #e8f3e8, #dcefdc);
  overflow: hidden;
}
.map-grid {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.5) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255,255,255,0.5) 1rpx, transparent 1rpx);
  background-size: 80rpx 80rpx;
}
.map-road {
  position: absolute;
  background: #fff;
}
.map-road.h1 { left: 0; right: 0; top: 32%; height: 28rpx; transform: rotate(-3deg); }
.map-road.h2 { left: 0; right: 0; top: 68%; height: 22rpx; transform: rotate(2deg); }
.map-road.v1 { top: 0; bottom: 0; left: 28%; width: 24rpx; }
.map-road.v2 { top: 0; bottom: 0; left: 66%; width: 20rpx; }
.map-shop {
  position: absolute;
  left: 44%;
  top: 42%;
  background: #fff;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  z-index: 3;
}
.map-range {
  position: absolute;
  left: 50%;
  top: 52%;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(180,40,45,0.4);
  background: rgba(180,40,45,0.05);
  transform: translate(-50%, -50%);
}
.map-poi {
  position: absolute;
  font-size: 34rpx;
  z-index: 4;
  transform: translate(-50%, -50%);
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.2));
}
.map-poi.on { animation: bounce 0.5s; }
.map-poi.off { opacity: 0.5; }
@keyframes bounce {
  50% { transform: translate(-50%, -70%) scale(1.3); }
}
.map-center {
  position: absolute;
  z-index: 5;
  transform: translate(-50%, -50%);
}
.pulse {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #b4282d;
  box-shadow: 0 0 0 8rpx rgba(180,40,45,0.2);
}
.map-tip {
  position: absolute;
  bottom: 16rpx;
  left: 24rpx;
  background: rgba(0,0,0,0.55);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.poi-head {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 30rpx 10rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.poi-count { font-size: 22rpx; color: #969799; font-weight: 400; }
.poi-list { background: #fff; }
.poi-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.poi-item.on { background: #fff9f9; }
.poi-info { flex: 1; }
.poi-name { font-size: 28rpx; font-weight: 600; }
.poi-addr { font-size: 22rpx; color: #969799; margin-top: 8rpx; }
.poi-freight { font-size: 22rpx; color: #b4282d; margin-top: 6rpx; }
.poi-freight.off { color: #969799; }
.poi-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #c8c9cc;
}
.poi-radio.on {
  border-color: #b4282d;
  background: #b4282d;
  box-shadow: inset 0 0 0 8rpx #fff;
}

.pick-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
}
.pick-confirm {
  background: linear-gradient(90deg, #d8443a, #b4282d);
  color: #fff;
  border-radius: 999rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
}
.pick-confirm::after { border: none; }
