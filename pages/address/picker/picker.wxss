.picker-page { padding-bottom: 30rpx; }
.tip {
  margin: 20rpx 24rpx 0;
  background: #fff8e6;
  color: #a8741a;
  font-size: 22rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
}
.addr-list { padding: 20rpx 24rpx; }
.addr-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}
.addr-item.disabled { opacity: 0.7; }
.addr-main { flex: 1; min-width: 0; }
.addr-line1 { display: flex; align-items: center; }
.addr-name { font-size: 30rpx; font-weight: 700; margin-right: 16rpx; }
.addr-phone { color: #666; font-size: 26rpx; margin-right: 12rpx; }
.addr-line2 { font-size: 26rpx; color: #444; margin-top: 12rpx; line-height: 1.5; }
.addr-line3 { display: flex; align-items: center; margin-top: 12rpx; font-size: 22rpx; }
.freight { color: #b4282d; font-weight: 600; }
.freight-free { color: #0ea47a; font-weight: 600; }
.freight-off { color: #969799; }
.distance { color: #b0b3ba; margin-left: 16rpx; }
.addr-arrow { padding-left: 16rpx; font-size: 32rpx; }

.bottom-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  display: flex;
  align-items: center;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
}
.manage { color: #666; font-size: 26rpx; padding: 0 30rpx; }
.add-btn {
  flex: 1;
  background: linear-gradient(90deg, #d8443a, #b4282d);
  color: #fff;
  border-radius: 999rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
}
.add-btn::after { border: none; }
