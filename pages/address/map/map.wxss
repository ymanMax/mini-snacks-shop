/* pages/address/map/map.wxss */
page { background: #eef1f4; }

.mock-map {
  position: relative;
  height: 560rpx;
  background: linear-gradient(135deg, #e8f0e8, #dfe8f0);
  overflow: hidden;
}
.mock-map.locating .center-pin { animation: pulse .8s; }
@keyframes pulse {
  0% { transform: scale(.6); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}
.road {
  position: absolute;
  background: #fff;
}
.r1 { left: 0; right: 0; top: 150rpx; height: 24rpx; transform: rotate(-6deg); }
.r2 { left: 0; right: 0; top: 380rpx; height: 18rpx; transform: rotate(3deg); }
.r3 { top: 0; bottom: 0; left: 200rpx; width: 20rpx; transform: rotate(5deg); }
.r4 { top: 0; bottom: 0; right: 160rpx; width: 14rpx; transform: rotate(-4deg); }
.block {
  position: absolute;
  background: #d8e2d8;
  border-radius: 12rpx;
}
.b1 { left: 60rpx; top: 60rpx; width: 120rpx; height: 80rpx; }
.b2 { right: 240rpx; top: 90rpx; width: 160rpx; height: 100rpx; }
.b3 { left: 300rpx; bottom: 80rpx; width: 140rpx; height: 90rpx; }
.b4 { right: 40rpx; bottom: 120rpx; width: 110rpx; height: 110rpx; }

.shop-pin {
  position: absolute;
  left: 60rpx;
  bottom: 60rpx;
  font-size: 48rpx;
  z-index: 3;
}
.pin-text {
  display: block;
  font-size: 18rpx;
  background: #fff;
  border-radius: 6rpx;
  padding: 0 8rpx;
  text-align: center;
}
.center-pin {
  position: absolute;
  left: 50%;
  top: 44%;
  transform: translate(-50%, -100%);
  z-index: 4;
}
.pin-bounce { font-size: 56rpx; }
.center-pin.picked .pin-bounce { animation: bounce .5s; }
@keyframes bounce {
  0% { transform: translateY(20rpx); }
  100% { transform: translateY(0); }
}
.selected-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, .12);
  z-index: 5;
}
.sc-name { font-weight: 700; font-size: 28rpx; }
.sc-warn { color: #b4282d; font-size: 22rpx; margin-top: 6rpx; }

.map-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 18rpx;
  padding: 14rpx 24rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, .05);
  z-index: 20;
}
.locate-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border: 2rpx solid #b4282d;
  color: #b4282d;
  border-radius: 999rpx;
  font-size: 26rpx;
}
.confirm-btn {
  flex: 2;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: linear-gradient(135deg, #d34046, #b4282d);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.poi-list { padding: 24rpx 24rpx 140rpx; }
.poi-title { font-size: 28rpx; font-weight: 700; margin-bottom: 16rpx; }
.poi-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
  border: 2rpx solid transparent;
}
.poi-item.on { border-color: #b4282d; background: #fff9f9; }
.poi-info { flex: 1; }
.poi-name { font-size: 27rpx; font-weight: 600; }
.poi-right { text-align: right; }
.poi-distance { font-size: 24rpx; color: #666; }
.poi-unsupported { font-size: 18rpx; color: #b4282d; margin-top: 4rpx; }
