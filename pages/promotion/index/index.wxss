/* pages/promotion/index/index.wxss */
page { background: #f5f6f7; }

/* 场次 */
.session-bar {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 20rpx;
}
.session {
  display: inline-block;
  width: 170rpx;
  text-align: center;
  padding: 12rpx 0;
  margin-right: 14rpx;
  border-radius: 14rpx;
  background: #f5f6f7;
  color: #333;
}
.session.on {
  background: linear-gradient(135deg, #d34046, #b4282d);
  color: #fff;
}
.s-name { font-size: 26rpx; font-weight: 700; }
.s-status { font-size: 18rpx; margin-top: 4rpx; color: #999; }
.session.on .s-status { color: rgba(255, 255, 255, .85); }
.session .s-status.status-0 { color: #ff9900; }
.session.on .s-status.status-0 { color: #ffe0a3; }

.seckill-head {
  background: linear-gradient(135deg, #d34046, #b4282d);
  color: #fff;
  padding: 32rpx;
}
.sh-row { display: flex; justify-content: space-between; align-items: center; }
.sh-title { font-size: 36rpx; font-weight: 800; }
.sh-cd { font-size: 22rpx; opacity: .9; }
.sh-time {
  background: #222;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}
.sh-sub { font-size: 22rpx; opacity: .85; margin-top: 10rpx; }

.sk-list {
  margin: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.sk-row {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}
.sk-pic { width: 200rpx; height: 200rpx; border-radius: 12rpx; background: #f5f6f7; }
.sk-info { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.sk-name { font-size: 27rpx; line-height: 1.4; }
.sk-bar-wrap { margin-top: 14rpx; }
.sk-bar {
  position: relative;
  height: 32rpx;
  background: #ffe3e4;
  border-radius: 999rpx;
  overflow: hidden;
}
.sk-bar-inner {
  position: absolute;
  inset: 0 auto 0 0;
  background: linear-gradient(90deg, #ff8a7a, #b4282d);
  border-radius: 999rpx;
}
.sk-bar-text {
  position: relative;
  font-size: 18rpx;
  color: #fff;
  line-height: 32rpx;
  text-align: center;
  display: block;
}
.sk-bottom {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.sk-price { color: #b4282d; font-size: 38rpx; font-weight: 800; }
.sk-origin {
  color: #b0b3b8;
  font-size: 22rpx;
  text-decoration: line-through;
  margin-left: 10rpx;
}
.sk-btn {
  background: linear-gradient(135deg, #ff8a7a, #b4282d);
  color: #fff;
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 10rpx 34rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx;
}
.block-title { font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx; }
.rule-row { display: flex; align-items: center; padding: 14rpx 0; }
.rule-badge {
  background: #fdecec;
  color: #b4282d;
  font-weight: 700;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
}
.rule-text { margin-left: 20rpx; font-size: 26rpx; }
.red { color: #b4282d; font-weight: 700; }

.ws-row { display: flex; padding: 18rpx 0; border-bottom: 1rpx solid #f5f6f7; align-items: center; }
.ws-row:last-child { border-bottom: none; }
.ws-pic { width: 120rpx; height: 120rpx; border-radius: 10rpx; background: #f5f6f7; }
.ws-info { flex: 1; margin-left: 20rpx; min-width: 0; }
.ws-title { font-size: 26rpx; font-weight: 600; margin-bottom: 12rpx; }
.ws-ladders { display: flex; flex-wrap: wrap; gap: 12rpx; }
.ws-chip {
  font-size: 22rpx;
  color: #666;
  background: #f5f6f7;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}
.ws-btn {
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, #d34046, #b4282d);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  margin-left: 12rpx;
}
.pm-tip { text-align: center; padding: 30rpx 0; font-size: 20rpx; }

/* 抢购按钮态 */
.sk-btn.disabled { background: #c9ccd1; }
.sk-btn.soldout { background: #b0b3b8; }
.sk-bar-inner.hot { background: linear-gradient(90deg, #ff6b00, #b4282d); }

/* 批发弹层 */
.ws-sheet { padding: 32rpx; }
.ws-sheet-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 28rpx; }
.ws-ladder-opts { display: flex; gap: 18rpx; }
.ws-ladder-opt {
  flex: 1;
  text-align: center;
  border: 2rpx solid #e5e6e8;
  border-radius: 14rpx;
  padding: 22rpx 0;
}
.ws-ladder-opt.on { border-color: #b4282d; background: #fdecec; }
.wl-count { font-size: 26rpx; font-weight: 700; color: #333; }
.ws-ladder-opt.on .wl-count { color: #b4282d; }
.wl-price { font-size: 22rpx; color: #b4282d; margin-top: 8rpx; }
.ws-summary {
  display: flex;
  justify-content: space-between;
  margin: 28rpx 0;
  font-size: 28rpx;
}
.ws-confirm { margin-top: 8rpx; }
