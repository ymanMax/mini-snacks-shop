/**
 * 限时秒杀场次页样式
 * 规范：主题色 #b4282d；页面背景 #f5f6f7；卡片白底圆角 16rpx；间距 24rpx
 * 抢购进度条 / 倒计时翻牌 / 即将售罄闪烁：纯 CSS 实现，无第三方库
 */

.seckill-page {
  padding-bottom: 40rpx;
}

/* ==================== 1. 场次头卡（深红渐变） ==================== */
.sk-head {
  margin: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #7d1a1e 0%, #b4282d 55%, #d0342c 100%);
  box-shadow: 0 8rpx 24rpx rgba(125, 26, 30, 0.25);
}
.sk-head-top {
  display: flex;
  align-items: flex-start;
}
.sk-head-titles {
  min-width: 0;
}
.sk-title {
  font-size: 36rpx;
  font-weight: bold;
  line-height: 1.3;
}
.sk-subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.85;
}
.sk-remind {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.14);
  border: 2rpx solid rgba(255, 255, 255, 0.65);
  border-radius: 999rpx;
}
.sk-remind:active {
  background: rgba(255, 255, 255, 0.28);
}

/* ---------- 倒计时：黑底白字翻牌风格数字块（纯 CSS） ---------- */
.sk-countdown {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}
.sk-cd-label {
  margin-right: 14rpx;
  font-size: 24rpx;
  opacity: 0.92;
}
.sk-cd-digits {
  display: flex;
  align-items: center;
}
.cd-block {
  position: relative;
  min-width: 44rpx;
  height: 52rpx;
  line-height: 52rpx;
  margin: 0 4rpx;
  padding: 0 6rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
  background: #1a1a1a;
  border-radius: 8rpx;
  overflow: hidden;
}
/* 翻牌中缝线 */
.cd-block::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.22);
}
.cd-colon {
  margin: 0 2rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
}
.sk-ended {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffe3a6;
}

/* 头卡骨架（深红底上的半透明白块） */
.sk-head-skeleton .skeleton-block {
  background: rgba(255, 255, 255, 0.28);
}
.sk-sk-line {
  height: 32rpx;
  margin: 16rpx 0;
  border-radius: 8rpx;
}
.sk-head-skeleton .w40 { width: 40%; }
.sk-head-skeleton .w60 { width: 60%; }

/* ==================== 2. 秒杀商品卡（每行一卡） ==================== */
.sk-goods-card {
  display: flex;
  margin: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}
.sk-goods-pic {
  flex-shrink: 0;
  width: 200rpx;
  height: 200rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
  background: #f5f6f7;
}
.sk-goods-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.sk-goods-name {
  font-size: 28rpx;
  color: #333333;
  line-height: 40rpx;
}
.sk-price-line {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}
.sk-price-num {
  font-size: 44rpx;
  line-height: 1;
}
.sk-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #838383;
}

/* ---------- 抢购进度条（纯 CSS） ---------- */
.sk-progress-wrap {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.sk-progress {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 32rpx;
  background: #fdeeef;
  border-radius: 999rpx;
  overflow: hidden;
}
.sk-progress-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(90deg, #ff6a3d, #e02b2b 60%, #b4282d);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}
.sk-progress-text {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 1;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: bold;
  color: #ffffff;
  /* 白色文字 + 主题色光晕：在浅色轨道与深色填充上均可读 */
  text-shadow: 0 0 6rpx rgba(180, 40, 45, 0.9), 0 0 2rpx rgba(180, 40, 45, 0.9);
}
/* 即将售罄：闪烁动画（纯 CSS） */
.sk-blink {
  animation: sk-blink 0.8s ease-in-out infinite;
}
@keyframes sk-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}
.sk-stock {
  flex-shrink: 0;
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #838383;
}

/* ---------- 抢购按钮 ---------- */
.sk-buy-row {
  display: flex;
  justify-content: flex-end;
  margin-top: auto;
  padding-top: 14rpx;
}
.sk-buy-btn {
  min-width: 176rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: bold;
  color: #ffffff;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #d0342c, #b4282d);
}
.sk-buy-btn:active {
  opacity: 0.85;
}
.sk-buy-off {
  background: #d8d9db;
  color: #ffffff;
  font-weight: normal;
}
.sk-buy-off:active {
  opacity: 1;
}

/* ==================== 3. 满减活动卡 ==================== */
.fr-head {
  display: flex;
  align-items: baseline;
}
.fr-title {
  position: relative;
  flex-shrink: 0;
  padding-left: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}
.fr-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: #b4282d;
}
.fr-sub {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #838383;
}
.fr-rules {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.fr-pill {
  padding: 10rpx 26rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  font-weight: bold;
  color: #b4282d;
  background: linear-gradient(90deg, #fdeeef, #fbdcdf);
  border: 2rpx solid #f3c1c4;
  border-radius: 999rpx;
}
.fr-go {
  height: 72rpx;
  line-height: 72rpx;
  margin-top: 8rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #d0342c, #b4282d);
}
.fr-go:active {
  opacity: 0.85;
}
