.tl-page { padding-bottom: 30rpx; }
.theme-banner {
  position: relative;
  height: 300rpx;
  margin: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.tb-img { width: 100%; height: 300rpx; }
.tb-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(transparent 40%, rgba(0,0,0,0.55));
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 30rpx;
  color: #fff;
}
.tb-name { font-size: 38rpx; font-weight: 700; }
.tb-desc { font-size: 24rpx; opacity: 0.9; margin-top: 8rpx; }
.goods-wrap { padding: 0 24rpx; }
.goods-wrap goods-card { display: block; }
