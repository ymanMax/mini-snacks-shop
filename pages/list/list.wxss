/* pages/list/list.wxss */

.list-page {
  padding-bottom: 40rpx;
}

/* 主题信息条 */
.theme-info {
  display: flex;
  align-items: center;
}
.theme-info-img {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f2f3f5;
  flex-shrink: 0;
}
.theme-info-body {
  justify-content: center;
}
.theme-info-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}
.theme-info-desc {
  font-size: 24rpx;
  color: #838383;
  margin-top: 8rpx;
  line-height: 1.4;
}

/* 商品双列 */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx;
}
.goods-grid > goods-card {
  width: 342rpx;
  margin-bottom: 20rpx;
}
