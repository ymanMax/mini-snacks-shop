/* pages/list/list.wxss */
page { background: #f5f6f7; }

.theme-header {
  position: relative;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  height: 220rpx;
}
.th-img { width: 100%; height: 220rpx; }
.th-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,.1), rgba(0,0,0,.55));
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 24rpx;
}
.th-name { color: #fff; font-size: 36rpx; font-weight: 800; }
.th-desc { color: rgba(255,255,255,.9); font-size: 22rpx; margin-top: 8rpx; }

.goods-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  padding: 0 24rpx;
}

.sk-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  padding: 0 24rpx;
}
.sk-goods { background: #fff; border-radius: 16rpx; padding-bottom: 20rpx; overflow: hidden; }
.sk-goods-img { width: 100%; height: 340rpx; }
.sk-goods .l1 { height: 28rpx; margin: 16rpx 16rpx 0; width: 80%; }
.sk-goods .l2 { height: 28rpx; margin: 12rpx 16rpx 0; width: 50%; }
.sk-line { border-radius: 8rpx; }
