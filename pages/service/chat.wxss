/* pages/service/chat.wxss — 在线客服会话页 */
/* 规范：主题色 #b4282d / 背景 #f5f6f7 / 卡片白底圆角 16rpx / 间距 24rpx */

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6f7;
  overflow: hidden;
}

/* ---------- 顶部客服信息条 ---------- */
.chat-top {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #f0f0f0;
}
.top-cs {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.top-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fdeeef;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.top-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}
.top-sub {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #838383;
}
.online-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #0ea47a;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.rate-entry {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 56rpx;
  font-size: 26rpx;
  color: #b4282d;
  border: 2rpx solid #b4282d;
  border-radius: 999rpx;
  background: #ffffff;
}
.rate-entry-off {
  color: #b2b2b2;
  border-color: #dddddd;
}

/* ---------- 会话流 ---------- */
.chat-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 0;
}
.chat-notice {
  margin: 0 auto 24rpx;
  padding: 8rpx 24rpx;
  width: fit-content;
  max-width: 100%;
  font-size: 20rpx;
  color: #b2b2b2;
  background: #eceef0;
  border-radius: 999rpx;
  text-align: center;
}
.chat-loading {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #b2b2b2;
}
.chat-anchor {
  height: 24rpx;
  width: 100%;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}
.msg-row-me {
  justify-content: flex-end;
}
.msg-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.msg-main-me {
  flex: none;
  max-width: 520rpx;
  align-items: flex-end;
}
.msg-time {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #b2b2b2;
}
.msg-time-me {
  text-align: right;
}

.cs-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fdeeef;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.cs-bubble {
  max-width: 520rpx;
  background: #ffffff;
  border-radius: 4rpx 20rpx 20rpx 20rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #333333;
  line-height: 42rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.bubble-text {
  word-break: break-all;
}
.me-bubble {
  max-width: 520rpx;
  background: linear-gradient(90deg, #d0342c, #b4282d);
  color: #ffffff;
  border-radius: 20rpx 4rpx 20rpx 20rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  line-height: 42rpx;
  word-break: break-all;
}

/* 「对方正在输入...」灰点动画 */
.typing-bubble {
  display: flex;
  align-items: center;
}
.typing-text {
  font-size: 24rpx;
  color: #b2b2b2;
  margin-right: 12rpx;
}
.typing-dots {
  display: flex;
  align-items: center;
}
.tdot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b2b2b2;
  margin-right: 8rpx;
  animation: typing-blink 1.2s infinite ease-in-out both;
}
.tdot-2 { animation-delay: 0.2s; }
.tdot-3 { animation-delay: 0.4s; margin-right: 0; }
@keyframes typing-blink {
  0%, 80%, 100% { opacity: 0.25; transform: translateY(0); }
  40% { opacity: 1; transform: translateY(-6rpx); }
}

/* ---------- 常见问题快捷胶囊 ---------- */
.quick-area {
  margin: 0 0 24rpx 88rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.quick-area-title {
  font-size: 24rpx;
  color: #838383;
  margin-bottom: 12rpx;
}
.quick-area-body {
  display: flex;
  flex-wrap: wrap;
}
.quick-chip {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #b4282d;
  background: #fdeeef;
  border: 2rpx solid #fdeeef;
  border-radius: 999rpx;
  line-height: 1.4;
}
.bubble-quick {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f5f6f7;
  display: flex;
  flex-wrap: wrap;
}
.bubble-quick-title {
  width: 100%;
  font-size: 22rpx;
  color: #b2b2b2;
  margin-bottom: 12rpx;
}

/* ---------- 运营卡片：售后自助 ---------- */
.ops-card {
  max-width: 520rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.ops-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}
.ops-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #838383;
}
.ops-btn {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
}
.ops-btn-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}
.ops-btn-name {
  font-size: 26rpx;
  color: #b4282d;
  font-weight: bold;
}
.ops-btn-tip {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #b2b2b2;
}
.ops-arrow {
  margin-left: 12rpx;
  font-size: 32rpx;
  color: #c8c8c8;
}

/* ---------- 底部固定输入栏 ---------- */
.chat-input-bar {
  flex-shrink: 0;
  background: #ffffff;
  border-top: 2rpx solid #f0f0f0;
  padding: 16rpx 24rpx 8rpx;
}
.input-row {
  display: flex;
  align-items: center;
}
.input-wrap {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  background: #f5f6f7;
  border-radius: 999rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
}
.chat-input {
  width: 100%;
  height: 72rpx;
  font-size: 28rpx;
  color: #333333;
}
.input-ph {
  color: #b2b2b2;
  font-size: 26rpx;
}
.send-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #d0342c, #b4282d);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}
.send-btn-off {
  opacity: 0.5;
}

/* ---------- 客服评价弹层 ---------- */
.rate-mask {
  z-index: 110;
}
.rate-popup {
  z-index: 111;
  padding: 0 32rpx;
}
.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}
.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}
.popup-close {
  font-size: 32rpx;
  color: #999999;
  padding: 0 8rpx;
}
.rate-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0 8rpx;
}
.rate-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666666;
  flex-shrink: 0;
}
.rate-score {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #b4282d;
}
.rate-input-wrap {
  margin: 20rpx 0 8rpx;
  padding: 0 24rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  background: #fafafa;
  border-radius: 12rpx;
}
.rate-input {
  width: 100%;
  height: 80rpx;
  font-size: 26rpx;
  color: #333333;
}
.rate-submit {
  margin: 24rpx 0 8rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
}
