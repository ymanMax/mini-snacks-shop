/* pages/service/chat/chat.wxss */
page { background: #f5f6f7; }
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}
.chat-scroll {
  flex: 1;
  min-height: 0;
  padding: 24rpx;
}
.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}
.msg-row.me { justify-content: flex-end; }
.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.msg-row.bot .msg-avatar { margin-right: 16rpx; }
.msg-row.me .msg-avatar { margin-left: 16rpx; }
.bubble {
  max-width: 480rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
  line-height: 1.55;
}
.bubble.bot {
  background: #fff;
  color: #333;
  border-top-left-radius: 4rpx;
}
.bubble.me {
  background: linear-gradient(135deg, #d34046, #b4282d);
  color: #fff;
  border-top-right-radius: 4rpx;
}
.bubble.typing { display: flex; align-items: center; gap: 8rpx; }
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c9ccd1;
  animation: blink 1.2s infinite;
}
.dot.d2 { animation-delay: .2s; }
.dot.d3 { animation-delay: .4s; }
@keyframes blink {
  0%, 100% { opacity: .3; }
  50% { opacity: 1; }
}

/* FAQ */
.faq-bar {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 20rpx;
  border-top: 1rpx solid #f0f1f2;
}
.faq-item {
  display: inline-block;
  font-size: 23rpx;
  color: #555;
  background: #f5f6f7;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  margin-right: 14rpx;
}

/* 输入 */
.input-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #fff;
  padding: 14rpx 20rpx;
  border-top: 1rpx solid #f0f1f2;
}
.solved-btn {
  font-size: 22rpx;
  color: #b4282d;
  border: 2rpx solid #b4282d;
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  white-space: nowrap;
}
.chat-input {
  flex: 1;
  height: 72rpx;
  background: #f5f6f7;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}
.send-btn {
  background: linear-gradient(135deg, #d34046, #b4282d);
  color: #fff;
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
}

/* 评价 */
.rate-sheet { padding: 36rpx 32rpx 50rpx; }
.rate-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 30rpx; }
.rate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.rate-label { font-size: 27rpx; color: #555; }
.stars { display: flex; }
.star { font-size: 52rpx; color: #e0e1e3; margin-left: 14rpx; }
.star.on { color: #ff9900; }
.rate-input {
  width: 100%;
  height: 150rpx;
  background: #f7f8f9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}
.rate-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.rate-btn { flex: 1; }
.rate-btn.primary { flex: 2; }
