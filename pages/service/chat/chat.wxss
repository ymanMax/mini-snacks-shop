.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6f7;
}
.chat-tip {
  text-align: center;
  font-size: 20rpx;
  color: #b0b3ba;
  padding: 16rpx 0 8rpx;
}
.chat-body { flex: 1; padding: 10rpx 24rpx; }
.msg-row {
  display: flex;
  align-items: flex-start;
  margin: 22rpx 0;
}
.msg-row.me { flex-direction: row-reverse; }
.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.msg-avatar.shop { margin-right: 16rpx; border-radius: 16rpx; }
.msg-avatar.me { margin-left: 16rpx; }
.msg-bubble {
  max-width: 500rpx;
  background: #fff;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  line-height: 1.55;
  word-break: break-all;
}
.msg-row.me .msg-bubble { background: #b4282d; color: #fff; }
.msg-bubble.typing { color: #b0b3ba; letter-spacing: 4rpx; }

.quick-bar { white-space: nowrap; padding: 12rpx 24rpx; }
.quick-chip {
  display: inline-block;
  background: #fff;
  color: #555;
  font-size: 23rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  margin-right: 14rpx;
  border: 1rpx solid #eee;
}
.tool-bar {
  display: flex;
  background: #fff;
  padding: 8rpx 24rpx;
}
.tool-item {
  font-size: 24rpx;
  color: #666;
  padding: 12rpx 28rpx;
  border: 1rpx solid #eee;
  border-radius: 999rpx;
  margin-right: 16rpx;
}
.tool-item.done { color: #0ea47a; border-color: #b8e5d5; }

.input-bar {
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  background: #fff;
}
.chat-input {
  flex: 1;
  height: 72rpx;
  background: #f5f6f7;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 27rpx;
}
.send-btn {
  margin-left: 18rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: #dcdee0;
  color: #fff;
  font-size: 27rpx;
}
.send-btn.on { background: #b4282d; }

/* 评价弹层 */
.rate-sheet {
  width: 620rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx;
}
.rate-title { font-size: 34rpx; font-weight: 700; text-align: center; margin-bottom: 20rpx; }
.rate-row { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0; }
.rate-label { font-size: 28rpx; color: #555; }
.rate-stars .star { font-size: 48rpx; color: #dcdee0; margin-left: 14rpx; }
.rate-stars .star.on { color: #ff9900; }
.rate-actions { display: flex; margin-top: 20rpx; }
.rate-actions .btn { flex: 1; }
