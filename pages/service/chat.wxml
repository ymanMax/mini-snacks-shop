<view class="page">
  <!-- 右上角评价入口 -->
  <view class="rate-entry" bindtap="openRate">⭐ 评价</view>

  <!-- 骨架屏 -->
  <view class="chat-loading" wx:if="{{loading}}">
    <view class="skeleton" style="height:100rpx;width:70%;border-radius:16rpx;"></view>
    <view class="skeleton" style="height:100rpx;width:60%;border-radius:16rpx;margin-top:24rpx;margin-left:auto;"></view>
  </view>

  <!-- 会话区 -->
  <scroll-view wx:else scroll-y class="chat-scroll" scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view class="chat-item {{item.role === 'user' ? 'right' : 'left'}}"
      wx:for="{{chats}}" wx:key="index" id="chat-{{index}}">
      <view class="cs-avatar" wx:if="{{item.role !== 'user'}}">🍟</view>
      <view class="bubble">{{item.text}}</view>
    </view>

    <!-- 对方正在输入... -->
    <view class="chat-item left" wx:if="{{answering}}" id="typing">
      <view class="cs-avatar">🍟</view>
      <view class="bubble typing">对方正在输入...</view>
    </view>

    <!-- 客服评价卡片 -->
    <view class="rate-card" wx:if="{{showRate}}" id="rate-card">
      <block wx:if="{{!rated}}">
        <view class="rate-title">请为本次服务评价</view>
        <view class="rate-row">
          <text class="rate-label">响应速度</text>
          <view class="stars">
            <text class="star {{speed >= item ? 'on' : ''}}" wx:for="{{[1, 2, 3, 4, 5]}}" wx:key="*this"
              data-v="{{item}}" bindtap="setSpeed">★</text>
          </view>
        </view>
        <view class="rate-row">
          <text class="rate-label">满意度</text>
          <view class="stars">
            <text class="star {{satisfaction >= item ? 'on' : ''}}" wx:for="{{[1, 2, 3, 4, 5]}}" wx:key="*this"
              data-v="{{item}}" bindtap="setSatisfaction">★</text>
          </view>
        </view>
        <view class="btn-primary rate-btn {{submittingRate ? 'disabled' : ''}}" bindtap="submitRate">提交评价</view>
      </block>
      <block wx:else>
        <view class="rate-done-icon">✅</view>
        <view class="rate-title">已完成评价，感谢您的反馈</view>
        <view class="rate-done-sub">评价奖励 +5 积分已到账</view>
      </block>
    </view>
  </scroll-view>

  <!-- 常见问题快捷 chips（横滑） -->
  <scroll-view scroll-x class="faq-bar" enhanced show-scrollbar="{{false}}" wx:if="{{faqs.length}}">
    <view class="faq-chip" wx:for="{{faqs}}" wx:key="q" data-index="{{index}}" bindtap="tapFaq">{{item.q}}</view>
  </scroll-view>

  <!-- 输入栏 -->
  <view class="input-bar">
    <input class="chat-input" placeholder="请输入您的问题..." confirm-type="send"
      value="{{inputValue}}" bindinput="onInput" bindconfirm="onSend" />
    <view class="send-btn {{inputValue ? '' : 'off'}}" bindtap="onSend">发送</view>
  </view>
</view>
