<!--pages/service/ticket-detail/ticket-detail.wxml-->
<wxs src="../../../utils/format.wxs" module="fmt" />
<view class="page td-page" wx:if="{{ticket}}">
  <view class="status-head status-{{ticket.status}}">
    <view class="sh-status">{{ticket.statusText}}</view>
    <view class="sh-desc">
      <block wx:if="{{ticket.status === 1}}">客服将在 30 分钟内受理，请保持电话畅通</block>
      <block wx:elif="{{ticket.status === 2}}">商家正在核实处理，请耐心等待</block>
      <block wx:elif="{{ticket.status === 3}}">售后处理已完成，感谢您的理解</block>
      <block wx:else>售后申请已撤回</block>
    </view>
    <view wx:if="{{ticket.status === 1 || ticket.status === 2}}" class="sh-advance" bindtap="advance">
      ⏩ 模拟处理进度（演示）
    </view>
  </view>

  <view class="card">
    <view class="info-row"><text class="sub">售后类型</text><text>{{ticket.typeText}}</text></view>
    <view class="info-row"><text class="sub">关联订单</text><text>{{ticket.orderNo}}</text></view>
    <view class="info-row"><text class="sub">申请原因</text><text>{{ticket.reason}}</text></view>
    <view wx:if="{{ticket.refundStatus}}" class="info-row"><text class="sub">退款信息</text><text class="green">{{ticket.refundStatus}}</text></view>
  </view>

  <view class="card">
    <view class="block-title">售后商品</view>
    <view wx:for="{{ticket.items}}" wx:key="goodsId" class="ti-item">
      <safe-image class="ti-pic" img-class="ti-pic" src="{{item.pic}}" mode="aspectFill" />
      <view class="ti-info">
        <view class="ellipsis-2">{{item.name}}</view>
        <view class="sub">{{item.specText}}</view>
      </view>
      <view class="ti-price">¥{{fmt.fixed(item.price)}} ×{{item.count}}</view>
    </view>
    <view class="amount-row">
      <text>退款金额</text>
      <text class="amount">¥{{fmt.fixed(ticket.amount)}}</text>
    </view>
  </view>

  <view class="card">
    <view class="block-title">处理进度</view>
    <view class="timeline">
      <view wx:for="{{ticket.timeline}}" wx:key="status" class="tl-item">
        <view class="tl-dot {{index === ticket.timeline.length - 1 ? 'last' : ''}}"></view>
        <view wx:if="{{index < ticket.timeline.length - 1}}" class="tl-line"></view>
        <view class="tl-body">
          <view class="tl-status">{{item.status}}</view>
          <view wx:if="{{item.remark}}" class="sub">{{item.remark}}</view>
          <view class="light tl-time">{{item.time}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 客服评价 -->
  <view wx:if="{{ticket.status === 3 && ticket.rate}}" class="card">
    <view class="block-title">我的客服评价</view>
    <view class="rate-view">
      <text>响应速度 {{ticket.rate.speed}} 星 · 问题解决 {{ticket.rate.solve}} 星</text>
      <view wx:if="{{ticket.rate.content}}" class="sub">{{ticket.rate.content}}</view>
    </view>
  </view>

  <view style="height:140rpx"></view>

  <view class="action-bar">
    <view class="ab-btn plain" bindtap="contact">联系客服</view>
    <block wx:if="{{ticket.status === 1}}">
      <view class="ab-btn plain" bindtap="cancel">撤回申请</view>
      <view class="ab-btn primary" bindtap="advance">催办处理</view>
    </block>
    <block wx:elif="{{ticket.status === 2}}">
      <view class="ab-btn primary" bindtap="advance">查看最新进度</view>
    </block>
    <block wx:elif="{{ticket.status === 3 && !ticket.rate}}">
      <view class="ab-btn primary" bindtap="openRate">评价客服</view>
    </block>
  </view>

  <!-- 评价弹层 -->
  <view wx:if="{{showRate}}" class="mask" bindtap="noop"></view>
  <view wx:if="{{showRate}}" class="sheet rate-sheet" catchtap="noop">
    <view class="rate-title">客服评价</view>
    <view class="rate-row">
      <text class="rate-label">响应速度</text>
      <view class="stars">
        <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
          class="star {{item <= speed ? 'on' : ''}}" data-score="{{item}}" bindtap="setSpeed">★</text>
      </view>
    </view>
    <view class="rate-row">
      <text class="rate-label">解决问题</text>
      <view class="stars">
        <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
          class="star {{item <= solve ? 'on' : ''}}" data-score="{{item}}" bindtap="setSolve">★</text>
      </view>
    </view>
    <textarea class="rate-input" placeholder="说说客服服务感受（选填）" value="{{content}}" bindinput="onContent" maxlength="200" />
    <view class="btn-primary rate-submit" bindtap="submitRate">提交评价 · 得 5 积分</view>
  </view>
</view>
