/* pages/service/aftersale.wxss */
.page { padding-bottom: 40rpx; }

.ticket-card { padding-bottom: 20rpx; }

/* 头部 */
.tk-head { display: flex; justify-content: space-between; align-items: center; }
.tk-order { color: #838383; font-size: 24rpx; flex: 1; min-width: 0; margin-right: 20rpx; }
.tk-badge { font-size: 22rpx; border-radius: 999rpx; padding: 4rpx 18rpx; line-height: 1.6; flex-shrink: 0; }
.tk-badge.as-orange { background: #fdf3e6; color: #fa8c16; }
.tk-badge.as-blue { background: #e8f1fd; color: #2f6fed; }
.tk-badge.as-green { background: #e9f7ef; color: #1a9f5c; }
.tk-badge.as-red { background: #fbeaea; color: #b4282d; }
.tk-badge.as-gray { background: #f2f3f5; color: #999; }

/* 商品摘要 */
.tk-body { display: flex; margin-top: 20rpx; }
.tk-pic { width: 140rpx; height: 140rpx; border-radius: 12rpx; background: #f2f3f5; flex-shrink: 0; }
.tk-info { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.tk-line1 { display: flex; align-items: center; }
.tk-type { font-size: 28rpx; font-weight: bold; margin-right: 16rpx; }
.tk-reason { color: #838383; font-size: 24rpx; }
.tk-goods { color: #666; font-size: 24rpx; margin-top: 8rpx; line-height: 1.4; }
.tk-amount-row { display: flex; align-items: baseline; margin-top: auto; }
.tk-amount-label { color: #838383; font-size: 22rpx; margin-right: 8rpx; }

.tk-time { color: #b0b0b0; font-size: 22rpx; margin-top: 16rpx; }

/* 进度时间线 */
.tk-timeline-toggle {
  color: #b4282d; font-size: 24rpx; text-align: center;
  border-top: 2rpx solid #f5f5f5; margin-top: 20rpx; padding-top: 20rpx;
}
.tk-timeline { margin-top: 20rpx; }
.tl-item { display: flex; }
.tl-dot-wrap { width: 40rpx; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.tl-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #d0d0d0; margin-top: 10rpx; }
.tl-item.latest .tl-dot { background: #b4282d; box-shadow: 0 0 0 6rpx #fbeaea; }
.tl-line { flex: 1; width: 2rpx; background: #eee; margin-top: 4rpx; }
.tl-body { flex: 1; padding: 0 0 28rpx 20rpx; }
.tl-status { font-size: 26rpx; color: #333; font-weight: bold; }
.tl-item.latest .tl-status { color: #b4282d; }
.tl-remark { color: #838383; font-size: 24rpx; margin-top: 6rpx; }
.tl-time { color: #b0b0b0; font-size: 22rpx; margin-top: 6rpx; }

/* 操作区 */
.tk-ops {
  display: flex; justify-content: flex-end;
  border-top: 2rpx solid #f5f5f5; margin-top: 4rpx; padding-top: 20rpx;
}
.tk-btn { font-size: 24rpx; padding: 8rpx 28rpx; margin-left: 20rpx; }
.tk-btn.gray { border-color: #d0d0d0; color: #666; }

.load-more { text-align: center; color: #b0b0b0; font-size: 24rpx; padding: 32rpx 0; }
