<wxs src="../../utils/format.wxs" module="f" />

<view class="page">
  <!-- 骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="card"><view class="skeleton" style="height:160rpx"></view></view>
    <view class="card"><view class="skeleton" style="height:220rpx"></view></view>
  </block>

  <block wx:elif="{{order}}">
    <!-- 订单摘要卡 -->
    <view class="card order-summary">
      <image class="sum-pic" mode="aspectFill"
        src="{{imgErr ? '/static/images/default.png' : (firstItem ? firstItem.pic : '/static/images/default.png')}}"
        binderror="onImgError" />
      <view class="sum-info">
        <view class="sum-name ellipsis-2">{{firstItem ? firstItem.name : ''}}<text wx:if="{{order.items.length > 1}}"> 等{{order.items.length}}件商品</text></view>
        <view class="sum-no ellipsis">订单号：{{order.orderNo}}</view>
        <view class="sum-amount">
          <text class="sum-label">实付</text>
          <text class="price"><text class="symbol">￥</text>{{f.fp(order.payAmount)}}</text>
        </view>
      </view>
    </view>

    <!-- 售后类型 -->
    <view class="card">
      <view class="card-title">售后类型</view>
      <view class="type-row">
        <view class="type-card {{type === item.value ? 'on' : ''}}" wx:for="{{types}}" wx:key="value"
          data-v="{{item.value}}" bindtap="chooseType">
          <view class="type-icon">{{item.icon}}</view>
          <view class="type-label">{{item.label}}</view>
          <view class="type-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <!-- 申请原因 -->
    <view class="card">
      <view class="card-title">申请原因</view>
      <view class="reason-row">
        <view class="reason-cap {{reason === item ? 'on' : ''}}" wx:for="{{reasons}}" wx:key="*this"
          data-r="{{item}}" bindtap="chooseReason">{{item}}</view>
      </view>
    </view>

    <!-- 问题描述 + 凭证 -->
    <view class="card">
      <view class="card-title">问题描述</view>
      <textarea class="desc-input" placeholder="请描述您遇到的问题（选填）" maxlength="200"
        value="{{description}}" bindinput="onDesc" />
      <view class="img-grid">
        <view class="img-cell" wx:for="{{images}}" wx:key="index">
          <image class="img-thumb" mode="aspectFill" src="{{item}}" data-index="{{index}}"
            bindtap="previewImage" binderror="onImgError" />
          <view class="img-del" catchtap="delImage" data-index="{{index}}">×</view>
        </view>
        <view class="img-cell img-add" wx:if="{{images.length < 3}}" bindtap="chooseImage">
          <view class="img-add-icon">📷</view>
          <view class="img-add-text">上传凭证</view>
          <view class="img-add-text">{{images.length}}/3</view>
        </view>
      </view>
    </view>

    <!-- 退款金额 -->
    <view class="card amount-card">
      <text class="amount-label">{{type === 3 ? '换货说明' : '退款金额'}}</text>
      <text class="price amount-value" wx:if="{{type === 3}}">免费换新</text>
      <text class="price amount-value" wx:else><text class="symbol">￥</text>{{f.fp(order.payAmount)}}</text>
    </view>

    <view class="demo-tip">演示环境，不产生真实交易</view>
    <view class="bottom-safe"></view>

    <view class="bottom-bar">
      <view class="btn-primary submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">提交申请</view>
    </view>
  </block>
</view>
