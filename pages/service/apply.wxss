/* pages/service/apply.wxss */
.page { padding-bottom: 40rpx; }
.card-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; }

/* 订单摘要 */
.order-summary { display: flex; }
.sum-pic { width: 140rpx; height: 140rpx; border-radius: 12rpx; background: #f2f3f5; flex-shrink: 0; }
.sum-info { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.sum-name { font-size: 28rpx; line-height: 1.4; }
.sum-no { color: #b0b0b0; font-size: 22rpx; margin-top: 8rpx; }
.sum-amount { display: flex; align-items: baseline; margin-top: auto; }
.sum-label { color: #666; font-size: 24rpx; margin-right: 8rpx; }

/* 售后类型 */
.type-row { display: flex; }
.type-card {
  flex: 1; text-align: center;
  border: 2rpx solid #e8e8e8; border-radius: 16rpx;
  padding: 24rpx 12rpx; margin-right: 16rpx;
}
.type-card:last-child { margin-right: 0; }
.type-card.on { border-color: #b4282d; background: #fbeaea; }
.type-icon { font-size: 44rpx; }
.type-label { font-size: 28rpx; font-weight: bold; margin-top: 10rpx; }
.type-card.on .type-label { color: #b4282d; }
.type-desc { color: #b0b0b0; font-size: 20rpx; margin-top: 6rpx; line-height: 1.4; }

/* 申请原因 */
.reason-row { display: flex; flex-wrap: wrap; }
.reason-cap {
  border: 2rpx solid #e0e0e0; color: #666; font-size: 26rpx;
  border-radius: 999rpx; padding: 10rpx 32rpx; margin: 0 20rpx 20rpx 0;
}
.reason-cap.on { border-color: #b4282d; color: #b4282d; background: #fbeaea; }

/* 描述 + 凭证 */
.desc-input {
  width: 100%; height: 180rpx; box-sizing: border-box;
  background: #f7f8fa; border-radius: 12rpx;
  font-size: 26rpx; padding: 20rpx;
}
.img-grid { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.img-cell {
  position: relative; width: 200rpx; height: 200rpx;
  border-radius: 12rpx; margin: 0 20rpx 20rpx 0;
}
.img-thumb { width: 200rpx; height: 200rpx; border-radius: 12rpx; background: #f2f3f5; }
.img-del {
  position: absolute; top: -12rpx; right: -12rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: rgba(0, 0, 0, 0.6); color: #fff;
  font-size: 28rpx; line-height: 40rpx; text-align: center;
}
.img-add {
  background: #f7f8fa; border: 2rpx dashed #d0d0d0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.img-add-icon { font-size: 48rpx; }
.img-add-text { color: #b0b0b0; font-size: 22rpx; margin-top: 8rpx; }

/* 退款金额 */
.amount-card { display: flex; justify-content: space-between; align-items: center; }
.amount-label { font-size: 28rpx; color: #333; }
.amount-value { font-size: 36rpx; }

/* 底部提交 */
.bottom-safe { height: 140rpx; }
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
  background: #fff; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.submit-btn { width: 100%; }
