/* pages/about/about.wxss */
.page { padding-bottom: 40rpx; }

.hero {
  background: linear-gradient(135deg, #d43a3f 0%, #b4282d 60%, #8f1f23 100%);
  padding: 80rpx 0 64rpx;
  text-align: center;
  color: #fff;
}
.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}
.shop-name { font-size: 40rpx; font-weight: bold; margin-top: 24rpx; letter-spacing: 4rpx; }
.version {
  display: inline-block;
  font-size: 22rpx;
  opacity: 0.9;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 999rpx;
  padding: 4rpx 24rpx;
  margin-top: 16rpx;
}

.sec-title { font-size: 30rpx; font-weight: bold; margin-bottom: 16rpx; }
.desc { font-size: 26rpx; color: #555; line-height: 1.9; }

.copyright { text-align: center; color: #c8c8c8; font-size: 22rpx; margin-top: 60rpx; }
