/* pages/points/points.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 积分概览 */
.points-overview {
  background: linear-gradient(135deg, #ff6b6b, #feca57);
  color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.overview-header {
  margin-bottom: 30rpx;
}
.overview-title {
  font-size: 36rpx;
  font-weight: bold;
}
.overview-content {
  text-align: center;
}
.total-points {
  margin-bottom: 30rpx;
}
.points-number {
  font-size: 64rpx;
  font-weight: bold;
}
.points-label {
  font-size: 28rpx;
  margin-left: 10rpx;
}
.points-stats {
  display: flex;
  justify-content: space-around;
}
.stat-item {
  text-align: center;
}
.stat-number {
  font-size: 32rpx;
  font-weight: bold;
}
.stat-label {
  font-size: 24rpx;
  display: block;
}

/* 积分功能菜单 */
.points-menu {
  background: #fff;
  margin-bottom: 20rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #e9e9e9;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}
.menu-text {
  flex: 1;
  font-size: 30rpx;
}
.menu-arrow {
  color: #999;
  font-size: 28rpx;
}

/* 积分兑换商品 */
.exchange-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
}
.more {
  font-size: 26rpx;
  color: #999;
}
.exchange-list {
  display: flex;
}
.exchange-item {
  width: 300rpx;
  margin-right: 20rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
  padding: 20rpx;
}
.product-image {
  width: 100%;
  height: 200rpx;
  border-radius: 10rpx;
  margin-bottom: 15rpx;
}
.product-info {
  margin-bottom: 15rpx;
}
.product-name {
  font-size: 26rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}
.product-points {
  font-size: 24rpx;
  color: #ff6b6b;
  margin-bottom: 5rpx;
}
.product-price {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
}
.exchange-btn {
  width: 100%;
  background: #ff6b6b;
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx;
  border-radius: 5rpx;
}
