/* pages/member/center/center.wxss */
page { background: #f5f6f7; }

/* 会员卡 */
.mc-card {
  position: relative;
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
  background: linear-gradient(135deg, #3a2a2f, #7a3b40 55%, #b4282d);
  color: #fff;
  overflow: hidden;
}
.mc-shine {
  position: absolute;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 230, 160, .35), rgba(255, 230, 160, 0));
  top: -160rpx;
  right: -100rpx;
}
.mc-head { display: flex; align-items: center; position: relative; }
.mc-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, .7);
}
.mc-user { flex: 1; margin-left: 20rpx; }
.mc-name { font-size: 38rpx; font-weight: 800; }
.mc-badge {
  font-size: 20rpx;
  background: linear-gradient(135deg, #ffe9a8, #f5c563);
  color: #7a4a00;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  margin-left: 14rpx;
}
.mc-id { font-size: 20rpx; opacity: .75; margin-top: 8rpx; }
.mc-crown { font-size: 60rpx; }

.mc-progress { margin-top: 32rpx; position: relative; }
.mc-bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .25);
  overflow: hidden;
}
.mc-bar-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffe9a8, #fff3d1);
}
.mc-progress-text { font-size: 20rpx; opacity: .85; margin-top: 12rpx; }

.mc-entries {
  display: flex;
  margin-top: 28rpx;
  background: rgba(255, 255, 255, .12);
  border-radius: 14rpx;
  padding: 20rpx 0;
  position: relative;
}
.mc-entry {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
}
.e-ico { display: block; font-size: 40rpx; margin-bottom: 8rpx; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 28rpx 24rpx;
}
.block-title { font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx; }

/* 生日 */
.birthday-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.bd-title { font-size: 30rpx; font-weight: 700; margin-bottom: 8rpx; }
.bd-btn {
  background: linear-gradient(135deg, #d34046, #b4282d);
  color: #fff;
  font-size: 24rpx;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.bd-btn.done { background: #c9ccd1; }
.bd-btn.disabled { background: #e5e6e8; color: #999; font-size: 20rpx; }

/* 等级 */
.level-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f6f7;
}
.level-row:last-child { border-bottom: none; }
.level-row.cur {
  background: #fdecec;
  border-radius: 12rpx;
  padding: 22rpx 18rpx;
  margin: 0 -18rpx;
}
.lv-name { font-size: 28rpx; font-weight: 700; display: flex; align-items: center; }
.lv-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  display: inline-block;
}
.lv-1 { background: #9aa0a8; }
.lv-2 { background: #a8c0d8; }
.lv-3 { background: #f5c563; }
.lv-4 { background: #8cc7b5; }
.lv-5 { background: #b4282d; }
.lv-tag {
  font-size: 18rpx;
  color: #b4282d;
  border: 1rpx solid #b4282d;
  border-radius: 6rpx;
  padding: 0 10rpx;
  margin-left: 14rpx;
}
.lv-growth { font-size: 22rpx; color: #999; margin: 8rpx 0 10rpx 30rpx; }
.lv-priv { display: flex; flex-wrap: wrap; gap: 12rpx; margin-left: 30rpx; }
.lv-chip {
  font-size: 20rpx;
  color: #666;
  background: #f5f6f7;
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
}

.rule-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #555;
  padding: 16rpx 0;
}
.red { color: #b4282d; font-weight: 700; }
.mc-tip { text-align: center; margin: 20rpx 0 40rpx; }
