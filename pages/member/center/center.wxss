/* pages/member/center/center.wxss — 会员中心 */

.center-page { min-height: 100vh; }

/* ---------- 会员卡（红金渐变） ---------- */
.member-card {
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background:
    radial-gradient(circle at 88% 12%, rgba(247, 212, 136, 0.35) 0%, rgba(247, 212, 136, 0) 42%),
    linear-gradient(135deg, #c22f34 0%, #8f1f23 55%, #6d161a 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(143, 31, 35, 0.35);
  position: relative;
  overflow: hidden;
}
.mc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mc-level {
  display: flex;
  align-items: center;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #f7d488, #f7b500);
}
.mc-level-icon { font-size: 26rpx; margin-right: 8rpx; }
.mc-level-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #7a2b00;
}
.mc-valid {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}
.mc-nick {
  font-size: 40rpx;
  font-weight: bold;
  margin-top: 28rpx;
  color: #f7d488;
  max-width: 480rpx;
}
.mc-nums {
  display: flex;
  margin-top: 32rpx;
}
.mc-num-item {
  flex: 1;
  text-align: center;
}
.mc-num {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
}
.mc-num-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6rpx;
}

/* ---------- 成长值进度 ---------- */
.progress-track {
  position: relative;
  height: 16rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  margin: 12rpx 8rpx 0;
}
.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #d0342c, #f7b500);
  transition: width 0.4s ease;
}
.progress-dot {
  position: absolute;
  top: 50%;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #f7b500;
  border: 4rpx solid #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  transform: translate(-50%, -50%);
}
.progress-labels {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #838383;
  margin-top: 16rpx;
}
.upgrade-text {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fdeeef;
  color: #b4282d;
  font-size: 26rpx;
  font-weight: bold;
  text-align: center;
}
.upgrade-max {
  background: #fff8e6;
  color: #b07c00;
}

/* ---------- 五级成长体系 ---------- */
.level-row {
  position: relative;
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.level-row:last-child { margin-bottom: 0; }
.level-row-current {
  border-color: #b4282d;
  background: #fffafa;
}
.level-corner {
  position: absolute;
  top: 0;
  right: 0;
  background: #b4282d;
  color: #ffffff;
  font-size: 18rpx;
  padding: 4rpx 14rpx;
  border-radius: 0 10rpx 0 12rpx;
}
.level-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}
.level-name {
  font-size: 28rpx;
  color: #333333;
}
.level-growth { margin-top: 6rpx; }
.level-discount {
  font-size: 26rpx;
  color: #b07c00;
  font-weight: bold;
  margin-left: 16rpx;
}

/* ---------- 特权对照 ---------- */
.priv-group {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f4f4f4;
}
.priv-group:last-child { border-bottom: none; }
.priv-head {
  display: flex;
  align-items: center;
}
.priv-head-icon { font-size: 32rpx; margin-right: 12rpx; }
.priv-head-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}
.priv-head-tag { margin-left: 16rpx; }
.priv-tags {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
}
.priv-tags .tag {
  margin-bottom: 12rpx;
  background: #fff8e6;
  color: #b07c00;
}

/* ---------- 生日福利 ---------- */
.birthday-gifts { margin-bottom: 16rpx; }
.birthday-body { margin-top: 8rpx; }
.birthday-btn {
  margin-top: 24rpx;
  width: 400rpx;
}
.birthday-received {
  margin-top: 24rpx;
  display: inline-block;
  padding: 14rpx 48rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #838383;
  font-size: 28rpx;
}
.birthday-rule {
  margin-top: 16rpx;
  line-height: 1.7;
}

/* ---------- 底部入口 ---------- */
.bottom-entries { margin: 24rpx; }
.bottom-entry {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
}
.bottom-entry:last-child { margin-bottom: 0; }
.be-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}
.be-text { flex: 1; min-width: 0; }
.be-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}
.be-sub { margin-top: 6rpx; }
.be-arrow {
  font-size: 40rpx;
  color: #c8c8c8;
}
