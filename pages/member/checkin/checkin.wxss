.ck-page { padding-bottom: 30rpx; }

/* 顶部 */
.ck-hero {
  margin: 24rpx;
  padding: 40rpx 30rpx 34rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #e3544b, #b4282d);
  color: #fff;
  text-align: center;
}
.ck-row { display: flex; }
.ck-stat { flex: 1; }
.ck-num { display: block; font-size: 44rpx; font-weight: 700; }
.ck-lab { display: block; font-size: 20rpx; opacity: 0.85; margin-top: 6rpx; }
.ck-sign {
  margin: 34rpx auto 0;
  width: 360rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #b4282d;
  font-size: 32rpx;
  font-weight: 700;
}
.ck-sign.signed { background: rgba(255,255,255,0.25); color: #fff; }
.ck-tip { font-size: 22rpx; opacity: 0.9; margin-top: 16rpx; }

.card-title { font-size: 30rpx; font-weight: 700; margin-bottom: 24rpx; }

/* 奖励条 */
.reward-row { display: flex; justify-content: space-between; }
.reward {
  position: relative;
  width: 12.5%;
  margin: 0 4rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #f7f8fa;
  padding: 16rpx 0;
}
.reward.big { background: #fff3e0; }
.rw-day { font-size: 18rpx; color: #969799; }
.rw-points { font-size: 24rpx; font-weight: 700; color: #333; margin-top: 6rpx; }
.reward.done { background: #fdecec; }
.reward.done .rw-points { color: #b4282d; }
.reward.current {
  background: #b4282d;
  box-shadow: 0 6rpx 16rpx rgba(180,40,45,0.35);
}
.reward.current .rw-day, .reward.current .rw-points { color: #fff; }
.rw-mark { position: absolute; right: 4rpx; top: 2rpx; font-size: 18rpx; color: #b4282d; }

/* 日历 */
.calendar { display: flex; flex-wrap: wrap; }
.cal-week, .cal-cell {
  width: 14.285%;
  text-align: center;
}
.cal-week { font-size: 22rpx; color: #969799; padding: 10rpx 0; }
.cal-cell {
  height: 96rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.cal-cell.blank { height: 96rpx; }
.cal-day { font-size: 28rpx; color: #333; }
.cal-cell.signed {
  background: #fdecec;
  border-radius: 12rpx;
}
.cal-cell.signed .cal-day { color: #b4282d; font-weight: 700; }
.cal-mark { font-size: 20rpx; color: #b4282d; }
.cal-cell.today .cal-day {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #b4282d;
  color: #b4282d;
  font-weight: 700;
}
.cal-today { font-size: 16rpx; color: #b4282d; }

.rule { font-size: 24rpx; color: #666; line-height: 1.8; }

/* 积分动画 */
.point-pop {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 300;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pp-inner {
  width: 360rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 0;
  text-align: center;
}
.pp-plus { font-size: 80rpx; color: #b4282d; font-weight: 800; }
.pp-text { color: #666; margin-top: 12rpx; font-size: 26rpx; }
