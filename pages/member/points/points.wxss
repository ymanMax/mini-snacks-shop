/* pages/member/points/points.wxss */
page { background: #f5f6f7; }

.pt-head {
  background: linear-gradient(135deg, #d34046, #b4282d);
  color: #fff;
  padding: 48rpx 40rpx 56rpx;
  position: relative;
}
.pt-label { font-size: 26rpx; opacity: .9; }
.pt-num { font-size: 88rpx; font-weight: 800; line-height: 1.2; }
.pt-rules-btn {
  position: absolute;
  right: 32rpx;
  top: 48rpx;
  font-size: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, .7);
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 28rpx 24rpx;
}
.block-title { font-size: 30rpx; font-weight: 700; margin-bottom: 24rpx; }

/* 兑换 */
.ex-scroll { white-space: nowrap; }
.ex-inner { display: flex; }
.ex-item {
  width: 210rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  position: relative;
}
.ex-img { width: 210rpx; height: 210rpx; border-radius: 12rpx; background: #f5f6f7; }
.ex-name {
  font-size: 23rpx;
  margin-top: 10rpx;
  height: 62rpx;
  white-space: normal;
}
.ex-points { color: #b4282d; font-weight: 700; font-size: 26rpx; }
.ex-btn {
  position: absolute;
  right: 0;
  bottom: 0;
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #d34046, #b4282d);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}
.ex-btn.disabled { background: #c9ccd1; }

/* 明细 */
.rc-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f6f7;
}
.rc-info { flex: 1; min-width: 0; }
.rc-desc { font-size: 26rpx; margin-bottom: 6rpx; }
.rc-type {
  font-size: 18rpx;
  color: #999;
  background: #f5f6f7;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 16rpx;
}
.rc-points { font-size: 32rpx; font-weight: 800; }
.rc-points.plus { color: #b4282d; }
.rc-points.minus { color: #777; }

/* 规则弹层 */
.rule-sheet { padding: 32rpx; }
.pop-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 20rpx; }
.rule-line { font-size: 25rpx; color: #555; line-height: 1.8; }
.pop-btn { margin-top: 28rpx; }
