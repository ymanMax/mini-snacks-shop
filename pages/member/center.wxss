/* pages/member/center.wxss */
.page { padding-bottom: 40rpx; }

/* ===== 会员卡 ===== */
.member-card {
  position: relative;
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  color: #f8e7b8;
  background: linear-gradient(135deg, #b4282d 0%, #7e1b1f 55%, #4a1013 100%);
  overflow: hidden;
}
.shine {
  position: absolute;
  top: -120rpx;
  right: -60rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 226, 150, 0.35) 0%, rgba(255, 226, 150, 0) 70%);
}
.card-top { display: flex; justify-content: space-between; align-items: flex-start; }
.card-level { font-size: 40rpx; font-weight: bold; letter-spacing: 2rpx; }
.card-no { font-size: 24rpx; opacity: 0.8; margin-top: 12rpx; letter-spacing: 4rpx; }
.discount-badge {
  background: linear-gradient(90deg, #f5d67b, #e0b44c);
  color: #6b4e0b;
  font-size: 22rpx;
  font-weight: bold;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}
.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 60rpx;
}
.valid { font-size: 22rpx; opacity: 0.8; }
.card-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(248, 231, 184, 0.6);
  background: #fff;
}

/* ===== 成长值 ===== */
.sec-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; }
.growth-row { display: flex; align-items: baseline; }
.growth-cur { font-size: 48rpx; font-weight: bold; color: #b4282d; }
.growth-target { font-size: 24rpx; color: #838383; margin-left: 8rpx; }
.bar {
  height: 16rpx;
  border-radius: 999rpx;
  background: #f0f0f0;
  margin-top: 16rpx;
  overflow: hidden;
}
.bar-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #d43a3f, #b4282d);
}
.growth-tip { font-size: 22rpx; color: #838383; margin-top: 12rpx; }

/* ===== 生日福利 ===== */
.birthday-card { display: flex; align-items: center; justify-content: space-between; background: linear-gradient(90deg, #fff8f0, #fff); }
.birthday-info { display: flex; align-items: center; }
.birthday-icon { font-size: 56rpx; margin-right: 20rpx; }
.birthday-title { font-size: 30rpx; font-weight: bold; }
.birthday-desc { font-size: 24rpx; color: #b4282d; margin-top: 6rpx; }
.birthday-btn { padding: 14rpx 36rpx; font-size: 26rpx; flex-shrink: 0; }
.birthday-claimed { font-size: 26rpx; color: #666; }

/* ===== 成长体系表 ===== */
.level-header, .level-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: 24rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}
.level-header { color: #838383; padding-bottom: 12rpx; }
.level-row:last-child { border-bottom: none; }
.level-row.current {
  background: #fbeaea;
  margin: 0 -24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  border-radius: 12rpx;
}
.col-lv { width: 30%; font-weight: bold; }
.col-growth { width: 20%; }
.col-discount { width: 20%; color: #b4282d; }
.col-free { width: 30%; color: #666; }
.cur-tag {
  display: inline-block;
  background: #b4282d;
  color: #fff;
  font-size: 18rpx;
  border-radius: 999rpx;
  padding: 2rpx 10rpx;
  margin-left: 8rpx;
  font-weight: normal;
}
.privileges { width: 100%; margin-top: 12rpx; }
