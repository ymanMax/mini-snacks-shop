/* pages/shop/index.wxss */
.page { padding-bottom: 40rpx; }

/* ===== 头部 ===== */
.shop-head {
  background: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
}
.head-main { display: flex; align-items: center; }
.shop-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
  flex-shrink: 0;
}
.head-info { flex: 1; margin-left: 24rpx; }
.shop-name { font-size: 34rpx; font-weight: bold; }
.score-row { display: flex; align-items: center; margin-top: 12rpx; }
.score-num { font-size: 40rpx; font-weight: bold; color: #b4282d; margin-right: 16rpx; }
.stars { display: flex; }
.star { color: #e0e0e0; font-size: 32rpx; }
.star.on { color: #f5a623; }
.sub-scores { display: flex; margin-top: 28rpx; }
.sub-item { flex: 1; padding-right: 20rpx; }
.sub-item:last-child { padding-right: 0; }
.sub-bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: #f0f0f0;
  overflow: hidden;
}
.sub-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #d43a3f, #b4282d);
}
.sub-text { display: block; font-size: 20rpx; color: #838383; margin-top: 8rpx; }

/* ===== 公告与信息 ===== */
.notice-row { display: flex; align-items: center; padding: 8rpx 0 20rpx; }
.notice-icon { font-size: 32rpx; margin-right: 16rpx; }
.notice-clip { flex: 1; overflow: hidden; }
.notice-text {
  font-size: 24rpx;
  color: #b4282d;
  white-space: nowrap;
  display: inline-block;
  animation: marquee 14s linear infinite;
}
@keyframes marquee {
  0% { transform: translateX(100%); }
  100% { transform: translateX(-100%); }
}
.info-row { display: flex; align-items: center; padding: 20rpx 0 0; }
.info-icon { font-size: 30rpx; margin-right: 16rpx; }
.info-label { font-size: 26rpx; color: #838383; width: 130rpx; flex-shrink: 0; }
.info-value { flex: 1; font-size: 26rpx; min-width: 0; }
.copy-tag {
  font-size: 22rpx;
  color: #b4282d;
  border: 2rpx solid #b4282d;
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* ===== 照片 ===== */
.photo-swiper { height: 320rpx; margin: 24rpx; border-radius: 16rpx; overflow: hidden; }
.photo { width: 100%; height: 100%; background: #f2f3f5; }

/* ===== 规则 ===== */
.sec-title { font-size: 30rpx; font-weight: bold; margin-bottom: 16rpx; }
.rule-line { font-size: 26rpx; color: #555; line-height: 2; }

/* ===== 评价 ===== */
.summary-row {
  display: flex;
  background: #fbeaea;
  border-radius: 12rpx;
  padding: 20rpx 0;
  margin-bottom: 8rpx;
}
.summary-item { flex: 1; text-align: center; font-size: 24rpx; color: #666; }
.summary-num { color: #b4282d; font-weight: bold; font-size: 30rpx; margin-left: 8rpx; }
.review-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}
.review-item:last-of-type { border-bottom: none; }
.rv-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f2f3f5;
  flex-shrink: 0;
}
.rv-body { flex: 1; margin-left: 20rpx; min-width: 0; }
.rv-head { display: flex; justify-content: space-between; align-items: center; }
.rv-name { font-size: 26rpx; font-weight: bold; }
.rv-time { font-size: 20rpx; color: #b0b0b0; }
.rv-scores { margin-top: 8rpx; }
.rv-score { font-size: 20rpx; color: #f5a623; margin-right: 20rpx; }
.rv-content { font-size: 26rpx; color: #555; line-height: 1.5; margin-top: 10rpx; }

.more-btn { margin-top: 24rpx; padding: 14rpx 0; }
.load-more { text-align: center; color: #b0b0b0; font-size: 24rpx; padding: 24rpx 0 8rpx; }
