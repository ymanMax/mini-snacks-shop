.sh-page { padding-bottom: 40rpx; }

.shop-hero {
  background: linear-gradient(135deg, #d8443a, #b4282d);
  color: #fff;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
}
.shop-logo {
  width: 130rpx;
  height: 130rpx;
  border-radius: 24rpx;
  border: 4rpx solid rgba(255,255,255,0.5);
  background: #fff;
}
.shop-info { flex: 1; margin-left: 24rpx; }
.shop-name { font-size: 36rpx; font-weight: 700; }
.shop-score { margin-top: 10rpx; font-size: 22rpx; }
.score-num { color: #ffd98a; font-weight: 700; margin-right: 12rpx; }
.shop-hours { font-size: 20rpx; opacity: 0.85; margin-top: 8rpx; }
.call-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: rgba(255,255,255,0.18);
  border-radius: 50%;
  font-size: 36rpx;
}

.tabs { display: flex; background: #fff; height: 88rpx; border-bottom: 1rpx solid #f0f0f0; }
.tab {
  flex: 1;
  text-align: center;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab.on { color: #b4282d; font-weight: 700; }
.tab.on::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #b4282d;
}

.card-title { font-size: 30rpx; font-weight: 700; margin-bottom: 16rpx; }
.sc-title { font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx; }
.sc-row { display: flex; align-items: center; padding: 12rpx 0; }
.sc-label { width: 140rpx; font-size: 26rpx; color: #555; }
.sc-bar { flex: 1; height: 14rpx; background: #f2f3f5; border-radius: 999rpx; overflow: hidden; margin: 0 20rpx; }
.sc-in { height: 100%; background: linear-gradient(90deg, #ff8a65, #e6432d); border-radius: 999rpx; }
.sc-in.blue { background: linear-gradient(90deg, #64b5f6, #2f7cf6); }
.sc-in.green { background: linear-gradient(90deg, #4db6ac, #0ea47a); }
.sc-num { width: 70rpx; text-align: right; color: #b4282d; font-weight: 700; font-size: 26rpx; }

.notice { font-size: 27rpx; color: #444; line-height: 1.7; }
.rule-line, .address-line { font-size: 25rpx; color: #666; line-height: 1.9; }
.photos { display: flex; flex-wrap: wrap; }
.photo { width: 218rpx; height: 150rpx; border-radius: 12rpx; margin: 0 12rpx 12rpx 0; }

.enter-btn {
  margin: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(90deg, #d8443a, #b4282d);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.rv-list { margin: 24rpx; }
.rv-item { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.rv-head { display: flex; align-items: center; }
.rv-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; margin-right: 16rpx; }
.rv-name { flex: 1; font-size: 27rpx; }
.rv-date { font-size: 20rpx; color: #b0b3ba; }
.rv-scores { display: flex; margin: 16rpx 0; font-size: 24rpx; color: #ff9900; }
.rv-scores text { margin-right: 24rpx; }
.rv-content { font-size: 27rpx; color: #333; line-height: 1.6; }
.rv-reply { background: #f7f8fa; border-radius: 10rpx; padding: 14rpx 16rpx; font-size: 24rpx; color: #666; margin-top: 14rpx; }
