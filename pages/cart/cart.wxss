/* pages/cart/cart.wxss */
page { background: #f5f6f7; }

.cart-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 24rpx;
}
.cart-title { font-size: 32rpx; font-weight: 700; }
.edit-btn { font-size: 26rpx; color: #666; }

/* 商品条目 */
.cart-list { margin-top: 16rpx; }
.cart-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  margin-bottom: 2rpx;
}
.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #c9ccd1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  flex-shrink: 0;
}
.check.on { background: #b4282d; border-color: #b4282d; }
.check.disabled { background: #e5e6e8; border-color: #e5e6e8; }
.ci-pic {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin: 0 20rpx;
  background: #f5f6f7;
  flex-shrink: 0;
}
.ci-info { flex: 1; min-width: 0; align-self: stretch; display: flex; flex-direction: column; }
.ci-name { font-size: 28rpx; line-height: 1.4; }
.ci-spec { margin-top: 8rpx; }
.ci-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ci-price { color: #b4282d; font-weight: 700; font-size: 32rpx; }
.ci-actions { display: flex; align-items: center; }
.ci-del {
  font-size: 24rpx;
  color: #b4282d;
  border: 2rpx solid #b4282d;
  border-radius: 999rpx;
  padding: 6rpx 24rpx;
}

.stepper { display: flex; align-items: center; }
.st-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border: 2rpx solid #ddd;
  font-size: 30rpx;
  color: #666;
}
.st-btn:first-child { border-radius: 8rpx 0 0 8rpx; }
.st-num {
  width: 80rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-top: 2rpx solid #ddd;
  border-bottom: 2rpx solid #ddd;
  font-size: 26rpx;
}
.st-btn:last-child { border-radius: 0 8rpx 8rpx 0; }

/* 失效区 */
.invalid-wrap { margin-top: 16rpx; }
.invalid-head {
  display: flex;
  justify-content: space-between;
  background: #fff;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #666;
}
.invalid-clear { color: #999; font-size: 24rpx; }
.cart-item.invalid { opacity: .55; }
.invalid-tag {
  font-size: 22rpx;
  color: #999;
  border: 1rpx solid #ccc;
  border-radius: 6rpx;
  padding: 2rpx 14rpx;
}

/* 猜你喜欢 */
.guess { margin-top: 30rpx; }
.guess-title { text-align: center; color: #999; font-size: 24rpx; margin-bottom: 20rpx; }
.guess-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  padding: 0 24rpx;
}

/* 结算栏 */
.settle-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, .05);
  z-index: 60;
}
.all-text { font-size: 24rpx; color: #555; margin-left: 8rpx; margin-right: 16rpx; }
.total-box { flex: 1; text-align: right; padding-right: 20rpx; }
.total-line { font-size: 24rpx; }
.total-price { color: #b4282d; font-size: 38rpx; font-weight: 800; }
.discount-line { display: flex; justify-content: flex-end; gap: 16rpx; }
.discount-text { color: #ff6b00; font-size: 20rpx; }
.coupon-tip { color: #b4282d; font-size: 20rpx; }
.freight-text { color: #999; font-size: 20rpx; }
.coupon-apply { color: #b4282d; font-size: 18rpx; text-align: right; }
.gap-tip {
  font-size: 18rpx;
  text-align: right;
  margin-top: 2rpx;
}
.gap-tip.reduce { color: #ff6b00; }
.gap-tip.freight { color: #4a90d9; }
.settle-btn {
  background: linear-gradient(135deg, #d34046, #b4282d);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0 52rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
}
.batch-btn { padding: 0 36rpx; margin-left: auto; }
