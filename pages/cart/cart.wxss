.cart-page { min-height: 100vh; padding-bottom: 20rpx; }

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx 10rpx;
}
.tb-title { font-size: 32rpx; font-weight: 700; }
.tb-edit { color: #666; font-size: 26rpx; }

/* 商品行 */
.list-card { background: #fff; margin: 0 24rpx; border-radius: 16rpx; overflow: hidden; }
.cart-row {
  position: relative;
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.cart-row:last-child { border-bottom: none; }
.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #c8c9cc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.check.on { background: #b4282d; border-color: #b4282d; }
.row-img { width: 170rpx; height: 170rpx; border-radius: 12rpx; margin-right: 20rpx; flex-shrink: 0; }
.row-info { flex: 1; min-width: 0; display: flex; flex-direction: column; height: 170rpx; }
.row-name { font-size: 28rpx; color: #222; line-height: 1.35; }
.row-spec {
  display: inline-block;
  align-self: flex-start;
  background: #f5f6f7;
  color: #666;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-top: 10rpx;
}
.row-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.row-bottom .int { font-size: 34rpx; }
.row-del {
  position: absolute;
  right: 16rpx;
  top: 20rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  color: #c0c4cc;
  font-size: 26rpx;
}

/* 促销凑单 */
.promo-card {
  background: linear-gradient(135deg, #fff5f3, #fff);
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #ffe0d9;
}
.promo-ladders { display: flex; justify-content: space-between; }
.ladder {
  flex: 1;
  text-align: center;
  position: relative;
}
.ladder .ld-label {
  display: block;
  font-size: 20rpx;
  color: #969799;
  background: #f5f6f7;
  border-radius: 999rpx;
  padding: 8rpx 0;
  margin: 0 8rpx;
}
.ladder.reached .ld-label {
  background: #b4282d;
  color: #fff;
}
.ld-mark {
  display: block;
  font-size: 18rpx;
  color: #c0c4cc;
  margin-top: 6rpx;
}
.ladder.reached .ld-mark { color: #b4282d; }
.promo-gaps { margin-top: 14rpx; }
.gap-item {
  font-size: 22rpx;
  color: #ff9900;
  line-height: 1.9;
}
.gap-item.done { color: #0ea47a; }
.gap-item.coupon { color: #b4282d; }

/* 失效区 */
.invalid-card { background: #fff; margin: 24rpx; border-radius: 16rpx; overflow: hidden; }
.invalid-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.ih-title { font-size: 28rpx; color: #666; font-weight: 600; }
.ih-clear { font-size: 24rpx; color: #969799; border: 1rpx solid #dcdee0; padding: 6rpx 20rpx; border-radius: 999rpx; }
.cart-row.disabled { opacity: 0.75; }
.row-img.gray { filter: grayscale(1); }
.inv-tag {
  background: #f2f3f5;
  color: #969799;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}
.inv-price { color: #969799; font-size: 30rpx; text-decoration: line-through; }
.inv-stock { font-size: 22rpx; color: #b4282d; background: #fdecec; padding: 4rpx 14rpx; border-radius: 8rpx; }

/* 费用明细弹层 */
.detail-pop {
  position: absolute;
  right: 0; bottom: 100rpx;
  width: 460rpx;
  background: #fff;
  border-radius: 16rpx 0 0 16rpx;
  padding: 24rpx;
  box-shadow: -4rpx 0 20rpx rgba(0,0,0,0.08);
}
.detail-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 80;
}
.dp-title { font-weight: 700; margin-bottom: 16rpx; }
.dp-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #555;
  padding: 10rpx 0;
}
.dp-row .discount { color: #b4282d; }
.dp-row.gap .gap-text { color: #ff9900; }
.dp-tip { font-size: 20rpx; color: #c0c4cc; margin-top: 12rpx; text-align: center; }

/* 推荐 */
.reco-scroll { white-space: nowrap; padding: 0 24rpx; }
.reco-card { display: inline-block; width: 340rpx; margin-right: 20rpx; vertical-align: top; }

/* 底部栏 */
.footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  display: flex;
  align-items: center;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
  z-index: 90;
}
.ft-select {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #333;
}
.ft-select .check { margin-right: 10rpx; width: 36rpx; height: 36rpx; }
.ft-total { flex: 1; padding-right: 20rpx; text-align: right; }
.ft-amount { font-size: 26rpx; }
.ft-amount .int { font-size: 40rpx; }
.ft-detail { font-size: 22rpx; color: #969799; }
.ft-btn {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 56rpx;
  margin-right: 20rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}
.ft-btn.checkout { background: linear-gradient(90deg, #d8443a, #b4282d); }
.ft-btn.delete { background: linear-gradient(90deg, #969799, #646566); }
.ft-btn.disabled { background: #f1b4b6; }
.ft-btn.delete.disabled { background: #dcdee0; }
