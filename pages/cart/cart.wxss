/* pages/cart/cart.wxss —— 购物车（主题色 #b4282d） */

/* ============ 骨架屏 ============ */
.sk-item { display: flex; align-items: center; }
.sk-circle { width: 40rpx; height: 40rpx; border-radius: 50%; flex-shrink: 0; }
.sk-img { width: 160rpx; height: 160rpx; margin-left: 20rpx; flex-shrink: 0; }
.sk-right { flex: 1; margin-left: 20rpx; }
.sk-line { height: 30rpx; margin: 14rpx 0; }

/* ============ 编辑入口（右上角） ============ */
.edit-entry {
  position: fixed;
  top: 16rpx;
  right: 24rpx;
  z-index: 15;
  background: #fff;
  color: #333;
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* ============ 商品列表 ============ */
.list-card { padding-bottom: 8rpx; margin-top: 88rpx; }
.cart-item { display: flex; align-items: center; padding: 20rpx 0; }
.check-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #c8c8c8;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  line-height: 1;
}
.check-circle.checked { background: #b4282d; border-color: #b4282d; }
.cart-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
  margin-left: 20rpx;
  flex-shrink: 0;
}
.cart-img.gray { opacity: 0.5; }
.cart-info { flex: 1; margin-left: 20rpx; min-width: 0; }
.cart-name { font-size: 28rpx; line-height: 1.4; }
.cart-spec { color: #838383; font-size: 22rpx; margin-top: 8rpx; }
.cart-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.cart-stock { color: #b4282d; font-size: 20rpx; margin-top: 8rpx; }
.gray-text { color: #b0b0b0; }
.list-tip { color: #c8c8c8; font-size: 20rpx; text-align: center; padding: 8rpx 0 12rpx; }

/* ============ stepper ============ */
.stepper { display: flex; align-items: center; }
.stepper-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  background: #f2f3f5;
  border-radius: 8rpx;
  font-size: 32rpx;
  color: #333;
}
.stepper-btn.disabled { color: #c8c8c8; }
.stepper-num { min-width: 64rpx; text-align: center; font-size: 28rpx; }

/* ============ 失效商品 ============ */
.invalid-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.invalid-title { font-size: 28rpx; font-weight: bold; color: #838383; }
.invalid-arrow { font-size: 24rpx; color: #b0b0b0; }
.invalid-item { opacity: 0.8; }
.invalid-badge {
  flex-shrink: 0;
  background: #c8c8c8;
  color: #fff;
  font-size: 18rpx;
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
}
.clear-btn { margin: 12rpx auto 0; width: 300rpx; }

/* ============ 结算栏 ============ */
.settle-placeholder { height: 140rpx; }
.settle-bar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
.reduce-panel { padding: 20rpx 24rpx 4rpx; border-bottom: 2rpx solid #f0f0f0; }
.reduce-row { display: flex; justify-content: space-between; padding: 8rpx 0; }
.reduce-rule { font-size: 26rpx; }
.reduce-state { font-size: 24rpx; color: #b0b0b0; }
.reduce-state.hit { color: #b4282d; }
.reduce-tip { color: #b4282d; font-size: 24rpx; padding: 12rpx 0 4rpx; }
.freight-tip { color: #838383; font-size: 24rpx; padding: 4rpx 0 16rpx; }
/* 最优券 / 凑单提示条（优化 1） */
.coupon-tip {
  display: flex;
  align-items: center;
  margin: 0 24rpx;
  padding: 14rpx 20rpx;
  background: #fbeaea;
  border-radius: 12rpx;
}
.coupon-tip-text { flex: 1; min-width: 0; color: #b4282d; font-size: 24rpx; }
.coupon-tip-arrow { color: #b4282d; font-size: 30rpx; margin-left: 12rpx; flex-shrink: 0; }
.settle-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}
.check-all { display: flex; align-items: center; flex-shrink: 0; }
.check-all-text { font-size: 26rpx; margin-left: 12rpx; }
.settle-mid { flex: 1; margin-left: 24rpx; min-width: 0; }
.settle-total { display: flex; align-items: baseline; font-size: 26rpx; }
.settle-price { font-size: 40rpx; }
.settle-reduce {
  color: #b4282d;
  font-size: 20rpx;
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.settle-btn {
  flex-shrink: 0;
  background: #b4282d;
  color: #fff;
  font-size: 30rpx;
  border-radius: 999rpx;
  padding: 18rpx 48rpx;
}
.settle-btn.disabled { background: #d9a0a2; }
.delete-btn { background: #b4282d; }
.delete-btn.disabled { background: #d9a0a2; }

/* ============ 猜你喜欢（空态） ============ */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #b4282d;
  line-height: 1.2;
}
.rec-scroll { white-space: nowrap; }
.rec-item {
  display: inline-block;
  vertical-align: top;
  width: 200rpx;
  margin-right: 20rpx;
}
.rec-img { width: 200rpx; height: 200rpx; border-radius: 12rpx; background: #f2f3f5; }
.rec-name { font-size: 24rpx; white-space: normal; margin-top: 10rpx; height: 64rpx; }
.rec-price { font-size: 28rpx; }
