/* pages/cart/cart.wxss — 购物车（重构版） */
/* 规范：主题色 #b4282d / 页面背景 #f5f6f7 / 卡片白底圆角 16rpx / 间距 24rpx */

.cart-page {
  padding-bottom: 200rpx;
}

/* ---------- 顶部条：统计 + 右上角「编辑 / 完成」 ---------- */
.cart-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 0;
}
.topbar-count {
  font-size: 24rpx;
  color: #838383;
}
.edit-toggle {
  padding: 6rpx 28rpx;
  font-size: 26rpx;
  color: #b4282d;
  background: #ffffff;
  border: 2rpx solid #b4282d;
  border-radius: 999rpx;
}

/* ---------- 圆形勾选框 ---------- */
.cbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #cccccc;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cbox-on {
  background: #b4282d;
  border-color: #b4282d;
}
.cbox-tick {
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1;
}

/* ---------- 商品行（支持左滑删除） ---------- */
.cart-list {
  margin: 16rpx 24rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}
.cart-row {
  position: relative;
  overflow: hidden;
  border-bottom: 2rpx solid #f2f3f5;
}
.cart-row:last-child {
  border-bottom: none;
}
.row-inner {
  position: relative;
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx 24rpx 24rpx;
  background: #ffffff;
  transition: transform 0.2s ease;
  z-index: 2;
}
.row-open {
  transform: translateX(-140rpx);
}
.row-del {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #b4282d;
  color: #ffffff;
  font-size: 28rpx;
  z-index: 1;
}
.row-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f6f7;
  margin: 0 20rpx;
  flex-shrink: 0;
}
.row-info {
  flex: 1;
  min-width: 0;
  height: 160rpx;
  display: flex;
  flex-direction: column;
}
.row-name {
  font-size: 28rpx;
  color: #333333;
  line-height: 40rpx;
}
.row-spec {
  display: inline-block;
  align-self: flex-start;
  max-width: 100%;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #838383;
  background: #f2f3f5;
  border-radius: 999rpx;
}
.row-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.row-price {
  font-size: 34rpx;
}
.row-x {
  position: absolute;
  top: 8rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 36rpx;
  color: #b2b2b2;
}

/* ---------- 数量 stepper ---------- */
.stepper {
  display: flex;
  align-items: center;
  border: 2rpx solid #eeeeee;
  border-radius: 999rpx;
  overflow: hidden;
}
.step-btn {
  width: 56rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 32rpx;
  color: #333333;
  background: #f7f8fa;
}
.step-off {
  color: #cccccc;
}
.step-num {
  min-width: 64rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333333;
  background: #ffffff;
}
.stock-tip {
  font-size: 22rpx;
  color: #b2b2b2;
}

/* ---------- 失效商品折叠区 ---------- */
.invalid-card {
  margin: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}
.invalid-head {
  display: flex;
  align-items: center;
  padding: 24rpx;
}
.invalid-title {
  font-size: 26rpx;
  color: #838383;
}
.invalid-arrow {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #b2b2b2;
  transition: transform 0.2s ease;
}
.invalid-arrow.up {
  transform: rotate(180deg);
}
.invalid-clear {
  margin-left: auto;
  padding: 6rpx 24rpx;
  font-size: 24rpx;
  color: #838383;
  border: 2rpx solid #dddddd;
  border-radius: 999rpx;
}
.invalid-body {
  border-top: 2rpx solid #f2f3f5;
}
.invalid-row {
  position: relative;
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx 24rpx 24rpx;
  border-bottom: 2rpx solid #f2f3f5;
}
.invalid-row:last-child {
  border-bottom: none;
}
.invalid-thumb-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin: 0 20rpx 0 56rpx;
  flex-shrink: 0;
}
.invalid-thumb-wrap .row-thumb {
  margin: 0;
}
.invalid-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 12rpx;
}
.invalid-name {
  color: #b2b2b2;
}
.invalid-price {
  margin-top: auto;
  font-size: 24rpx;
  color: #b2b2b2;
}

/* ---------- 优惠明细小面板 ---------- */
.discount-panel {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(170rpx + env(safe-area-inset-bottom)); /* 默认偏移；有促销提示条时由 wxml 内联 style 联动 */
  z-index: 100;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.12);
  animation: popup-up 0.2s ease;
}
.dp-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
}
.dp-row-gap {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f7f8fa;
}
.dp-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
}
.dp-value {
  font-size: 30rpx;
}
.dp-note {
  font-size: 22rpx;
  color: #838383;
  line-height: 40rpx;
}
/* 免配送费进度（纯 CSS 细进度条） */
.dp-ship-diff {
  font-size: 26rpx;
  color: #b4282d;
  font-weight: bold;
}
.dp-ship-free {
  font-size: 26rpx;
  color: #0ea47a;
  font-weight: bold;
}
.dp-ship-bar {
  height: 12rpx;
  margin: 8rpx 0 4rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
  overflow: hidden;
}
.dp-ship-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff6a3d, #b4282d);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

/* ---------- 促销提示条（结算栏上方，纵向堆叠，浅红底红字） ---------- */
.promo-tips {
  background: #fdeeef;
}
.promo-tip {
  display: flex;
  align-items: center;
  height: 52rpx; /* 与 cart.js PROMO_TIP_H 保持一致（面板偏移联动） */
  padding: 0 24rpx;
  font-size: 22rpx;
  color: #b4282d;
}
.promo-tip + .promo-tip {
  border-top: 2rpx dashed rgba(180, 40, 45, 0.16);
}
.promo-tip-tick {
  flex-shrink: 0;
  margin-right: 8rpx;
  font-weight: bold;
  color: #0ea47a; /* 已享满减：绿色对勾 */
}
.promo-tip-text {
  flex: 1;
  min-width: 0;
}
.promo-tip-action {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-weight: bold;
}

/* ---------- 底部固定结算栏 ---------- */
.cart-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.cart-footer .demo-tip {
  padding: 8rpx 0 0;
}
.footer-bar {
  display: flex;
  align-items: center;
  height: 104rpx;
  padding: 0 24rpx;
}
.footer-left {
  display: flex;
  align-items: center;
}
.footer-all-text {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #333333;
}
.footer-mid {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.footer-total {
  display: flex;
  align-items: baseline;
}
.footer-total-label {
  font-size: 24rpx;
  color: #333333;
  margin-right: 8rpx;
}
.footer-amount {
  font-size: 38rpx;
}
.footer-discount {
  display: flex;
  align-items: center;
  margin-top: 2rpx;
}
.footer-discount-text {
  font-size: 20rpx;
  color: #838383;
}
.footer-reduce {
  font-size: 20rpx;
  color: #b4282d;
}
.footer-arrow {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #838383;
  transition: transform 0.2s ease;
}
.footer-arrow.up {
  transform: rotate(180deg);
}
.settle-btn {
  min-width: 200rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 32rpx;
  text-align: center;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #d0342c, #b4282d);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
}
.settle-off {
  background: #d8d9db;
  color: #ffffff;
}
.del-btn {
  background: #ffffff;
  color: #b4282d;
  border: 2rpx solid #b4282d;
}
.del-btn.settle-off {
  background: #ffffff;
  color: #dddddd;
  border-color: #eeeeee;
}

/* ---------- 空态下方猜你喜欢 ---------- */
.guess-wrap {
  padding: 0 24rpx 40rpx;
}
.guess-title {
  padding-top: 24rpx;
}
.guess-scroll {
  white-space: nowrap;
  width: 100%;
}
.guess-item {
  display: inline-block;
  width: 220rpx;
  vertical-align: top;
}
