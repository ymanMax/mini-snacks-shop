.fail-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  background: #f5f6f7;
  min-height: 100vh;
}
.fail-emoji { font-size: 140rpx; }
.fail-title { font-size: 36rpx; font-weight: 700; margin-top: 30rpx; }
.fail-sub { font-size: 26rpx; color: #969799; margin-top: 16rpx; }
.fail-actions { display: flex; margin-top: 60rpx; }
.f-btn {
  margin: 0 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  padding: 0 50rpx;
  font-size: 28rpx;
}
.f-btn::after { border: none; }
.f-btn.plain { background: #fff; color: #666; border: 1rpx solid #c8c9cc; }
.f-btn.primary { background: linear-gradient(90deg, #d8443a, #b4282d); color: #fff; }
