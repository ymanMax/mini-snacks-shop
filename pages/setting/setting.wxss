/* pages/setting/setting.wxss */
.page { padding-bottom: 40rpx; }

.menu-card { padding-top: 8rpx; padding-bottom: 8rpx; }
.menu-title { font-size: 24rpx; color: #838383; padding: 20rpx 0 8rpx; }
.menu-row {
  display: flex;
  align-items: center;
  height: 96rpx;
  border-bottom: 2rpx solid #f5f5f5;
}
.menu-row:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; width: 56rpx; }
.menu-name { flex: 1; font-size: 28rpx; }
.menu-desc { font-size: 22rpx; color: #b0b0b0; margin-right: 12rpx; }
.arrow { color: #c8c8c8; font-size: 36rpx; }
