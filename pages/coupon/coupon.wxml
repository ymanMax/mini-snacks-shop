<view class="cp-page">
  <view class="cp-hero">
    <view class="hero-title">🎫 领券中心</view>
    <view class="hero-sub">优惠券可与满减叠加使用，下单自动匹配最优</view>
    <view class="hero-btn" bindtap="goMine">查看我的优惠券 ›</view>
  </view>

  <view class="cp-tabs">
    <view wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchTab"
      class="cp-tab {{active === item.key ? 'on' : ''}}">{{item.label}}</view>
  </view>

  <view class="cp-list">
    <view wx:for="{{list}}" wx:key="id" class="coupon {{item.received ? 'used' : ''}}">
      <view class="cp-left">
        <view class="cp-value">
          <text class="cp-unit" wx:if="{{item.type !== 2}}">￥</text>
          <text class="cp-num">{{item.valueText}}</text>
          <text class="cp-unit" wx:if="{{item.type === 2}}">{{item.unitText}}</text>
        </view>
        <view class="cp-rule">{{item.ruleText}}</view>
      </view>
      <view class="cp-right">
        <view class="cp-name">{{item.name}}</view>
        <view class="cp-scope">{{item.scopeLabel}}</view>
        <view class="cp-progress">已领 {{item.received}} / {{item.total}}</view>
        <view class="cp-btn {{item.received ? 'got' : ''}}" data-id="{{item.id}}" bindtap="receive">
          {{item.received ? '已领取 ›' : '立即领取'}}
        </view>
      </view>
    </view>
  </view>

  <empty-state wx:if="{{!loading && !list.length}}" img="/static/images/empty_coupon.png"
    text="{{active === 'received' ? '还没有领取优惠券' : '优惠券暂时领完啦'}}"
    sub="{{active === 'received' ? '去领券中心逛逛吧' : ''}}"
    btnText="{{active === 'received' ? '去领券' : ''}}" bindbtn="goMine"></empty-state>
  <view style="height: 40rpx;"></view>
</view>
