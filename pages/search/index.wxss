/* pages/search/index.wxss —— 搜索页（优化 10） */

/* 顶部搜索框 */
.header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #f5f6f7;
}
.back {
  font-size: 40rpx;
  color: #333333;
  padding: 0 20rpx 0 4rpx;
  line-height: 1;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
}
.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
}
.search-btn {
  font-size: 28rpx;
  color: #b4282d;
  font-weight: bold;
  padding-left: 24rpx;
}

/* 历史 / 热词区块 */
.block {
  margin: 20rpx 24rpx 0;
}
.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.block-title {
  font-size: 30rpx;
  font-weight: bold;
}
.block-clear {
  font-size: 24rpx;
  color: #b0b0b0;
}
.word-wall {
  display: flex;
  flex-wrap: wrap;
}
.word {
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  margin: 0 20rpx 20rpx 0;
}
.history-word {
  display: flex;
  align-items: center;
  background: #ffffff;
  color: #333333;
}
.word-del {
  color: #b0b0b0;
  font-size: 28rpx;
  margin-left: 12rpx;
  padding: 0 4rpx;
  line-height: 1;
}
.hot-word {
  background: #fbeaea;
  color: #b4282d;
}

/* 联想列表 */
.suggest-list {
  background: #ffffff;
  margin: 0 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.suggest-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 2rpx solid #f5f5f5;
}
.suggest-item:last-child {
  border-bottom: none;
}
.suggest-icon {
  font-size: 26rpx;
  color: #b0b0b0;
  margin-right: 16rpx;
}
.suggest-name {
  font-size: 28rpx;
  flex: 1;
}
.suggest-empty {
  padding: 60rpx 0;
  text-align: center;
  color: #b0b0b0;
  font-size: 26rpx;
}

/* 排序 Tab */
.sort-bar {
  position: sticky;
  top: 92rpx;
  z-index: 10;
  display: flex;
  background: #ffffff;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}
.sort-tab {
  font-size: 26rpx;
  color: #838383;
  margin-right: 40rpx;
}
.sort-tab.active {
  color: #b4282d;
  font-weight: bold;
}

/* 商品两列网格（与首页一致） */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 24rpx 24rpx 0;
}
.goods-card {
  width: 340rpx;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.goods-img,
.skeleton-img {
  width: 340rpx;
  height: 340rpx;
  background: #f5f6f7;
}
.goods-info {
  padding: 16rpx 20rpx 20rpx;
}
.goods-name {
  font-size: 26rpx;
  line-height: 1.4;
  min-height: 72rpx;
}
.goods-tags {
  margin-top: 8rpx;
  min-height: 40rpx;
}
.goods-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 10rpx;
}
.goods-price-wrap .price {
  font-size: 34rpx;
}
.goods-price-wrap .price-origin {
  margin-left: 10rpx;
}
.goods-sold {
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 4rpx;
}
.add-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #b4282d;
  color: #ffffff;
  font-size: 40rpx;
  line-height: 48rpx;
  text-align: center;
  flex-shrink: 0;
}

/* 骨架屏 */
.skeleton-line {
  height: 28rpx;
  margin-bottom: 16rpx;
}
.skeleton-line.short {
  width: 60%;
}
.skeleton-line.tiny {
  width: 40%;
  height: 22rpx;
}

/* 分页状态 */
.list-footer {
  text-align: center;
  color: #b0b0b0;
  font-size: 24rpx;
  padding: 10rpx 0 30rpx;
}
