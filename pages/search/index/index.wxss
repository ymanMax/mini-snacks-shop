/* pages/search/index/index.wxss */
page { background: #f5f6f7; }

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 30;
}
.search-input {
  flex: 1;
  height: 68rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.s-ico { margin-right: 10rpx; }
.search-input input { flex: 1; font-size: 26rpx; }
.s-clear { color: #b0b3b8; font-size: 22rpx; padding: 0 8rpx; }
.s-cancel { margin-left: 20rpx; color: #b4282d; font-size: 28rpx; }

/* 联想 */
.suggest { background: #fff; }
.sg-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f6f7;
}
.sg-ico { color: #999; margin-right: 16rpx; }
.sg-name { flex: 1; font-size: 27rpx; }
.sg-price { color: #b4282d; font-weight: 700; font-size: 24rpx; }

/* 历史/热词 */
.card.block {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx;
}
.block-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.block-title { font-size: 28rpx; font-weight: 700; }
.block-clear { font-size: 22rpx; color: #999; }
.kw-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; }
.kw-tag {
  font-size: 24rpx;
  color: #555;
  background: #f5f6f7;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}
.kw-tag.hot { color: #b4282d; background: #fdecec; }
.hot-rank {
  font-weight: 800;
  margin-right: 8rpx;
}
.kw-del { color: #b0b3b8; font-size: 18rpx; }

/* 结果排序 */
.sort-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 0 24rpx;
  height: 80rpx;
  position: sticky;
  top: 100rpx;
  z-index: 20;
}
.sort-item {
  margin-right: 48rpx;
  font-size: 26rpx;
  color: #555;
}
.sort-item.on { color: #b4282d; font-weight: 700; }
.sort-total { margin-left: auto; }
.result-list {
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

/* 骨架 */
.sk-results { padding: 18rpx 24rpx; display: flex; flex-direction: column; gap: 18rpx; }
.sk-result { display: flex; background: #fff; border-radius: 16rpx; padding: 20rpx; }
.sk-img { width: 200rpx; height: 200rpx; border-radius: 12rpx; }
.sk-lines { flex: 1; margin-left: 20rpx; }
.sk-line { height: 30rpx; border-radius: 8rpx; margin: 20rpx 0; }
.w80 { width: 80%; }
.w40 { width: 40%; }
