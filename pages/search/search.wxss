/* pages/search/search.wxss */

.search-page {
  min-height: 100vh;
}

/* ---------- 搜索栏 ---------- */
.search-header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #b4282d;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 68rpx;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 0 24rpx;
  min-width: 0;
}
.search-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  min-width: 0;
}
.search-ph {
  color: #b2b2b2;
  font-size: 26rpx;
}
.search-clear {
  font-size: 30rpx;
  color: #b2b2b2;
  padding: 0 8rpx;
}
.search-btn {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  padding: 0 12rpx 0 22rpx;
  flex-shrink: 0;
}

/* ---------- 联想面板 ---------- */
.suggest-panel {
  background: #ffffff;
}
.suggest-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 2rpx solid #f2f3f5;
}
.suggest-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.suggest-info {
  flex: 1;
  min-width: 0;
}
.suggest-name {
  font-size: 28rpx;
  color: #333333;
}
.suggest-price {
  font-size: 28rpx;
  margin-top: 8rpx;
}
.suggest-empty {
  padding: 48rpx 24rpx;
  text-align: center;
  color: #b2b2b2;
  font-size: 26rpx;
}

/* ---------- 区块（历史/热门） ---------- */
.sec {
  background: #ffffff;
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 24rpx;
}
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.sec-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}
.sec-action {
  font-size: 26rpx;
  color: #838383;
}

/* 历史胶囊 */
.tag-wrap {
  display: flex;
  flex-wrap: wrap;
}
.his-tag {
  display: flex;
  align-items: center;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 10rpx 12rpx 10rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  max-width: 100%;
}
.his-tag-text {
  font-size: 26rpx;
  color: #333333;
  max-width: 320rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.his-del {
  font-size: 30rpx;
  color: #b2b2b2;
  margin-left: 12rpx;
  padding: 0 6rpx;
}

/* 热门搜索（两列排行） */
.hot-list {
  display: flex;
  flex-wrap: wrap;
}
.hot-item {
  width: 50%;
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}
.hot-no {
  width: 40rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  font-style: italic;
  color: #b2b2b2;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.hot-no.hot {
  color: #b4282d;
}
.hot-kw {
  font-size: 28rpx;
  color: #333333;
  flex: 1;
  min-width: 0;
}

/* ---------- 排序 Tab ---------- */
.sort-tabs {
  position: sticky;
  top: 100rpx;
  z-index: 15;
  display: flex;
  background: #ffffff;
  padding: 0 12rpx;
}
.sort-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  padding: 22rpx 0;
  position: relative;
}
.sort-tab.active {
  color: #b4282d;
  font-weight: bold;
}
.sort-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: #b4282d;
}

/* ---------- 结果双列 ---------- */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 20rpx 24rpx 0;
}
.goods-grid > goods-card {
  width: 342rpx;
  margin-bottom: 20rpx;
}
