/* pages/order/review/review.wxss */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
}
.block-title { font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx; }

.gr-head { display: flex; align-items: center; padding-bottom: 20rpx; }
.gr-pic { width: 96rpx; height: 96rpx; border-radius: 12rpx; background: #f5f6f7; }
.gr-name { flex: 1; margin-left: 18rpx; font-size: 27rpx; font-weight: 600; }

.gr-row { display: flex; align-items: center; margin: 18rpx 0; }
.gr-label { font-size: 26rpx; color: #555; width: 150rpx; }
.gr-stars { display: flex; }
.g-star {
  font-size: 44rpx;
  color: #e0e1e3;
  margin-right: 12rpx;
}
.g-star.on { color: #ff9900; }

.gr-tags { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 18rpx 0; }
.gr-tag {
  font-size: 24rpx;
  color: #666;
  background: #f5f6f7;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}
.gr-tag.on { background: #fdecec; color: #b4282d; font-weight: 600; }

.gr-input {
  width: 100%;
  background: #f7f8f9;
  border-radius: 12rpx;
  padding: 20rpx;
  height: 150rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.gr-images { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; }
.gr-img-wrap { position: relative; }
.gr-img { width: 140rpx; height: 140rpx; border-radius: 10rpx; }
.gr-img-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  background: rgba(0, 0, 0, .55);
  color: #fff;
  border-radius: 50%;
  font-size: 20rpx;
}
.gr-add {
  width: 140rpx;
  height: 140rpx;
  border: 2rpx dashed #c9ccd1;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}
.add-ico { font-size: 44rpx; line-height: 1; }
.add-text { font-size: 20rpx; margin-top: 6rpx; }

.sr-row { display: flex; align-items: center; margin-bottom: 24rpx; }

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 24rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, .05);
  z-index: 60;
}
.submit-btn {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #d34046, #b4282d);
}
.submit-btn.disabled { opacity: .5; }
