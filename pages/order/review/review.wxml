<!--pages/order/review/review.wxml-->
<view class="page rv-page" wx:if="{{order}}">
  <!-- 逐商品评价 -->
  <view wx:for="{{goodsReviews}}" wx:for-index="idx" wx:key="key" class="card goods-review">
    <view class="gr-head">
      <safe-image class="gr-pic" img-class="gr-pic" src="{{item.pic}}" mode="aspectFill" />
      <view class="gr-name ellipsis-2">{{item.name}}</view>
    </view>

    <view class="gr-row">
      <text class="gr-label">商品评分</text>
      <view class="gr-stars">
        <text wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:for-index="si" wx:key="*this"
          class="g-star {{s <= item.score ? 'on' : ''}}"
          data-index="{{idx}}" data-score="{{s}}" bindtap="setScore">★</text>
      </view>
    </view>

    <view class="gr-tags">
      <text wx:for="{{item.tagOptions}}" wx:for-item="tag" wx:for-index="ti" wx:key="label"
        class="gr-tag {{tag.checked ? 'on' : ''}}"
        data-index="{{idx}}" data-tag-index="{{ti}}" bindtap="toggleTag">{{tag.label}}</text>
    </view>

    <textarea class="gr-input" placeholder="说说商品的口感、新鲜度、包装吧～" maxlength="200"
      value="{{item.content}}" data-index="{{idx}}" bindinput="onContent" />

    <view class="gr-images">
      <view wx:for="{{item.images}}" wx:for-item="img" wx:for-index="imgIdx" wx:key="*this" class="gr-img-wrap">
        <image class="gr-img" src="{{img}}" mode="aspectFill"
          data-index="{{idx}}" data-url="{{img}}" bindtap="previewImage" />
        <view class="gr-img-del" data-index="{{idx}}" data-img-index="{{imgIdx}}" catchtap="removeImage">✕</view>
      </view>
      <view wx:if="{{item.images.length < 6}}" class="gr-add" data-index="{{idx}}" bindtap="chooseImage">
        <text class="add-ico">＋</text>
        <text class="add-text">晒图</text>
      </view>
    </view>
  </view>

  <!-- 店铺评价 -->
  <view class="card shop-review">
    <view class="block-title">店铺评价</view>
    <view wx:for="{{shopDims}}" wx:key="key" class="sr-row">
      <text class="gr-label">{{item.label}}</text>
      <view class="gr-stars">
        <text wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:for-index="si" wx:key="*this"
          class="g-star {{s <= shopScores[item.key] ? 'on' : ''}}"
          data-key="{{item.key}}" data-score="{{s}}" bindtap="setShopScore">★</text>
      </view>
    </view>
    <textarea class="gr-input" placeholder="对店铺服务还满意吗？" maxlength="200"
      value="{{shopContent}}" bindinput="onShopContent" />
  </view>

  <view style="height:140rpx"></view>

  <view class="submit-bar">
    <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">提交评价 · 得 20 积分</view>
  </view>
</view>
