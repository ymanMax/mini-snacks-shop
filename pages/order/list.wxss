/* pages/order/list.wxss — 我的订单列表 */
/* 规范：主题色 #b4282d / 背景 #f5f6f7 / 卡片白底圆角 16rpx / 间距 24rpx */

.order-list-page {
  padding-bottom: 24rpx;
}

/* ---------- 状态 Tab ---------- */
.tab-scroll {
  position: sticky;
  top: 0;
  z-index: 30;
  width: 100%;
  white-space: nowrap;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.tab-item {
  position: relative;
  display: inline-block;
  padding: 24rpx 28rpx 20rpx;
  text-align: center;
}
.tab-text {
  font-size: 28rpx;
  color: #666666;
}
.tab-on .tab-text {
  color: #b4282d;
  font-weight: bold;
}
.tab-line {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: #b4282d;
}

/* ---------- 订单卡 ---------- */
.order-card {
  padding: 0 24rpx;
}
.oc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 20rpx;
  border-bottom: 2rpx solid #f5f6f7;
}
.oc-no {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #838383;
}
.oc-status {
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: bold;
  flex-shrink: 0;
}
/* 状态徽章配色：待付款红 / 待发货·配送中·待收货橙 / 已完成·已取消灰 */
.st-1 { color: #b4282d; }
.st-2 { color: #ff8800; }
.st-3 { color: #ff8800; }
.st-4 { color: #ff8800; }
.st-5 { color: #838383; }
.st-6 { color: #b2b2b2; }

.oc-goods {
  padding: 24rpx 0;
}
.oc-thumbs {
  display: flex;
}
.oc-thumb-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f6f7;
  flex-shrink: 0;
}
.oc-thumb {
  width: 140rpx;
  height: 140rpx;
}
.oc-more {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.55);
}
.oc-goods-name {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #333333;
}

.oc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f5f6f7;
}
.oc-amount {
  display: flex;
  align-items: baseline;
}
.oc-amount-label {
  font-size: 24rpx;
  color: #666666;
  margin-right: 8rpx;
}
.oc-pay {
  font-size: 34rpx;
}
.oc-time {
  font-size: 22rpx;
  color: #b2b2b2;
}

.oc-ops {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 20rpx 0 24rpx;
}
.oc-demo {
  margin-right: auto;
  font-size: 20rpx;
  color: #b2b2b2;
}
.oc-btn {
  margin-left: 16rpx;
  height: 60rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  text-align: center;
}
.oc-btn.btn-primary {
  line-height: 60rpx;
}
