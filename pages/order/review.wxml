<view class="page-container review-page">

  <!-- 骨架屏 -->
  <skeleton wx:if="{{loading}}" type="list" rows="{{3}}" />

  <block wx:elif="{{goodsList.length}}">
    <view class="review-head" wx:if="{{orderNo}}">
      <text class="review-head-label">订单号</text>
      <text class="review-head-no">{{orderNo}}</text>
    </view>

    <!-- 1. 逐商品评价卡 -->
    <view class="card g-card" wx:for="{{goodsList}}" wx:key="goodsId">
      <view class="g-row">
        <image class="g-thumb" src="{{item.pic}}" mode="aspectFill"
               data-index="{{index}}" binderror="onImgError"></image>
        <view class="flex-1">
          <view class="g-name ellipsis-2">{{item.name}}</view>
          <view class="g-spec ellipsis" wx:if="{{item.specText}}">{{item.specText}}</view>
        </view>
      </view>

      <!-- 星级打分 -->
      <view class="rate-row">
        <text class="rate-label">商品评分</text>
        <star-rate
          value="{{item.score}}"
          size="{{52}}"
          readonly="{{false}}"
          data-index="{{index}}"
          bind:change="onGoodsScore" />
        <text class="score-text">{{item.scoreText}}</text>
      </view>

      <!-- 快捷标签多选 -->
      <view class="tag-pool" wx:if="{{item.tagPool.length}}">
        <text
          class="tag-item {{t.sel ? 'tag-on' : ''}}"
          wx:for="{{item.tagPool}}"
          wx:for-item="t"
          wx:for-index="ti"
          wx:key="name"
          data-index="{{index}}"
          data-ti="{{ti}}"
          bindtap="onToggleTag">{{t.name}}</text>
      </view>

      <!-- 评价内容 -->
      <view class="ta-wrap">
        <textarea
          class="review-ta"
          value="{{item.content}}"
          placeholder="分享口感、包装、新鲜度…"
          placeholder-class="ta-ph"
          maxlength="{{maxLen}}"
          data-index="{{index}}"
          bindinput="onContentInput"></textarea>
        <text class="ta-count">{{item.content.length}}/{{maxLen}}</text>
      </view>

      <!-- 晒图上传 -->
      <view class="img-grid">
        <view class="img-cell" wx:for="{{item.images}}" wx:for-item="img" wx:for-index="ii" wx:key="*this">
          <image class="img-thumb" src="{{img}}" mode="aspectFill"
                 data-index="{{index}}" data-ii="{{ii}}" bindtap="onPreviewImage"
                 binderror="onUploadImgError"></image>
          <text class="img-del" data-index="{{index}}" data-ii="{{ii}}" catchtap="onDeleteImage">×</text>
        </view>
        <view class="img-add" wx:if="{{item.images.length < maxImg}}" data-index="{{index}}" bindtap="onChooseImage">
          <text class="img-add-icon">＋</text>
          <text class="img-add-text">晒图 {{item.images.length}}/{{maxImg}}</text>
        </view>
      </view>
    </view>

    <!-- 2. 店铺评价卡（三维度星级） -->
    <view class="card">
      <view class="card-title">店铺评价</view>
      <view class="rate-row">
        <text class="rate-label">新鲜度</text>
        <star-rate value="{{shop.fresh}}" size="{{40}}" readonly="{{false}}" data-key="fresh" bind:change="onShopScore" />
        <text class="score-text">{{shopText.fresh}}</text>
      </view>
      <view class="rate-row">
        <text class="rate-label">配送速度</text>
        <star-rate value="{{shop.speed}}" size="{{40}}" readonly="{{false}}" data-key="speed" bind:change="onShopScore" />
        <text class="score-text">{{shopText.speed}}</text>
      </view>
      <view class="rate-row">
        <text class="rate-label">包装</text>
        <star-rate value="{{shop.package}}" size="{{40}}" readonly="{{false}}" data-key="package" bind:change="onShopScore" />
        <text class="score-text">{{shopText.package}}</text>
      </view>
      <view class="ta-wrap">
        <textarea
          class="review-ta"
          value="{{shop.content}}"
          placeholder="对店铺的服务、配送、包装整体评价…"
          placeholder-class="ta-ph"
          maxlength="{{maxLen}}"
          bindinput="onShopInput"></textarea>
        <text class="ta-count">{{shop.content.length}}/{{maxLen}}</text>
      </view>
    </view>

    <view class="demo-tip">演示环境，评价数据仅在本地生效</view>
    <view class="footer-placeholder"></view>
  </block>

  <!-- 无可评价商品 -->
  <empty-state wx:else text="该订单暂无可评价的商品" />

  <!-- 3. 底部固定提交栏 -->
  <view class="submit-bar" wx:if="{{!loading && goodsList.length}}">
    <view class="demo-tip">演示环境，评价数据仅在本地生效 · 带图评价积分 +30</view>
    <view class="submit-btn {{submitting ? 'btn-disabled' : ''}}" bindtap="onSubmit">提交评价</view>
    <view class="safe-bottom"></view>
  </view>
</view>
