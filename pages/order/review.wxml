<wxs src="../../utils/format.wxs" module="f" />
<wxs module="u">
function has(arr, v) { return !!(arr && arr.indexOf(v) > -1); }
module.exports = { has: has };
</wxs>

<!-- 骨架屏 -->
<block wx:if="{{loading}}">
  <view class="card"><view class="skeleton" style="height:300rpx"></view></view>
  <view class="card"><view class="skeleton" style="height:200rpx"></view></view>
</block>

<block wx:else>
  <!-- 逐商品评价 -->
  <view class="card" wx:for="{{goodsReviews}}" wx:key="goodsId" wx:for-index="gi">
    <view class="goods-head">
      <image class="goods-pic" mode="aspectFill"
        src="{{item._imgErr ? '/static/images/default.png' : item.pic}}"
        data-key="{{gi}}" data-field="goodsReviews" binderror="onImgError" />
      <view class="goods-name ellipsis-2">{{item.name}}</view>
    </view>

    <!-- 星级 -->
    <view class="star-row">
      <text class="star-label">商品评分</text>
      <text class="star {{item.score >= s ? 'on' : ''}}" wx:for="{{[1, 2, 3, 4, 5]}}" wx:for-item="s" wx:key="*this"
        data-gi="{{gi}}" data-score="{{s}}" bindtap="setScore">{{item.score >= s ? '★' : '☆'}}</text>
    </view>

    <!-- 快捷标签 -->
    <view class="tag-row">
      <view class="qtag {{u.has(item.tags, t) ? 'on' : ''}}" wx:for="{{quickTags}}" wx:for-item="t" wx:key="*this"
        data-gi="{{gi}}" data-tag="{{t}}" bindtap="toggleTag">{{t}}</view>
    </view>

    <!-- 文字 -->
    <textarea class="review-text" placeholder="说说商品怎么样吧～（选填）" value="{{item.content}}"
      data-gi="{{gi}}" bindinput="onContent" maxlength="200" />

    <!-- 晒图 -->
    <view class="img-grid">
      <view class="img-cell" wx:for="{{item.images}}" wx:for-item="img" wx:for-index="ii" wx:key="ii">
        <image class="up-img" mode="aspectFill" src="{{img}}" data-gi="{{gi}}" data-ii="{{ii}}" bindtap="previewImage"
          data-key="{{gi}}" data-field="goodsReviews" binderror="onImgError" />
        <view class="img-del" data-gi="{{gi}}" data-ii="{{ii}}" catchtap="delImage">×</view>
      </view>
      <view class="img-add" wx:if="{{item.images.length < 6}}" data-gi="{{gi}}" bindtap="chooseImage">
        <view class="img-add-icon">📷</view>
        <view class="img-add-text">{{item.images.length}}/6</view>
      </view>
    </view>
  </view>

  <!-- 店铺评价 -->
  <view class="card">
    <view class="card-title">店铺评价</view>
    <view class="star-row" wx:for="{{shopDims}}" wx:key="key">
      <text class="star-label">{{item.label}}</text>
      <text class="star {{shopScores[item.key] >= s ? 'on' : ''}}" wx:for="{{[1, 2, 3, 4, 5]}}" wx:for-item="s" wx:key="*this"
        data-dim="{{item.key}}" data-score="{{s}}" bindtap="setShopScore">{{shopScores[item.key] >= s ? '★' : '☆'}}</text>
    </view>
    <textarea class="review-text" placeholder="店铺服务怎么样？（选填）" value="{{shopContent}}"
      bindinput="onShopContent" maxlength="200" />
  </view>

  <view class="bottom-safe"></view>
  <view class="bottom-bar">
    <view class="btn-primary submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">提交评价</view>
  </view>
</block>
