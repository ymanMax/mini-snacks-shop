.slot-page { padding-bottom: 140rpx; }
.group-title {
  font-size: 28rpx;
  font-weight: 700;
  padding: 30rpx 30rpx 16rpx;
}
.date-row {
  display: flex;
  background: #fff;
  padding: 20rpx 24rpx;
}
.date-item {
  flex: 1;
  text-align: center;
  margin: 0 10rpx;
  padding: 20rpx 0;
  border-radius: 12rpx;
  background: #f5f6f7;
  font-size: 26rpx;
  color: #555;
}
.date-item.on {
  background: #fdecec;
  color: #b4282d;
  font-weight: 700;
  border: 1rpx solid #b4282d;
}
.slot-list { background: #fff; margin: 0 24rpx; border-radius: 16rpx; overflow: hidden; }
.slot-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}
.slot-item:last-child { border-bottom: none; }
.slot-item.on { color: #b4282d; font-weight: 600; }
.slot-radio {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #b4282d;
  color: #fff;
  font-size: 24rpx;
}
.slot-tip {
  padding: 24rpx 30rpx;
  font-size: 22rpx;
  color: #969799;
}
.slot-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
}
.slot-confirm {
  background: linear-gradient(90deg, #d8443a, #b4282d);
  color: #fff;
  border-radius: 999rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
}
.slot-confirm::after { border: none; }
