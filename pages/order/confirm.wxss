/* pages/order/confirm.wxss */
.page { padding-bottom: 40rpx; }
.sk-block { width: 100%; }

/* 地址卡 */
.addr-card { display: flex; align-items: center; }
.addr-icon { font-size: 40rpx; margin-right: 20rpx; }
.addr-info { flex: 1; min-width: 0; }
.addr-line1 { display: flex; align-items: center; }
.addr-name { font-size: 30rpx; font-weight: bold; margin-right: 16rpx; }
.addr-phone { color: #838383; font-size: 26rpx; margin-right: 12rpx; }
.addr-detail { color: #666; font-size: 26rpx; margin-top: 8rpx; line-height: 1.5; }
.addr-empty { flex: 1; color: #b4282d; font-size: 30rpx; }
.addr-arrow { color: #b0b0b0; font-size: 40rpx; margin-left: 16rpx; }
.addr-freight { color: #b4282d; font-size: 24rpx; margin-top: 8rpx; }

/* 超出配送范围警告条 */
.range-warning {
  margin: 0 24rpx; padding: 20rpx 24rpx;
  background: #fbeaea; color: #b4282d;
  font-size: 26rpx; line-height: 1.5;
  border: 2rpx solid #f0c6c8; border-radius: 16rpx;
}

/* 最优券自动勾选标记 */
.coupon-value { display: flex; align-items: center; justify-content: flex-end; }
.auto-best-tag {
  background: #b4282d; color: #fff; font-size: 20rpx;
  border-radius: 999rpx; padding: 2rpx 14rpx; margin-left: 12rpx; line-height: 1.6;
}

.card-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; }

/* 商品 */
.goods-item { display: flex; padding: 16rpx 0; }
.goods-pic { width: 140rpx; height: 140rpx; border-radius: 12rpx; background: #f2f3f5; flex-shrink: 0; }
.goods-info { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.goods-name { font-size: 28rpx; line-height: 1.4; }
.goods-spec { color: #838383; font-size: 24rpx; margin-top: 6rpx; }
.goods-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: auto; }
.goods-count { color: #838383; font-size: 26rpx; }

/* 单元格 */
.cell { display: flex; align-items: center; padding: 24rpx 0; }
.cell-label { font-size: 28rpx; color: #333; width: 150rpx; flex-shrink: 0; }
.cell-value { flex: 1; text-align: right; color: #666; font-size: 28rpx; }
.cell-value.theme-text { color: #b4282d; }
.cell-arrow { color: #b0b0b0; font-size: 36rpx; margin-left: 12rpx; }

.pay-cell { justify-content: space-between; }
.pay-opts { flex: 1; display: flex; justify-content: flex-end; }
.pay-opt {
  border: 2rpx solid #e0e0e0; color: #666; font-size: 26rpx;
  border-radius: 999rpx; padding: 10rpx 28rpx; margin-left: 20rpx;
}
.pay-opt.on { border-color: #b4282d; color: #b4282d; background: #fbeaea; }

.remark-cell .remark-input { flex: 1; text-align: right; font-size: 28rpx; }

/* 金额明细 */
.amount-row { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; }
.amount-label { color: #666; font-size: 26rpx; }
.pay-row { padding-top: 20rpx; }
.pay-amount { font-size: 36rpx; }
.free-tip { color: #b4282d; font-size: 24rpx; text-align: right; margin-top: 8rpx; }

/* 底部结算栏 */
.bottom-safe { height: 140rpx; }
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
  background: #fff; display: flex; align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.bottom-amount { flex: 1; display: flex; align-items: baseline; }
.bottom-label { color: #666; font-size: 26rpx; }
.bottom-price { font-size: 40rpx; }
.submit-btn { width: 240rpx; }

/* 弹层通用 */
.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 40;
  background: rgba(0, 0, 0, 0.5);
  opacity: 0; visibility: hidden; transition: opacity 0.25s;
}
.mask.show { opacity: 1; visibility: visible; }
.popup {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 41;
  background: #fff; border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  transform: translateY(100%); visibility: hidden; transition: transform 0.25s;
}
.popup.show { transform: translateY(0); visibility: visible; }
.popup-title { font-size: 32rpx; font-weight: bold; text-align: center; margin-bottom: 24rpx; }

/* 配送时段 */
.slot-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 24rpx; border-radius: 12rpx; font-size: 28rpx; color: #333;
}
.slot-item.on { background: #fbeaea; color: #b4282d; font-weight: bold; }
.slot-check { color: #b4282d; font-weight: bold; }

/* 优惠券 */
.coupon-scroll { max-height: 600rpx; }
.coupon-item {
  display: flex; align-items: center; justify-content: space-between;
  border: 2rpx solid #eee; border-radius: 12rpx;
  padding: 24rpx; margin-bottom: 16rpx;
}
.coupon-item.on { border-color: #b4282d; background: #fbeaea; }
.coupon-name { font-size: 28rpx; font-weight: bold; }
.coupon-sub { color: #838383; font-size: 22rpx; margin-top: 6rpx; }
.coupon-check { color: #b4282d; font-size: 32rpx; font-weight: bold; margin-left: 20rpx; }
.coupon-empty { text-align: center; color: #838383; padding: 40rpx 0; }

/* 收银台弹层 */
.pay-popup-amount { font-size: 56rpx; text-align: center; margin: 24rpx 0 40rpx; }
.pay-btn { margin-bottom: 20rpx; }
