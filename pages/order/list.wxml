<wxs src="../../utils/format.wxs" module="f" />

<!-- 状态 Tab -->
<view class="tabs">
  <view class="tab-item {{activeStatus === item.status ? 'on' : ''}}"
    wx:for="{{tabs}}" wx:key="status"
    data-status="{{item.status}}" bindtap="switchTab">
    <text>{{item.label}}</text>
    <view class="tab-line" wx:if="{{activeStatus === item.status}}"></view>
  </view>
</view>

<!-- 骨架屏 -->
<block wx:if="{{firstLoading}}">
  <view class="card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
    <view class="skeleton" style="height:40rpx;width:60%"></view>
    <view class="skeleton" style="height:160rpx;margin-top:24rpx"></view>
    <view class="skeleton" style="height:48rpx;width:40%;margin-top:24rpx"></view>
  </view>
</block>

<!-- 空态 -->
<view class="empty-state" wx:elif="{{!list.length}}">
  <image class="empty-img" src="/static/images/default.png" binderror="onImgError" />
  <view class="empty-text">暂无相关订单</view>
  <view class="empty-btn" bindtap="goHome">去逛逛</view>
</view>

<!-- 订单列表 -->
<block wx:else>
  <view class="card order-card" wx:for="{{list}}" wx:key="id" wx:for-index="oi" data-id="{{item.id}}" bindtap="goDetail">
    <view class="order-head">
      <text class="order-no ellipsis">订单号：{{item.orderNo}}</text>
      <text class="order-status {{item.statusClass}}">{{item.statusText}}</text>
    </view>

    <view class="order-thumbs">
      <image class="thumb" mode="aspectFill" wx:for="{{item.thumbs}}" wx:for-item="g" wx:key="goodsId"
        src="{{g._imgErr ? '/static/images/default.png' : g.pic}}"
        data-key="{{index}}" data-field="list[{{oi}}].thumbs" binderror="onImgError" />
      <view class="thumb-more" wx:if="{{item.moreCount > 0}}">+{{item.moreCount}}</view>
    </view>

    <view class="order-meta">
      <text class="order-time">{{item.createTime}}</text>
      <view class="order-amount">
        <text class="order-count">共{{item.goodsCount}}件</text>
        <text class="order-pay-label">实付</text>
        <text class="price"><text class="symbol">￥</text>{{f.fp(item.payAmount)}}</text>
      </view>
    </view>

    <view class="order-actions" catchtap="noop">
      <!-- 待付款 -->
      <block wx:if="{{item.status === 1}}">
        <view class="btn-plain act-btn gray" catchtap="cancelOrder" data-id="{{item.id}}">取消订单</view>
        <view class="btn-primary act-btn" catchtap="payOrder" data-id="{{item.id}}">去支付</view>
      </block>
      <!-- 待发货 -->
      <block wx:elif="{{item.status === 2}}">
        <view class="btn-plain act-btn gray" catchtap="remindOrder" data-id="{{item.id}}">提醒发货</view>
      </block>
      <!-- 配送中 / 待收货 -->
      <block wx:elif="{{item.status === 3 || item.status === 4}}">
        <view class="btn-plain act-btn gray" catchtap="goDetail" data-id="{{item.id}}">查看物流</view>
        <view class="btn-primary act-btn" catchtap="confirmOrder" data-id="{{item.id}}">确认收货</view>
      </block>
      <!-- 已完成未评价 -->
      <block wx:elif="{{item.status === 5 && !item.isReviewed}}">
        <view class="btn-plain act-btn gray sm" catchtap="goAftersaleApply" data-id="{{item.id}}">申请售后</view>
        <view class="btn-plain act-btn gray" catchtap="rebuy" data-id="{{item.id}}">再来一单</view>
        <view class="btn-primary act-btn" catchtap="goReview" data-id="{{item.id}}">去评价</view>
      </block>
      <!-- 已完成已评价 / 已取消 -->
      <block wx:else>
        <view class="btn-plain act-btn gray sm" wx:if="{{item.status === 5}}" catchtap="goAftersaleApply" data-id="{{item.id}}">申请售后</view>
        <view class="btn-plain act-btn gray" catchtap="rebuy" data-id="{{item.id}}">再来一单</view>
      </block>
    </view>
  </view>

  <view class="load-more" wx:if="{{loadingMore}}">加载中...</view>
  <view class="load-more" wx:elif="{{noMore}}">没有更多了~</view>
</block>
