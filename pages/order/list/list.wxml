<!--pages/order/list/list.wxml-->
<wxs src="../../../utils/format.wxs" module="fmt" />
<view class="page order-list-page">
  <!-- 状态 Tab -->
  <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
    <view wx:for="{{tabs}}" wx:key="status"
      class="tab {{activeStatus === item.status ? 'on' : ''}}"
      data-status="{{item.status}}" bindtap="switchTab">{{item.label}}</view>
  </scroll-view>

  <!-- 骨架 -->
  <view wx:if="{{loading}}" class="sk-orders">
    <view class="sk-order" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="sk sk-line-1"></view>
      <view class="sk sk-line-2"></view>
      <view class="sk sk-line-3"></view>
    </view>
  </view>

  <block wx:else>
    <view wx:for="{{orders}}" wx:key="id" class="order-card" data-id="{{item.id}}" bindtap="goDetail">
      <view class="oc-head">
        <text class="oc-no">订单号 {{item.orderNo}}</text>
        <text class="oc-status status-{{item.status}}">{{item.statusText}}</text>
      </view>

      <view class="oc-goods">
        <view wx:for="{{item.items}}" wx:for-item="g" wx:key="goodsId" class="oc-goods-item">
          <safe-image class="oc-pic" img-class="oc-pic" src="{{g.pic}}" mode="aspectFill" />
          <view class="oc-count">{{g.count}}</view>
          <view class="oc-g-info">
            <view class="oc-g-name ellipsis">{{g.name}}</view>
            <view class="sub">{{g.specText}}</view>
          </view>
          <view class="oc-g-price">¥{{fmt.fixed(g.price)}}</view>
        </view>
      </view>

      <view class="oc-foot">
        <text class="oc-time light">{{item.createTime}}</text>
        <view class="oc-total">
          共{{item.itemCount}}件 实付 <text class="oc-pay">¥{{fmt.fixed(item.payAmount)}}</text>
        </view>
      </view>

      <view class="oc-actions" catchtap="noop">
        <block wx:if="{{item.status === 1}}">
          <view class="oc-btn plain" catchtap="cancel" data-id="{{item.id}}">取消订单</view>
          <view class="oc-btn primary" catchtap="pay" data-id="{{item.id}}">去支付</view>
        </block>
        <block wx:elif="{{item.status === 2}}">
          <view class="oc-btn plain" catchtap="remind">提醒发货</view>
        </block>
        <block wx:elif="{{item.status === 3}}">
          <view class="oc-btn plain" catchtap="goDetail" data-id="{{item.id}}">查看配送</view>
        </block>
        <block wx:elif="{{item.status === 4}}">
          <view class="oc-btn primary" catchtap="receive" data-id="{{item.id}}">确认收货</view>
        </block>
        <block wx:elif="{{item.status === 5}}">
          <view class="oc-btn plain" catchtap="reorder" data-id="{{item.id}}">再来一单</view>
          <view wx:if="{{item.canReview}}" class="oc-btn primary" catchtap="review" data-id="{{item.id}}">去评价</view>
          <view wx:else class="oc-btn plain" catchtap="goDetail" data-id="{{item.id}}">查看评价</view>
        </block>
        <block wx:else>
          <view class="oc-btn plain" catchtap="reorder" data-id="{{item.id}}">再来一单</view>
        </block>
      </view>
    </view>

    <empty wx:if="{{!orders.length}}" image="/image/cry.png" text="暂无相关订单"
      btnText="去逛逛" bindbutton="goShopping" top="160rpx" />
    <loading-more status="{{loadStatus}}" />
  </block>
</view>
