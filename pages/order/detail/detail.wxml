<!--pages/order/detail/detail.wxml-->
<wxs src="../../../utils/format.wxs" module="fmt" />
<view class="page od-page" wx:if="{{order}}">
  <!-- 状态头部 -->
  <view class="status-head status-bg-{{order.status}}">
    <view class="sh-status">{{order.statusText}}</view>
    <view class="sh-desc">
      <block wx:if="{{order.status === 1}}">请在 30 分钟内完成支付，逾期自动取消</block>
      <block wx:elif="{{order.status === 2}}">商家正在备货，请耐心等待</block>
      <block wx:elif="{{order.status === 3}}">骑手正在赶来，请保持电话畅通</block>
      <block wx:elif="{{order.status === 4}}">骑手已送达，祝您用餐愉快～</block>
      <block wx:elif="{{order.status === 5}}">订单已完成，期待再次光临</block>
      <block wx:else>订单已取消</block>
    </view>
    <view wx:if="{{order.status >= 2 && order.status <= 4}}" class="sh-advance" bindtap="advance">
      ⏩ 模拟配送进度（演示）
    </view>
  </view>

  <!-- 骑手卡片 -->
  <view wx:if="{{order.rider && (order.status === 3 || order.status === 4)}}" class="card rider-card">
    <image class="rider-avatar" src="{{order.rider.avatar}}" />
    <view class="rider-info">
      <view class="rider-name">{{order.rider.name}}</view>
      <view class="sub">配送骑手 · 已取货配送中</view>
    </view>
    <view class="rider-call" bindtap="callRider">📞 联系</view>
  </view>

  <!-- 地址 -->
  <view class="card addr-card">
    <view class="addr-ico">📍</view>
    <view class="addr-body">
      <view class="addr-line1">
        <text class="addr-name">{{order.addressSnapshot.name}}</text>
        <text class="addr-phone">{{order.addressSnapshot.phone}}</text>
      </view>
      <view class="addr-line2">{{order.addressSnapshot.address}}</view>
    </view>
  </view>

  <!-- 商品 -->
  <view class="card goods-box">
    <view class="shop-line">
      <text class="shop-name">🏪 零食商城·直营店</text>
      <text class="sub">{{order.deliverySlot}}</text>
    </view>
    <view wx:for="{{order.items}}" wx:key="goodsId" class="od-item">
      <safe-image class="od-pic" img-class="od-pic" src="{{item.pic}}" mode="aspectFill" />
      <view class="od-info">
        <view class="od-name ellipsis-2">{{item.name}}</view>
        <view class="sub">{{item.specText}}</view>
      </view>
      <view class="od-right">
        <view>¥{{fmt.fixed(item.price)}}</view>
        <view class="sub">×{{item.count}}</view>
      </view>
    </view>
    <view class="amount-box">
      <view class="am-row"><text>商品金额</text><text>¥{{fmt.fixed(order.totalAmount)}}</text></view>
      <view wx:if="{{order.discountAmount > 0}}" class="am-row">
        <text>优惠<text wx:if="{{order.couponTitle}}" class="light">（{{order.couponTitle}}）</text></text>
        <text class="red">-¥{{fmt.fixed(order.discountAmount)}}</text>
      </view>
      <view class="am-row"><text>配送费</text><text>{{order.freight > 0 ? '¥' + fmt.fixed(order.freight) : '免配送费'}}</text></view>
      <view class="am-row total">
        <text>实付金额</text>
        <text class="pay-price">¥{{fmt.fixed(order.payAmount)}}</text>
      </view>
    </view>
  </view>

  <!-- 配送时间线 -->
  <view class="card">
    <view class="block-title">配送进度</view>
    <view class="timeline">
      <view wx:for="{{order.timeline}}" wx:key="status" class="tl-item {{index === 0 ? 'first' : ''}}">
        <view class="tl-dot {{index === order.timeline.length - 1 ? 'last' : ''}}"></view>
        <view wx:if="{{index < order.timeline.length - 1}}" class="tl-line"></view>
        <view class="tl-body">
          <view class="tl-status">{{item.status}}</view>
          <view wx:if="{{item.remark}}" class="sub">{{item.remark}}</view>
          <view class="light tl-time">{{item.time}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="card info-card">
    <view class="info-row">
      <text class="sub">订单编号</text>
      <view class="info-right">
        <text>{{order.orderNo}}</text>
        <text class="copy-btn" bindtap="copyNo">复制</text>
      </view>
    </view>
    <view class="info-row"><text class="sub">下单时间</text><text>{{order.createTime}}</text></view>
    <view class="info-row"><text class="sub">配送日期</text><text>{{order.deliveryDate}}</text></view>
    <view class="info-row"><text class="sub">支付方式</text><text>{{order.payType === 2 ? '货到付款' : '微信支付'}}</text></view>
    <view wx:if="{{order.remark}}" class="info-row"><text class="sub">订单备注</text><text>{{order.remark}}</text></view>
    <view class="demo-tip">演示环境，不产生真实交易</view>
  </view>

  <view style="height:140rpx"></view>

  <!-- 底部操作 -->
  <view wx:if="{{order.status !== 3 || order.hasAftersale}}" class="action-bar">
    <block wx:if="{{order.status === 1}}">
      <view class="ab-btn plain" bindtap="cancel">取消订单</view>
      <view class="ab-btn primary" bindtap="pay">去支付</view>
    </block>
    <block wx:elif="{{order.status === 2}}">
      <view wx:if="{{order.hasAftersale}}" class="ab-btn plain" bindtap="goAftersale">查看售后</view>
      <view wx:else class="ab-btn plain" bindtap="applyAftersale">申请售后</view>
    </block>
    <block wx:elif="{{order.status === 4}}">
      <view wx:if="{{order.hasAftersale}}" class="ab-btn plain" bindtap="goAftersale">查看售后</view>
      <view wx:else class="ab-btn plain" bindtap="applyAftersale">申请售后</view>
      <view class="ab-btn primary" bindtap="receive">确认收货</view>
    </block>
    <block wx:elif="{{order.status === 5}}">
      <view class="ab-btn plain" bindtap="reorder">再来一单</view>
      <view wx:if="{{order.hasAftersale}}" class="ab-btn plain" bindtap="goAftersale">查看售后</view>
      <view wx:elif="{{order.canReview}}" class="ab-btn primary" bindtap="review">去评价</view>
      <view wx:else class="ab-btn plain" bindtap="applyAftersale">申请售后</view>
    </block>
    <block wx:elif="{{order.status === 6}}">
      <view class="ab-btn plain" bindtap="reorder">再来一单</view>
    </block>
  </view>
  <!-- 配送中无售后时也提供售后入口（独立一行样式由 action-bar 同构） -->
  <view wx:if="{{order.status === 3 && !order.hasAftersale}}" class="action-bar">
    <view class="ab-btn plain" bindtap="applyAftersale">申请售后</view>
  </view>
</view>

<view wx:else class="page-loading load-status">加载中...</view>
