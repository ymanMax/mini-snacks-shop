/* pages/index/index.wxss */

.index-page {
  padding-bottom: 40rpx;
}

/* ---------- 搜索栏 ---------- */
.search-bar {
  padding: 20rpx 24rpx 12rpx;
  background: linear-gradient(180deg, #b4282d 0%, #c8392f 55%, #f5f6f7 100%);
}
.search-pill {
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.search-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}
.search-ph {
  font-size: 26rpx;
  color: #b2b2b2;
}

/* ---------- 轮播 ---------- */
.banner-card {
  margin: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #ffffff;
}
.banner-swiper {
  height: 300rpx;
  border-radius: 16rpx;
}
.banner-item {
  position: relative;
  width: 100%;
  height: 300rpx;
}
.banner-img {
  width: 100%;
  height: 300rpx;
  display: block;
  background: #f2f3f5;
}
.banner-caption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 40rpx 24rpx 20rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.55) 100%);
  color: #ffffff;
}
.banner-name {
  font-size: 32rpx;
  font-weight: bold;
}
.banner-desc {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

/* ---------- 秒杀 ---------- */
.seckill-scroll {
  white-space: nowrap;
  width: 100%;
}
.seckill-item {
  display: inline-block;
  width: 180rpx;
  margin-right: 20rpx;
  vertical-align: top;
}
.seckill-item:last-child {
  margin-right: 0;
}
.seckill-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
  display: block;
}
.seckill-name {
  font-size: 24rpx;
  color: #333333;
  margin-top: 8rpx;
  width: 180rpx;
}
.seckill-price {
  color: #b4282d;
  font-weight: bold;
  margin-top: 4rpx;
}
.seckill-origin {
  color: #b2b2b2;
  font-size: 22rpx;
  text-decoration: line-through;
}

/* ---------- 主题区 ---------- */
.theme-row {
  display: flex;
  justify-content: space-between;
}
.theme-item {
  width: 210rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  overflow: hidden;
}
.theme-img {
  width: 210rpx;
  height: 150rpx;
  display: block;
  background: #f2f3f5;
}
.theme-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  padding: 10rpx 12rpx 2rpx;
}
.theme-desc {
  font-size: 20rpx;
  color: #838383;
  padding: 0 12rpx 12rpx;
}

/* ---------- 新品双列 ---------- */
.newest-wrap {
  padding-top: 8rpx;
}
.newest-title {
  padding-left: 24rpx;
  padding-right: 24rpx;
}
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx;
}
.goods-grid > goods-card {
  width: 342rpx;
  margin-bottom: 20rpx;
}

/* ---------- 悬浮购物车 ---------- */
.float-cart {
  position: fixed;
  right: 28rpx;
  bottom: 120rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}
.float-cart-hover {
  transform: scale(0.94);
  background: #fdeeef;
}
.float-cart-icon {
  font-size: 46rpx;
  line-height: 1;
}
