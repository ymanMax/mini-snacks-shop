/* pages/index/index.wxss —— 首页（优化 3） */

/* 顶部搜索栏 */
.search-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 16rpx 24rpx;
  background: #f5f6f7;
}
.search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.search-ph {
  color: #b0b0b0;
  font-size: 26rpx;
}

/* 轮播图 */
.banner-wrap {
  padding: 0 24rpx;
}
.banner-swiper {
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}
.banner-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}
.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 40rpx 28rpx 44rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0));
  border-radius: 0 0 16rpx 16rpx;
}
.banner-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
}
.banner-desc {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 区块通用 */
.section {
  margin: 24rpx 24rpx 0;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title-wrap {
  display: flex;
  align-items: baseline;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}
.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  background: #b4282d;
  border-radius: 4rpx;
  margin-right: 12rpx;
  vertical-align: -4rpx;
}
.seckill-sub {
  font-size: 22rpx;
  color: #838383;
  margin-left: 14rpx;
}
.seckill-head-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.more-link {
  font-size: 24rpx;
  color: #838383;
  margin-left: 20rpx;
}

/* 限时抢购 */
.seckill-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}
.countdown {
  display: flex;
  align-items: center;
}
.countdown-label {
  font-size: 22rpx;
  color: #838383;
  margin-right: 10rpx;
}
.countdown-time {
  font-size: 24rpx;
  color: #b4282d;
  font-weight: bold;
  background: #fbeaea;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  font-variant-numeric: tabular-nums;
}
.seckill-scroll {
  width: 100%;
  white-space: nowrap;
}
.seckill-row {
  display: flex;
}
.seckill-card {
  flex-shrink: 0;
  width: 220rpx;
  margin-right: 20rpx;
}
.seckill-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
  background: #f5f6f7;
}
.seckill-name {
  font-size: 26rpx;
  margin-top: 12rpx;
}
.seckill-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
}
.seckill-price-row .price {
  font-size: 30rpx;
  margin-right: 10rpx;
}
.progress {
  position: relative;
  height: 28rpx;
  border-radius: 999rpx;
  background: #fbeaea;
  margin-top: 12rpx;
  overflow: hidden;
}
.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(to right, #e0686c, #b4282d);
}
.progress-text {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  text-align: center;
  font-size: 20rpx;
  line-height: 28rpx;
  color: #ffffff;
}

/* 精选主题 */
.theme-row {
  display: flex;
}
.theme-card {
  flex: 1;
  min-width: 0;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-right: 20rpx;
}
.theme-card:last-child {
  margin-right: 0;
}
.theme-img {
  width: 100%;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f5f6f7;
}
.theme-name {
  font-size: 26rpx;
  font-weight: bold;
  margin-top: 12rpx;
}
.theme-desc {
  font-size: 22rpx;
  color: #838383;
  margin-top: 4rpx;
}

/* 商品两列网格 */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.goods-card {
  width: 340rpx;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.goods-img,
.skeleton-img {
  width: 340rpx;
  height: 340rpx;
  background: #f5f6f7;
}
.skeleton-img {
  border-radius: 0;
}
.goods-info {
  padding: 16rpx 20rpx 20rpx;
}
.goods-name {
  font-size: 26rpx;
  line-height: 1.4;
  min-height: 72rpx;
}
.goods-tags {
  margin-top: 8rpx;
  min-height: 40rpx;
}
.goods-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 10rpx;
}
.goods-price-wrap .price {
  font-size: 34rpx;
}
.goods-price-wrap .price-origin {
  margin-left: 10rpx;
}
.goods-sold {
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 4rpx;
}
.add-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #b4282d;
  color: #ffffff;
  font-size: 40rpx;
  line-height: 48rpx;
  text-align: center;
  flex-shrink: 0;
}

/* 骨架屏 */
.skeleton-line {
  height: 28rpx;
  margin-bottom: 16rpx;
}
.skeleton-line.short {
  width: 60%;
}
.skeleton-line.tiny {
  width: 40%;
  height: 22rpx;
}

/* 分页状态 */
.list-footer {
  text-align: center;
  color: #b0b0b0;
  font-size: 24rpx;
  padding: 10rpx 0 30rpx;
}

/* 右下角悬浮购物车 */
.float-cart {
  position: fixed;
  right: 30rpx;
  bottom: 60rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 30;
}
.float-cart-icon {
  font-size: 44rpx;
}
.float-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
}
