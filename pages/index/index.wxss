/* pages/index/index.wxss */
.index-page { padding-bottom: 140rpx; }

/* 搜索栏 */
.search-wrap {
  position: sticky;
  top: 0;
  z-index: 30;
  background: linear-gradient(135deg, #d34046, #b4282d);
  padding: 16rpx 24rpx 20rpx;
}
.search-box {
  height: 68rpx;
  background: #fff;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}
.search-hover { opacity: .85; }
.search-icon { margin-right: 12rpx; font-size: 28rpx; }
.search-ph { color: #9fa2a8; font-size: 26rpx; }

/* 轮播 */
.banner {
  height: 300rpx;
  margin-top: 20rpx;
}
.banner-img {
  width: 686rpx;
  height: 300rpx;
  border-radius: 20rpx;
  background: #eee;
}
.dots {
  display: flex;
  justify-content: center;
  margin-top: 14rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d8dade;
  margin: 0 6rpx;
  transition: all .2s;
}
.dot.on { width: 28rpx; border-radius: 6rpx; background: #b4282d; }

/* 金刚区 */
.entry-card {
  display: flex;
  flex-wrap: wrap;
  padding: 28rpx 10rpx 12rpx;
}
.entry-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}
.entry-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
}
.entry-name { font-size: 22rpx; color: #555; margin-top: 10rpx; }

/* 限时抢购 */
.seckill {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 24rpx 24rpx;
  padding: 24rpx 0 20rpx;
}
.seckill-hover { opacity: .9; }
.seckill-head {
  display: flex;
  align-items: center;
  padding: 0 24rpx 18rpx;
}
.seckill-title { font-size: 32rpx; font-weight: 700; color: #b4282d; }
.seckill-cd { display: flex; align-items: center; margin-left: 16rpx; }
.cd-label { font-size: 20rpx; color: #999; margin-right: 8rpx; }
.cd-time {
  font-size: 22rpx;
  background: #222;
  color: #fff;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  letter-spacing: 2rpx;
}
.seckill-more { margin-left: auto; font-size: 22rpx; color: #999; }
.seckill-scroll { white-space: nowrap; padding: 0 24rpx; }
.seckill-item {
  display: inline-block;
  width: 190rpx;
  margin-right: 18rpx;
  vertical-align: top;
}
.skl-img { width: 190rpx; height: 190rpx; border-radius: 12rpx; background: #f5f6f7; }
.skl-name { font-size: 22rpx; margin-top: 8rpx; }
.skl-row { display: flex; align-items: baseline; margin-top: 4rpx; }
.skl-price { color: #b4282d; font-weight: 700; font-size: 30rpx; }
.skl-origin {
  color: #b0b3b8;
  font-size: 20rpx;
  text-decoration: line-through;
  margin-left: 8rpx;
}
.skl-bar {
  position: relative;
  height: 28rpx;
  border-radius: 999rpx;
  background: #ffe3e4;
  margin-top: 8rpx;
  overflow: hidden;
}
.skl-bar-inner {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  background: linear-gradient(90deg, #ff8a7a, #b4282d);
  border-radius: 999rpx;
}
.skl-bar-text {
  position: relative;
  font-size: 18rpx;
  color: #fff;
  line-height: 28rpx;
  text-align: center;
  display: block;
}

/* 主题 */
.theme-card { padding-bottom: 24rpx; }
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.section-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: #b4282d;
  border-radius: 4rpx;
  margin-right: 14rpx;
}
.theme-top { display: flex; gap: 18rpx; }
.theme-small {
  position: relative;
  flex: 1;
  height: 180rpx;
  border-radius: 14rpx;
  overflow: hidden;
}
.theme-img { width: 100%; height: 180rpx; }
.theme-wide {
  position: relative;
  height: 180rpx;
  border-radius: 14rpx;
  overflow: hidden;
  margin-top: 18rpx;
}
.theme-wide-img { width: 100%; height: 180rpx; }
.theme-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,.55));
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 16rpx 20rpx;
}
.theme-name { color: #fff; font-size: 28rpx; font-weight: 700; }
.theme-desc { color: rgba(255,255,255,.85); font-size: 20rpx; margin-top: 4rpx; }

/* 商品网格 */
.products-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 24rpx 16rpx;
}
.products-head .section-title { margin-bottom: 0; }
.goods-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  padding: 0 24rpx;
}

/* 悬浮购物车 */
.float-cart {
  position: fixed;
  right: 28rpx;
  bottom: 140rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #d34046, #b4282d);
  box-shadow: 0 8rpx 24rpx rgba(180, 40, 45, .4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}
.float-icon { width: 48rpx; height: 48rpx; filter: brightness(0) invert(1); }
.float-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #ff6b00;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  border: 2rpx solid #fff;
}

/* 骨架屏 */
.sk-banner { height: 300rpx; margin: 20rpx 24rpx 0; border-radius: 20rpx; }
.sk-entry-card { display: flex; flex-wrap: wrap; padding: 28rpx 10rpx; }
.sk-entry { width: 25%; display: flex; flex-direction: column; align-items: center; margin-bottom: 24rpx; }
.sk-circle { width: 88rpx; height: 88rpx; border-radius: 28rpx; }
.sk-line { height: 22rpx; width: 70rpx; margin-top: 10rpx; border-radius: 6rpx; }
.sk-title { height: 36rpx; width: 200rpx; margin: 24rpx; border-radius: 8rpx; }
.sk-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; padding: 0 24rpx; }
.sk-goods { background: #fff; border-radius: 16rpx; padding-bottom: 20rpx; overflow: hidden; }
.sk-goods-img { width: 100%; height: 340rpx; border-radius: 0; }
.sk-goods .l1 { height: 28rpx; margin: 16rpx 16rpx 0; width: 80%; }
.sk-goods .l2 { height: 28rpx; margin: 12rpx 16rpx 0; width: 50%; }
