/* pages/orderDetail/orderDetail.wxss */
.main {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.order-header {
  background-color: white;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.order-number {
  font-size: 28rpx;
  color: #333;
}

.order-status {
  font-size: 26rpx;
  color: #0ea47a;
}

.order-section {
  background-color: white;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  margin-bottom: 15rpx;
  font-size: 28rpx;
}

.info-label {
  color: #666;
  margin-right: 20rpx;
}

.info-value {
  color: #333;
}

.product-list {
  margin-top: 20rpx;
}

.product-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.product-details {
  flex: 1;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.product-price {
  font-size: 26rpx;
  color: #ff4444;
  margin-bottom: 5rpx;
}

.product-quantity {
  font-size: 24rpx;
  color: #999;
}

.address-info {
  margin-top: 20rpx;
}

.consignee {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.mobile {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.address {
  font-size: 26rpx;
  color: #666;
}

.amount-info {
  margin-top: 20rpx;
}

.amount-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
  font-size: 28rpx;
}

.amount-item.total {
  font-weight: bold;
  color: #ff4444;
  font-size: 30rpx;
}

.action-buttons {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
}

.action-btn.primary {
  background-color: #0ea47a;
  color: white;
}

.action-btn.cancel {
  background-color: #ff4444;
  color: white;
}
