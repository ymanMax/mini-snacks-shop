:host { display: block; }
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  color: #969799;
  font-size: 24rpx;
}
.lm-dot {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #e5e6eb;
  border-top-color: #b4282d;
  border-radius: 50%;
  margin-right: 12rpx;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.lm-end { display: flex; align-items: center; }
.lm-line { width: 60rpx; height: 1rpx; background: #e5e6eb; margin: 0 20rpx; }
.lm-retry { padding: 10rpx 30rpx; }
