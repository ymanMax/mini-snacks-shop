.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}
.empty-img {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #838383;
  margin-bottom: 32rpx;
  text-align: center;
}
.empty-btn {
  font-size: 28rpx;
  color: #b4282d;
  border: 2rpx solid #b4282d;
  border-radius: 999rpx;
  padding: 12rpx 48rpx;
  background: #ffffff;
}
