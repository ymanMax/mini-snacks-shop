.gc-name {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.4;
  min-height: 78rpx;
}
.gc-tags {
  margin: 8rpx 0;
  height: 40rpx;
  overflow: hidden;
}
.gc-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.gc-price { font-size: 36rpx; }
.gc-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #b2b2b2;
  margin-top: 8rpx;
}
.gc-origin { max-width: 180rpx; }
.gc-add-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #d0342c, #b4282d);
  color: #ffffff;
  font-size: 36rpx;
  line-height: 48rpx;
  text-align: center;
  font-weight: bold;
  flex-shrink: 0;
}

/* grid */
.gc-grid {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}
.gc-grid-img {
  width: 100%;
  height: 342rpx;
  background: #f2f3f5;
  display: block;
}
.gc-grid-body { padding: 16rpx 20rpx 20rpx; }

/* row */
.gc-row {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
}
.gc-row-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f2f3f5;
  flex-shrink: 0;
}
.gc-row-body { justify-content: space-between; }

/* mini */
.gc-mini {
  width: 200rpx;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
  padding-bottom: 12rpx;
}
.gc-mini-img {
  width: 200rpx;
  height: 200rpx;
  background: #f2f3f5;
  display: block;
}
.gc-mini-name {
  font-size: 24rpx;
  padding: 8rpx 12rpx 4rpx;
  color: #333333;
}
.gc-mini .price { padding: 0 12rpx; }
