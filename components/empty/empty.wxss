:host { display: block; }
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 80rpx;
}
.empty-img {
  width: 300rpx;
  height: 300rpx;
}
.empty-text {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #969799;
}
.empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #c0c4cc;
}
.empty-btn {
  margin-top: 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 60rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #d8443a, #b4282d);
  color: #fff;
  font-size: 28rpx;
}
.empty-btn::after { border: none; }
.btn-hover { opacity: 0.85; }
