:host { display: block; }
.sk-banner {
  margin: 24rpx;
  height: 300rpx;
  border-radius: 16rpx;
}
.sk-cats {
  background: #fff;
  margin: 0 24rpx;
  border-radius: 16rpx;
  padding: 24rpx 0;
  display: flex;
  flex-wrap: wrap;
}
.sk-cat {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}
.sk-cat-icon { width: 80rpx; height: 80rpx; border-radius: 50%; }
.sk-cat-text { width: 60rpx; height: 20rpx; margin-top: 12rpx; }
.sk-section { height: 60rpx; margin: 24rpx; }
.sk-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx;
}
.sk-goods {
  width: 340rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
}
.sk-goods-img { width: 100%; height: 308rpx; border-radius: 12rpx; }
.sk-line { height: 24rpx; margin: 16rpx 0 0; }
.sk-order-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; margin-right: 20rpx; }
.w20 { width: 20%; } .w30 { width: 30%; } .w40 { width: 40%; }
.w50 { width: 50%; } .w60 { width: 60%; } .w70 { width: 70%; }
.w80 { width: 80%; } .w90 { width: 90%; }
.sk-rows {
  display: flex;
  align-items: center;
}
.sk-row-img { width: 180rpx; height: 180rpx; border-radius: 12rpx; margin-right: 24rpx; }
.sk-circle { width: 40rpx; height: 40rpx; border-radius: 50%; margin-right: 20rpx; }
.sk-cart { display: flex; align-items: center; }
.sk-order-img { width: 120rpx; height: 120rpx; }
.sk-swiper { height: 750rpx; width: 100%; border-radius: 0; }
.sk-block { height: 220rpx; margin-top: 20rpx; border-radius: 12rpx; }
.sk-line.big { height: 40rpx; }
