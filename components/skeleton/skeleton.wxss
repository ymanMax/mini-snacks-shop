.sk-line {
  height: 28rpx;
  margin: 18rpx 0;
}
.h40 { height: 40rpx; }
.w30 { width: 30%; }
.w40 { width: 40%; }
.w50 { width: 50%; }
.w60 { width: 60%; }
.w80 { width: 80%; }

/* 商品双列 */
.sk-goods {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 24rpx;
}
.sk-goods-item {
  width: 342rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
}
.sk-img {
  width: 100%;
  height: 310rpx;
  border-radius: 12rpx;
}

/* 订单卡 */
.sk-order { padding: 24rpx; }
.sk-order-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.sk-order-row { display: flex; margin: 20rpx 0; }
.sk-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

/* 详情 */
.sk-banner { width: 100%; height: 750rpx; }
.sk-detail-body {
  background: #ffffff;
  border-radius: 16rpx 16rpx 0 0;
  margin-top: -24rpx;
  padding: 32rpx 24rpx;
  position: relative;
}
.sk-block-mid {
  height: 160rpx;
  margin: 24rpx 0;
  border-radius: 12rpx;
}

/* 单列行 */
.sk-list { padding: 24rpx; }
.sk-list-row {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
